    {
      "id": "67bde6ad-ccd8-48e3-be0e-b81c29d8b554",
      "name": "Evaluate active ticket guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4400,
        1168
      ],
      "parameters": {
        "jsCode": "const ACTIVE = new Set(['new', 'open', 'pending', 'hold']);\n\nconst trigger = $('Restore trigger data').first().json;\nconst cfg = $('Get Project Config').first().json;\n\nconst currentId = String(trigger.body['ticket.id']);\n\nconst flag = cfg.dedupe_merge_enabled;\nconst dedupeEnabled = (flag === true || flag === 1 || flag === 'true' || flag === '1' || flag === 'yes');\n\nconst tickets = $input.all().flatMap(i => (i.json && i.json.tickets) ? i.json.tickets : []);\n\nconst active = tickets.filter(t => ACTIVE.has(String(t.status).toLowerCase()));\n\nconst currentTicket = $('Get ticket status').first().json.ticket;\nif (currentTicket && ACTIVE.has(String(currentTicket.status).toLowerCase()) && !active.some(t => String(t.id) === currentId)) {\n  active.push({ id: currentTicket.id, status: currentTicket.status, created_at: currentTicket.created_at });\n}\n\nactive.sort((a, b) => {\n  const ta = Date.parse(a.created_at);\n  const tb = Date.parse(b.created_at);\n  if (ta !== tb) return ta - tb;\n  return Number(a.id) - Number(b.id);\n});\n\nconst keeper = active.length ? active[0] : null;\nconst isKeeper = keeper ? String(keeper.id) === currentId : true;\nconst others = active.filter(t => String(t.id) !== currentId).map(t => t.id);\n\nreturn [{\n  json: {\n    dedupe_enabled: dedupeEnabled,\n    is_keeper: isKeeper,\n    current_ticket_id: Number(currentId),\n    keeper_ticket_id: keeper ? Number(keeper.id) : Number(currentId),\n    active_ticket_count: active.length,\n    active_ticket_ids: active.map(t => t.id),\n    other_active_ticket_ids: others,\n    other_active_count: others.length\n  }\n}];"
      }
    },
