    {
      "id": "0a68fd30-ad5c-4c00-84c5-e451d1e8fc7b",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// READ ONLY. Keys whose EN changed or key created since SINCE.\nconst SINCE = '2026-10-02';\nconst out = { keys_seen: 0, en_hist: {}, errors: [], rows: [] };\nfunction kn(k){ const n = k.key_name || {}; return typeof n === 'string' ? n : (n.web || n.other || ''); }\nfunction s(v){ return typeof v === 'string' ? v : JSON.stringify(v); }\nfor (const it of $input.all()) { const b = it.json.body || {};\n  if (!Array.isArray(b.keys)) { out.errors.push({ status: it.json.statusCode, body: JSON.stringify(b).slice(0,300) }); continue; }\n  out.keys_seen += b.keys.length;\n  for (const k of b.keys) { if (k.is_archived) continue;\n    const tr = k.translations || []; const en = tr.find(t => t.language_iso === 'en'); if (!en) continue;\n    const d = String(en.modified_at || '').slice(0,10); out.en_hist[d] = (out.en_hist[d]||0)+1;\n    const created = String(k.created_at || '').slice(0,10);\n    if (d < SINCE && created < SINCE) continue;\n    const row = { id: k.key_id, key: kn(k), created: k.created_at, en: s(en.translation), en_by: en.modified_by_email, en_at: en.modified_at, desc: String(k.description||'').slice(0,300), tags: (k.tags||[]).join(','), plural: k.is_plural?1:0, t: {} };\n    for (const x of tr) { if (x.language_iso === 'en') continue; row.t[x.language_iso] = [s(x.translation), x.modified_by_email || '', x.modified_at || '', x.is_reviewed?1:0, x.is_unverified?1:0]; }\n    out.rows.push(row); } }\nconst hist = Object.entries(out.en_hist).sort().slice(-15); out.en_hist = Object.fromEntries(hist);\nreturn [{ json: out }];"
      }
    }
  ],
