        660,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nif (!Array.isArray(b.languages)) throw new Error('languages fetch failed: ' + JSON.stringify(b).slice(0,300));\nconst ids = b.languages.map(l => l.lang_id);\nconst map = {}; for (const l of b.languages) map[l.lang_id] = l.lang_iso;\nreturn [{ json: { langs: map, url: 'https://api.lokalise.com/api2/projects/964775386a3ce03ecca883.03770715/keys?include_translations=1&disable_references=1&filter_archived=exclude&filter_translation_lang_ids=' + ids.join(',') + '&limit=500&pagination=cursor' } }];"
      }
    },
