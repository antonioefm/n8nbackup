        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $input.first().json;\nconst total = (p.statistics && p.statistics.keys_total) || 0;\nconst pages = Math.max(1, Math.ceil(total / 500) + 1);\nconst out = [];\nfor (let i = 1; i <= pages; i++) { out.push({ json: { page: i } }); }\nreturn out;\n"
      }
    },
    {
      "id": "fa8ed338-6074-41de-a2b3-d68b5d7c16ef",
      "name": "Fetch Keys Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/2944050668d5010cbd95e8.36175908/keys?limit=500&page={{ $json.page }}&filter_archived=include",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 220
            }
          },
          "response": {
