        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "0c0437f9-9f3e-4281-a7d1-da421396349e",
      "name": "Summarize Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $('Collect Oct 13 Keys').first().json;\nconst r = $input.first().json || {};\nconst base = (meta.base_lang || 'en').toLowerCase();\nconst keys = (meta.match_count > 0 && r.body && r.body.keys) ? r.body.keys : [];\nconst rows = [];\nfor (const k of keys) {\n  let src = '';\n  for (const t of (k.translations || [])) { if ((t.language_iso || '').toLowerCase() === base) { src = t.translation; } }\n  rows.push({\n    key_id: k.key_id,\n    key_name: k.key_name,\n    created_at: k.created_at,\n    created_by: k.created_by_email,\n    archived: k.is_archived,\n    platforms: k.platforms,\n    filenames: k.filenames,\n    tags: k.tags,\n    description: k.description,\n    context: k.context,\n    source: src,\n    screenshots: (k.screenshots || []).map(function (s) { return { id: s.screenshot_id, title: s.title }; })\n  });\n}\nreturn [{ json: { meta: meta, details_status: r.statusCode, returned: keys.length, keys: rows } }];\n"
      }
    }
  ],
