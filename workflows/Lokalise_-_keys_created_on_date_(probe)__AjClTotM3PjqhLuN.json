      "onError": "continueRegularOutput"
    },
    {
      "id": "35bec982-48f4-4066-accc-2d7de47708e3",
      "name": "Collect Oct 13 Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const proj = $('Fetch Project').first().json;\nconst res = $input.all();\nconst ids = [];\nconst byDay = {};\nlet scanned = 0;\nconst failed = [];\nlet totalHdr = null;\nfor (let i = 0; i < res.length; i++) {\n  const r = res[i].json || {};\n  if (r.statusCode !== 200) { failed.push(i + 1); continue; }\n  if (r.headers && r.headers['x-pagination-total-count']) { totalHdr = r.headers['x-pagination-total-count']; }\n  const keys = (r.body && r.body.keys) ? r.body.keys : [];\n  for (const k of keys) {\n    scanned++;\n    const d = String(k.created_at || '').slice(0, 10);\n    if (d >= '2026-10-01') { byDay[d] = (byDay[d] || 0) + 1; }\n    if (d === '2026-10-13') { ids.push(k.key_id); }\n  }\n}\nreturn [{ json: { project_name: proj.name, base_lang: proj.base_language_iso, key_ids: ids.length ? ids.join(',') : '0', match_count: ids.length, scanned: scanned, total_header: totalHdr, failed_pages: failed, created_by_day_october: byDay } }];\n"
      }
    },
    {
      "id": "b9f5c3d9-b2da-4c50-b96a-e0d30f463d3c",
      "name": "Fetch Key Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/2944050668d5010cbd95e8.36175908/keys?filter_key_ids={{ $json.key_ids }}&include_translations=1&include_screenshots=1&filter_archived=include&limit=500",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "VW7WtJP8PzJMR813",
