        "jsCode": "const set={};\nfor(const it of $input.all()){const b=it.json.body||{};for(const f of (b.files||[])){if(f.status==='removed')continue;if(!/\\.(tsx?|jsx?)$/.test(f.filename))continue;set[f.filename]=1;}}\nreturn Object.keys(set).map(p=>({json:{path:p}}));"
