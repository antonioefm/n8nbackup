      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NS=['upload_progress_popup','camera_capture_dialog','payment_form','download_scope_dialog','max_assets_reached','partial_download','more_images','select_size_dialog','size_info','info_title','social_account_exists','image_count_label','upscale_image','processing','failed','common.errors','image_preview'];\nconst paths=$('Files').all();const res=$input.all();const out=[];\nfor(let i=0;i<res.length;i++){const p=paths[i].json.path;const r=res[i].json;const src=typeof r.body==='string'?r.body:(typeof r.data==='string'?r.data:'');\n const lines=src.split('\\n');const hits=[];\n for(let j=0;j<lines.length;j++){const l=lines[j];if(/useTranslations|getTranslations|\\bt\\(|t\\.rich\\(|t\\.raw\\(/.test(l)&&NS.some(n=>l.indexOf(n)>=0||/\\bt\\(/.test(l))){hits.push((j+1)+': '+l.trim().slice(0,180));}}\n if(hits.length&&NS.some(n=>src.indexOf(n)>=0))out.push({path:p,status:r.statusCode,len:src.length,hits:hits.slice(0,40)});}\nreturn [{json:{files:paths.length,matched:out.length,out}}];"
      }
    }
