      ],
      "parameters": {
        "jsCode": "// READ-ONLY: compact dump of the shared glossary (term, desc, tags, flags, translations by iso)\nconst terms = []; for (const it of $input.all()) { const b = it.json.body || {}; for (const t of (b.data || [])) terms.push(t); }\nconst out = terms.map(t => { const tr = {}; for (const x of (t.translations || [])) if (x.translation || x.description) tr[x.langIso] = [x.translation || '', x.description || '']; return { id: t.id, term: t.term, d: t.description || '', tg: t.tags || [], f: t.forbidden ? 1 : 0, tl: t.translatable ? 1 : 0, cs: t.caseSensitive ? 1 : 0, tr }; });\nreturn [{ json: { none: true, total_terms: terms.length, report: out } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
