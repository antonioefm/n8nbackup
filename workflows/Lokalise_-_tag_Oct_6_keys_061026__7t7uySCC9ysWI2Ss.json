    {
      "id": "91c1f146-ed66-4be7-8864-1991a4edda1d",
      "name": "Summarize Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst b = r.body || {};\nconst keys = b.keys || [];\nconst tagged = keys.filter(function (k) { return (k.tags || []).indexOf('061026') >= 0; }).length;\nreturn [{ json: { status: r.statusCode, returned: keys.length, tagged: tagged, errors: b.errors || null, error: b.error || null, sample_tags: keys.slice(0,3).map(function (k) { return k.tags; }) } }];\n",
        "mode": "runOnceForAllItems"
      }
    }
