    {
      "id": "748959df-bd16-4a51-9b0a-44760a98065e",
      "name": "Find Oct 6 Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = [];\nfor (const it of $input.all()) { for (const k of (it.json.keys || [])) { all.push(k); } }\nconst utcStart = Date.UTC(2026, 9, 6) / 1000;\nconst utcEnd = utcStart + 86400;\nconst plStart = utcStart - 7200;\nconst plEnd = utcEnd - 7200;\nfunction pick(s, e) {\n  const ks = all.filter(function (k) { return k.created_at_timestamp >= s && k.created_at_timestamp < e; });\n  return {\n    total: ks.length,\n    archived: ks.filter(function (k) { return k.is_archived; }).length,\n    already_tagged: ks.filter(function (k) { return (k.tags || []).indexOf('061026') >= 0; }).length,\n    key_ids: ks.map(function (k) { return k.key_id; }),\n    sample: ks.slice(0, 5).map(function (k) { return { id: k.key_id, name: k.key_name, created: k.created_at, tags: k.tags, archived: k.is_archived }; })\n  };\n}\nconst byDay = {};\nfor (const k of all) { const d = (k.created_at || '').slice(0, 10); byDay[d] = (byDay[d] || 0) + 1; }\nconst recent = Object.keys(byDay).sort().slice(-8).map(function (d) { return d + ': ' + byDay[d]; });\nreturn [{ json: { total_keys: all.length, pages: $input.all().length, utc_day: pick(utcStart, utcEnd), warsaw_day: pick(plStart, plEnd), recent_days_utc: recent } }];\n"
      }
    },
    {
      "id": "02096430-10b8-4a8b-bdf0-8103598baef6",
      "name": "Build Tag Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json.utc_day;\nif (d.total !== 188) { throw new Error('Expected 188 keys, found ' + d.total + ' - aborting'); }\nreturn [{ json: { body: { keys: d.key_ids.map(function (id) { return { key_id: id, tags: ['061026'], merge_tags: true }; }) } } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
