      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Build Probe Requests').all();\nconst res = $input.all();\nconst out = [];\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || { json: {} }).json;\n  const r = res[i].json || {};\n  const body = r.body || {};\n  const tr = body.translation || {};\n  out.push({ json: {\n    label: meta.label,\n    status: r.statusCode,\n    translation_id: tr.translation_id,\n    language_iso: tr.language_iso,\n    is_reviewed: tr.is_reviewed,\n    is_reviewed_type: typeof tr.is_reviewed,\n    is_unverified: tr.is_unverified,\n    reviewed_by: tr.reviewed_by,\n    has_double_space: / {2,}/.test(String(tr.translation || '')),\n    text: JSON.stringify(String(tr.translation || '').slice(0, 160)),\n    tr_fields: Object.keys(tr).join(',')\n  }});\n}\nreturn out;\n"
