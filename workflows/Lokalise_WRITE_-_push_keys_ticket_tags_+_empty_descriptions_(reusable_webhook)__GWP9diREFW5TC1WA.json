    {
      "id": "e48d7c83-4242-4501-9608-0a23bb0eb64e",
      "name": "Compare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Params').first().json;\nconst want = {}; for (const d of cfg.D) want[d[0]] = d[1];\nconst keys = ($('Read Back').first().json.keys) || [];\nlet tagsOk=0, descMine=0, descAny=0;\nfor (const k of keys) { if (!(k.key_id in want)) continue; if (cfg.TAGS.every(t => (k.tags||[]).includes(t))) tagsOk++; if ((k.description||'') === want[k.key_id]) descMine++; if ((k.description||'').trim()) descAny++; }\nreturn [{ json: { build: $('Build').first().json.summary, writeCalls: $('WRITE Keys').all().length, checked: keys.length, tagsOk, descMine, descAny, tagsSample: keys.slice(0,2).map(k => k.tags) } }];"
      }
