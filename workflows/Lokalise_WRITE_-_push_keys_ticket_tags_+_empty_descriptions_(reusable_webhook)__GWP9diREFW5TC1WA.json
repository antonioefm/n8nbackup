    {
      "id": "476da928-ca15-4152-b28c-efaee68f5a42",
      "name": "Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || {};\nconst h = $input.first().json.headers || {};\nif (h['x-l10n-secret'] !== 'f41b7c2e9d0a83561e2b4c7d9a0f13e8') throw new Error('bad secret');\nif (!['check','one','all'].includes(b.mode)) throw new Error('bad mode');\nif (!/^[0-9a-f]+\\.[0-9]+$/.test(b.pid || '')) throw new Error('bad pid');\nconst D = b.D || [];\nreturn [{ json: { mode: b.mode, pid: b.pid, TAGS: b.tags || [], D, ids: D.map(d => d[0]).join(',') } }];"
      }
    },
    {
      "id": "707b8a03-9eac-446a-ae4e-3df1ba7fa8f3",
      "name": "Get Current",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.pid }}/keys?include_translations=1&include_screenshots=1&limit=500&filter_key_ids={{ $json.ids }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "VW7WtJP8PzJMR813",
          "name": "Lokalise read-only"
        }
      }
    },
    {
      "id": "1c31fd64-4d37-4f89-83d2-ace42854590b",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Params').first().json;\nconst want = {}; for (const d of cfg.D) want[d[0]] = d[1];\nconst keys = ($('Get Current').first().json.keys) || [];\nconst ups = []; let nTag=0, nDesc=0, hadDesc=0, archived=0, shots=0;\nconst filled = {}; const editors = {};\nfor (const k of keys) {\n  if (!(k.key_id in want)) continue;\n  if ((k.screenshots||[]).length) shots++;\n  for (const t of (k.translations||[])) { if (t.language_iso === 'en') continue; const s = typeof t.translation === 'string' ? t.translation : JSON.stringify(t.translation); if (s.trim()) { filled[t.language_iso] = (filled[t.language_iso]||0) + 1; const e = t.modified_by_email || '?'; editors[e] = (editors[e]||0)+1; } else { filled[t.language_iso] = filled[t.language_iso] || 0; } }\n  if (k.is_archived) { archived++; continue; }\n  const u = { key_id: k.key_id };\n  const missing = cfg.TAGS.filter(t => !(k.tags || []).includes(t));\n  if (missing.length) { u.tags = missing; u.merge_tags = true; nTag++; }\n  if (!(k.description || '').trim()) { u.description = want[k.key_id]; nDesc++; } else hadDesc++;\n  if (Object.keys(u).length > 1) ups.push(u);\n}\nconst summary = { mode: cfg.mode, found: keys.length, expected: cfg.D.length, archived, tag: nTag, desc: nDesc, descAlreadySet: hadDesc, keysWithScreenshot: shots, filledPerLang: filled, editors };\nif (cfg.mode === 'check') return [{ json: { summary, write: false } }];\nconst list = cfg.mode === 'one' ? ups.slice(0,1) : ups;\nconst out = []; for (let i = 0; i < list.length; i += 40) out.push({ json: { body: { keys: list.slice(i, i + 40) }, summary, write: true } });\nif (!out.length) return [{ json: { summary, write: false } }];\nreturn out;"
      }
    },
