      "parameters": {
        "jsCode": "const SKIP = ['th','ko','ja','zh'];\nconst out = []; const errs = [];\nfor (const p of $input.all()) {\n  const j = p.json || {}; const b = j.body || {};\n  if (j.statusCode !== 200) { errs.push(j.statusCode); continue; }\n  for (const k of (b.keys || [])) {\n    if (k.is_archived) continue;\n    let en = '';\n    for (const t of (k.translations || [])) if (String(t.language_iso).split('_')[0] === 'en') en = t.translation || '';\n    if (!/\\bterms\\b|privacy (policy|notice)/i.test(en)) continue;\n    for (const t of (k.translations || [])) {\n      const iso = String(t.language_iso).split('_')[0];\n      if (iso === 'en' || SKIP.includes(iso) || !t.translation) continue;\n      out.push({ pid: b.project_id, key_id: k.key_id, lang: iso, tid: t.translation_id, cur: t.translation, en });\n    }\n  }\n}\nreturn [{ json: { n: out.length, errs, rows: out } }];"
      }
    },
