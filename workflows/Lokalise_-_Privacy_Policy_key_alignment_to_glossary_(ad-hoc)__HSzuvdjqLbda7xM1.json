      "parameters": {
        "jsCode": "function fix(lang, s, key){\n  if(lang==='es'){ s=s.replace(/\\bnuestras((?:\\s|<[^>]+>)*)Términos/g,'nuestros$1Términos'); }\n  if(lang==='it'){\n    s=s.replace(/Termini di [Uu]tilizzo/g,\"Termini d'utilizzo\");\n    s=s.replace(/(presenti Termini o non accetta di essere vincolato) dalle stesse/,'$1 dagli stessi');\n  }\n  if(lang==='el'){ s=s.replace(/(Όρ(?:οι|ους|ων|ος|ου|o))([\\s ]+)Χρήσ/g,'$1$2χρήσ').replace(/(Πολιτικ\\p{L}*)([\\s ]+)Απορρ/gu,'$1$2απορρ'); }\n  return s;\n}\nfunction h(str){let x=5381;for(let i=0;i<str.length;i++){x=((x<<5)+x+str.charCodeAt(i))|0;}return (x>>>0).toString(36)+'.'+str.length;}\n\nconst H = {\"9487609392\":[\"1l2nuy6.430\",\"7k1dfw.429\"],\"9487609458\":[\"pltz5h.362\",\"1oewzsj.361\"],\"8894756279\":[\"n0e3v.519\",\"cpvix7.519\"],\"7037524557\":[\"12ldt7.230\",\"1rfa9xl.229\"],\"7213247393\":[\"13dtlj3.433\",\"1g7zri5.432\"],\"9342775748\":[\"1aspj3p.546\",\"15b134l.546\"],\"6215084849\":[\"1qacxy2.425\",\"ms56bc.424\"],\"6541312776\":[\"fmolxv.64\",\"1pb010x.63\"],\"6541312834\":[\"lzxlzn.63\",\"1sa1drl.62\"],\"8938706779\":[\"13dtlj3.433\",\"1g7zri5.432\"],\"5495122692\":[\"t58jd3.399\",\"xoxauf.399\"],\"5495122827\":[\"1808i8i.415\",\"1cjx9pu.415\"],\"5536870019\":[\"767nsa.156\",\"8c9sui.156\"],\"8922465992\":[\"170840w.376\",\"1djwkg0.376\"],\"9032032534\":[\"14k5664.140\",\"1d7dd3w.140\"],\"6717519670\":[\"ncdnsy.56\",\"75o540.55\"],\"7736650271\":[\"o8sej6.397\",\"ssh60i.397\"],\"7736650272\":[\"t58jd3.399\",\"xoxauf.399\"],\"8922464809\":[\"170840w.376\",\"1djwkg0.376\"],\"9030567333\":[\"1kj0tzh.131\",\"1r4b9wt.131\"],\"9030567463\":[\"sgjr0x.427\",\"x08ii9.427\"],\"9030567464\":[\"1pbexql.427\",\"1tv3p7x.427\"],\"9028431284\":[\"b0int.361\",\"1mpf4xz.361\"],\"9030567465\":[\"1mpoyld.360\",\"1t9df0h.360\"],\"9030568396\":[\"glu1u9.233\",\"1tdmmsx.233\"],\"9206028806\":[\"5bc8qc.573\",\"1jumqms.573\"],\"9313838139\":[\"1ae2fil.427\",\"1exr6zx.427\"],\"9313838161\":[\"60yzv5.572\",\"os0apd.572\"],\"9313838183\":[\"1kgwx4g.573\",\"zz3d1s.573\"],\"6078921547\":[\"16u8pg.19\",\"1egy3g2.18\"],\"6138814964\":[\"12cpesu.28\",\"1gaanv0.27\"],\"6138814970\":[\"12cpesu.28\",\"1gaanv0.27\"],\"6270900394\":[\"d52i97.241\",\"1c4d18p.240\"],\"6270900441\":[\"13f72sh.1150\",\"1w06em7.1149\"],\"6270900546\":[\"1higkuv.1028\",\"17fb4k5.1027\"],\"6270900577\":[\"9v5mgk.445\",\"823fjm.444\"],\"6270900676\":[\"vi8ky5.865\",\"1r8t6h7.864\"],\"6270900875\":[\"3o304x.821\",\"1sskbnz.820\"],\"4920721627\":[\"1kr547z.369\",\"qy7wgy.369\"],\"9789207758\":[\"phvpob.619\",\"ddv9dl.618\"]};\nconst rows = $input.first().json.rows || [];\nconst out = []; let skipped = 0, already = 0;\nfor (const r of rows) {\n  const e = H[String(r.tid)]; if (!e) continue;\n  const n = fix(r.lang, r.cur);\n  if (h(r.cur) === e[0] && h(n) === e[1]) out.push({ json: { pid: r.pid, tid: r.tid, key_id: r.key_id, lang: r.lang, new: n } });\n  else if (h(r.cur) === e[1]) already++; else skipped++;\n}\nreturn out;"
