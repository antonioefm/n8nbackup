        "jsCode": "const cfg = $('Params').first().json;\nconst b = $('Build').first().json;\nconst live = {}; for (const k of ($('Read Back').first().json.keys || [])) { const t = (k.translations||[]).find(x => x.language_iso === 'es') || {}; live[k.key_id] = t; }\nlet fixed = 0, unver = 0; const notFixed = [];\nfor (const [id, oldT, newT] of cfg.F) { const t = live[id] || {}; if (t.translation === newT) { fixed++; if (t.is_unverified) unver++; } else notFixed.push([id, t.translation]); }\nreturn [{ json: { sent: b.n, held: b.held, fixedNow: fixed, unverified: unver, notFixed } }];"
