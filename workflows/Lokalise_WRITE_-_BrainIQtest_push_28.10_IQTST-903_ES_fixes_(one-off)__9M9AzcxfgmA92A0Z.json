        "jsCode": "const cfg = $('Params').first().json;\nconst live = {}; for (const k of ($('Get Current').first().json.keys || [])) { const t = (k.translations||[]).find(x => x.language_iso === 'es') || {}; live[k.key_id] = { tr: t.translation, archived: k.is_archived }; }\nconst ups = []; const held = [];\nfor (const [id, oldT, newT] of cfg.F) {\n  const l = live[id];\n  if (!l || l.archived) { held.push([id, 'missing or archived']); continue; }\n  if (l.tr !== oldT) { held.push([id, 'changed since read: ' + l.tr]); continue; }\n  ups.push({ key_id: id, translations: [{ language_iso: 'es', translation: newT, is_unverified: true }] });\n}\nconst list = cfg.mode === 'one' ? ups.slice(0,1) : ups;\nreturn [{ json: { body: { keys: list }, n: list.length, held } }];"
