        "jsCode": "const L = {}; for (const l of ($('Glossary Langs').first().json.languages || [])) L[l.lang_id] = l.lang_iso;\nconst sh = t => { const d = t.data || t; const tr = {}; for (const x of (d.translations || [])) tr[L[x.langId] || x.langId] = x.translation; return { id: d.id, term: d.term, translations: tr }; };\nreturn [{ json: { tou: sh($('ToU Term').first().json), pp: sh($('PP Term').first().json) } }];"
