      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst tree = Array.isArray(body.tree) ? body.tree : [];\nconst rx = /(email|mail|template|notification)/i;\nconst hits = tree.filter(t => t.type === 'blob' && rx.test(t.path)).map(t => ({ path: t.path, size: t.size }));\nreturn [{ json: { total: tree.length, matched: hits.length, truncated: body.truncated === true, paths: hits.slice(0, 300) } }];"
      }
    }
