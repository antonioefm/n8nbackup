        "url": "=https://api.lokalise.com/api2/projects/3070657967b5854be32cb1.65162854/keys?include_translations=1&limit=500&page={{ $json.page }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          },
          "response": {
