      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $input.first().json;\nconst total = (p.statistics && p.statistics.keys_total) || 500;\nconst n = Math.max(1, Math.ceil(total / 500));\nconst out = [];\nfor (let i = 1; i <= n; i++) { out.push({ json: { page: i, name: p.name, base: p.base_language_iso, keys_total: total } }); }\nreturn out;"
      }
    },
    {
      "id": "521b3919-dccd-4b93-bdea-ed292a5ba395",
      "name": "Fetch Keys",
