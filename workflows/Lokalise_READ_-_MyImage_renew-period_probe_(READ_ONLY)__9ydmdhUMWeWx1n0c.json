    },
    {
      "id": "2b63ae88-4e6c-4245-ba2a-1020a5fe1918",
      "name": "Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $('Pages').first().json;\nconst out = []; let scanned = 0; const statuses = [];\nfor (const it of $input.all()) {\n  const r = it.json; statuses.push(r.statusCode);\n  for (const k of ((r.body && r.body.keys) || [])) {\n    if (k.is_archived) { continue; }\n    scanned++;\n    let en = ''; let hitTarget = false; const tr = {};\n    for (const t of (k.translations || [])) {\n      const iso = (t.language_iso || '').toLowerCase();\n      const v = typeof t.translation === 'string' ? t.translation : JSON.stringify(t.translation);\n      if (iso === 'en') { en = v; } else if (/weeks?\\b/i.test(v)) { hitTarget = true; }\n      tr[iso] = { v: v, reviewed: t.is_reviewed, tid: t.translation_id, modified: t.modified_at };\n    }\n    if (/renew/i.test(en) || hitTarget) {\n      out.push({ key_id: k.key_id, name: (k.key_name && k.key_name.web) || k.key_name, tags: k.tags, filenames: k.filenames, description: k.description, en: en, translations: tr });\n    }\n  }\n}\nreturn [{ json: { project: meta.name, keys_total: meta.keys_total, scanned: scanned, statuses: statuses, matched: out.length, keys: out } }];"
      }
    }
  ],
