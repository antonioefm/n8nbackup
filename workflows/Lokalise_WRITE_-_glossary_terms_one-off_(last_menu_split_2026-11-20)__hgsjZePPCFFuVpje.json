      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const u = $('Update Term').first().json; const c = $input.first().json;\nconst fmt = t => ({ id: t.id, term: t.term, tags: t.tags, desc: (t.description || '').slice(0, 80), filled: (t.translations || []).filter(x => x.translation).map(x => x.langId + ':' + x.translation) });\nreturn [{ json: { update_status: u.statusCode, updated: ((u.body || {}).data || []).map(fmt), update_error: (u.body || {}).error || (u.body || {}).errors || null, create_status: c.statusCode, created: ((c.body || {}).data || []).map(fmt), create_error: (c.body || {}).error || (c.body || {}).errors || null } }];"
      }
