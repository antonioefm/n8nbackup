      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 20.11.26 (Maria): discount 'save' entry 7490862 - it 'risparmio' -> 'risparmia' (strings aligned to 'Risparmia il X%'); de note updated (Silke's form 'X % sparen'). Other languages sent back unchanged.\nconst TERM_ID = 7490862;\nconst CH = { 734: ['risparmio', 'risparmia', '\"Save X%\" badge: \"Risparmia il X%\" (aligned Nov 2026); \"You save X%\": \"Risparmi il X%\".'], 666: ['sparen', 'sparen', '\"Save X%\" badge: \"X % sparen\" (DE linguist form, NBSP before %); \"You save X%\": \"Du sparst X %\".'] };\nconst meta = []; const all = []; let complete = false;\nfor (const n of ['P1','P2','P3']) {\n  const it = $(n).first().json; const b = it.body || {}; const h = it.headers || {};\n  meta.push({ n, s: it.statusCode, cnt: (b.data || []).length });\n  for (const t of (b.data || [])) all.push(t);\n  if (!h['x-pagination-next-cursor']) { complete = true; break; }\n}\nconst t = all.find(x => x.id === TERM_ID); const problems = [];\nif (!t) problems.push('term not found');\nlet update = { terms: [] };\nif (t) { update = { terms: [{ id: t.id, translations: (t.translations || []).filter(x => x.translation).map(x => { const c = CH[x.langId]; if (!c) return { langId: x.langId, translation: x.translation, description: x.description || '' }; if (String(x.translation).toLowerCase() !== c[0]) problems.push(x.langId + ' live ' + x.translation); return { langId: x.langId, translation: c[1], description: c[2] }; }) }] }; }\nreturn [{ json: { meta, complete, problems, proceed: complete && problems.length === 0 && meta.every(m => m.s === 200), update, create: { terms: [] } } }];\n"
      }
    },
