    {
      "id": "2eb32581-b1df-4538-9ec0-0f770d2f9755",
      "name": "Fix script mix",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        160
      ],
      "parameters": {
        "jsCode": "// Script/encoding guard (Maria's standing rule): block CJK/Hangul/Thai in other languages, mixed Cyrillic/Latin, mojibake.\nconst j = $input.first().json; const ID = {799:'sk',10159:'sl',765:'cs',769:'uk',733:'ko',753:'th',761:'el'};\nconst bad = [];\nfor (const body of [j.update, j.create]) for (const t of body.terms) for (const x of t.translations) {\n  const s = x.translation; const iso = ID[x.langId] || '';\n  if (/Ã|â€|\\uFFFD/.test(s)) bad.push(['mojibake', x.langId, s]);\n  if (iso !== 'ko' && /[\\u3040-\\u30ff\\u4e00-\\u9fff\\uac00-\\ud7af]/.test(s)) bad.push(['cjk', x.langId, s]);\n  if (iso !== 'th' && /[\\u0e00-\\u0e7f]/.test(s)) bad.push(['thai', x.langId, s]);\n  if (/[\\u0400-\\u04FF][A-Za-z]|[A-Za-z][\\u0400-\\u04FF]/.test(s)) bad.push(['mixed', x.langId, s]);\n}\nj.guard = bad; if (bad.length) j.proceed = false;\nreturn [{ json: j }];",
        "mode": "runOnceForAllItems"
      }
    },
