    {
      "id": "0c89988b-16c8-4950-893e-c3511b4164aa",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pr = $('Fetch Project').first().json;\nconst proj = pr.body || {};\nconst rows = [];\nconst statuses = [];\nfor (const it of $('Fetch Keys').all()) {\n  const r = it.json; statuses.push(r.statusCode);\n  for (const k of ((r.body || {}).keys || [])) {\n    if (k.is_archived) continue;\n    const kn = (typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other || Object.values(k.key_name)[0]) : k.key_name;\n    const t = {}; const tid = {}; const ed = {};\n    for (const tr of (k.translations || [])) { let v = tr.translation; if (v && typeof v === 'object') v = JSON.stringify(v); t[tr.language_iso] = v || ''; tid[tr.language_iso] = tr.translation_id; ed[tr.language_iso] = (tr.modified_by_email||'') + '|' + (tr.is_reviewed?1:0); }\n    const c = (k.comments || []).map(x => String(x.comment||'')).filter(Boolean).join(' | ').slice(0,400);\n    rows.push({ id: k.key_id, k: kn, d: k.description || '', cl: k.char_limit || 0, pl: k.is_plural ? 1 : 0, fn: k.filenames || {}, tags: k.tags || [], c: c, t: t, tid: tid, ed: ed });\n  }\n}\nreturn [{ json: { project: proj.name, base: proj.base_language_iso, statuses: statuses, n: rows.length, rows: rows } }];\n"
      }
    }
  ],
