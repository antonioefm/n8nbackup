    {
      "id": "0c89988b-16c8-4950-893e-c3511b4164aa",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pr = $('Fetch Project').first().json;\nconst proj = pr.body || {};\nconst base = (proj.base_language_iso || 'en').toLowerCase();\nconst PSEUDO = /^(ps|pst|ps_ps|xx|zz|qps|cus|pt_old)$|pseudo/i;\nconst rows = [];\nlet seen = 0, archived = 0;\nconst statuses = [];\nfor (const it of $('Fetch Keys').all()) {\n  const r = it.json;\n  statuses.push(r.statusCode);\n  const b = r.body || {};\n  for (const k of (b.keys || [])) {\n    seen++;\n    if (k.is_archived) { archived++; continue; }\n    const kn = (typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other || Object.values(k.key_name)[0]) : k.key_name;\n    let src = '';\n    const empty = [];\n    const filled = [];\n    for (const tr of (k.translations || [])) {\n      const iso = (tr.language_iso || '').toLowerCase();\n      let v = tr.translation;\n      if (v && typeof v === 'object') v = JSON.stringify(v);\n      v = v || '';\n      if (iso === base) { src = v; continue; }\n      if (PSEUDO.test(iso)) continue;\n      if (!v.trim()) empty.push(iso); else filled.push(iso);\n    }\n    rows.push({ id: k.key_id, k: kn, src: src, d: k.description || '', tags: k.tags || [], f: k.filenames || {}, ca: k.created_at || '', cb: k.created_by_email || '', mod: k.modified_at || '', ctx: k.context || '', cl: k.char_limit || 0, pl: k.is_plural ? 1 : 0, ph: k.is_hidden ? 1 : 0, ca2: k.custom_attributes || '', sc: (k.screenshots || []).length, cm: (k.comments || []).map(c => (c.added_by_email || '') + ': ' + c.comment), empty: empty, filled: filled.length });\n  }\n}\nrows.sort((a, b) => String(b.ca).localeCompare(String(a.ca)));\nreturn [{ json: { project: proj.name, base: base, langs: (proj.statistics || {}).languages, statuses: statuses, seen: seen, archived: archived, n: rows.length, rows: rows } }];\n"
      }
    }
  ],
