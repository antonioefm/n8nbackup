      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = ($('Config').first().json) || {};\nconst r = ($input.first().json) || {};\nconst b = r.body || {};\nconst out = { mode: cfg.mode, status: r.statusCode, errors: b.errors || [] };\nconst keys = b.keys || [];\nif (b.key) { keys.push(b.key); }\nout.keys = [];\nfor (const k of keys) {\n  const kn = k.key_name;\n  out.keys.push({\n    key_id: k.key_id,\n    name: (typeof kn === 'string') ? kn : ((kn && (kn.web || kn.other)) || ''),\n    tags: k.tags || [],\n    description: k.description || '',\n    screenshots: (k.screenshots || []).map(function (s) { return s.screenshot_id + ' ' + s.title; })\n  });\n}\nif (b.key_removed !== undefined) { out.key_removed = b.key_removed; }\nif (b.keys_locked !== undefined) { out.keys_locked = b.keys_locked; }\nreturn [{ json: out }];\n"
      }
    }
