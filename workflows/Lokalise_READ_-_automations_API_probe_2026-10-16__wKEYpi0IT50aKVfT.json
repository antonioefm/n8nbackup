      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ps = (items[0].json.projects || []);\nconst p = ps.find(x => /qr/i.test(x.name || '')) || ps[0];\nconst pid = p.project_id;\nconst tid = p.team_id;\nconst B = 'https://api.lokalise.com/api2';\nconst urls = [\n  B + '/projects/' + pid + '/automations',\n  B + '/projects/' + pid + '/automation',\n  B + '/projects/' + pid + '/automation_rules',\n  B + '/projects/' + pid + '/mt_automations',\n  B + '/automations',\n  B + '/teams/' + tid + '/automations',\n  B + '/projects/' + pid + '/webhooks',\n  B + '/projects/' + pid + '/__control_nonexistent__'\n];\nreturn urls.map(u => ({ json: { url: u, project: p.name, project_id: pid, team_id: tid, project_count: ps.length, project_names: ps.map(x => x.name + ' | ' + x.project_id) } }));"
      }
    },
