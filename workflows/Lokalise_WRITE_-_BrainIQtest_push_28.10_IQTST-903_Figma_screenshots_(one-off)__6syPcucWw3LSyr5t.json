        "jsCode": "const cfg = $('Params').first().json;\nconst keys = $('Get Current').first().json.keys || [];\nconst has = {}; for (const k of keys) has[k.key_id] = (k.screenshots || []).length;\nconst out = []; const report = [];\nfor (const s of cfg.S) {\n  const ids = s.key_ids.filter(id => !has[id]);\n  report.push({ title: s.title, wanted: s.key_ids.length, link: ids.length, alreadyHadScreenshot: s.key_ids.length - ids.length });\n  if (cfg.write && ids.length) out.push({ json: { body: { screenshots: [{ data: s.data, title: s.title, description: s.description, key_ids: ids }] }, report } });\n}\nif (!out.length) return [{ json: { report, write: false } }];\nreturn out;"
