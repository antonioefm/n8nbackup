        }
      },
      "executeOnce": true
    },
    {
      "id": "af4309df-a368-486e-87d8-dec0b9859c09",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst ps = ($input.first().json.projects || []);\nconst all = cfg.pids.indexOf('ALL') !== -1;\nconst out = [];\nfor (const p of ps) {\n  if (!all && cfg.pids.indexOf(p.project_id) === -1) { continue; }\n  for (const l of ((p.statistics || {}).languages || [])) { out.push({ json: { pid: p.project_id, name: p.name, lang_id: l.language_id, iso: l.language_iso } }); }\n}\nif (!out.length) { throw new Error('nothing planned'); }\nreturn out;"
      }
    },
    {
      "id": "ba9b0e46-fb16-4ca0-bc34-140f38cf8443",
      "name": "Scan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "const plan = $('Plan').all().map(function (i) { return i.json; });\nconst res = $input.all().map(function (i) { return i.json || {}; });\nconst hits = []; const failed = []; let checked = 0; const per = {};\nfor (let i = 0; i < plan.length; i++) {\n  const p = plan[i]; const r = res[i] || {};\n  if (!Array.isArray(r.hits)) { failed.push(p.name + ' / ' + p.iso + ': ' + JSON.stringify(r.error || r).slice(0, 150)); continue; }\n  checked += r.checked || 0;\n  per[p.name] = (per[p.name] || 0) + (r.checked || 0);\n  for (const h of r.hits) { hits.push(Object.assign({ project: p.name, pid: p.pid }, h)); }\n}\nreturn [{ json: { GLOBAL_SCAN: { units: plan.length, checked: checked, per_project: per, failed: failed, count: hits.length, hits: hits } } }];"
      }
    },
    {
