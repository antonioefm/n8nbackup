      ],
      "parameters": {
        "jsCode": "// Which projects to scan this run. ['ALL'] = every project; [] = list projects only (no scan).\nconst PIDS = ['ALL'];\nreturn [{ json: { pids: PIDS } }];"
      }
    },
    {
      "id": "fae63081-64b7-4048-a57e-00fa34779b0b",
      "name": "Projects",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.lokalise.com/api2/projects?limit=500&include_statistics=1&include_settings=0",
