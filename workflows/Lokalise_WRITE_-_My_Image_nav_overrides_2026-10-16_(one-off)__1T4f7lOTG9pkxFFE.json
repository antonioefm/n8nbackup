      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const kitems = $('Keys URL').all();\nconst want = new Set();\nfor (const it of kitems) for (const k of (it.json.body.keys || [])) for (const t of k.translations) want.add(k.key_id + '|' + t.language_iso);\nconst after = [];\nfor (const it of $input.all()) { for (const k of ((it.json.body || {}).keys || [])) for (const t of (k.translations || [])) if (want.has(k.key_id + '|' + t.language_iso)) after.push({ key_id: k.key_id, iso: t.language_iso, text: t.translation }); }\nreturn [{ json: { report: kitems[0].json.report, statuses: $input.all().map(i => i.json.statusCode), errors: $input.all().map(i => (i.json.body || {}).errors || []), after } }];"
      }
