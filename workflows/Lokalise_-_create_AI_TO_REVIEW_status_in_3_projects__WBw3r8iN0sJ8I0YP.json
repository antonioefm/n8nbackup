    {
      "id": "a029e0f8-7969-46a7-937a-01e31c0de2cc",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Only the three projects that lack an AI_TO_REVIEW status.\n// Colour matches the AI_TO_REVIEW yellow used in the projects that already have it (#f2d600).\nconst P = [\n  ['Mobitrace - backend/emails','9274956467e3e224807498.79791832'],\n  ['Unicopy','35679002689c4f3ba6dd50.31739712'],\n  ['Unicopy (backend)','1600517668d38be7f36ba4.51132642']\n];\nconst out = [];\nfor (const p of P) {\n  out.push({ json: { name: p[0], pid: p[1], url: 'https://api.lokalise.com/api2/projects/' + p[1] + '/custom_translation_statuses', body: { title: 'AI_TO_REVIEW', color: '#f2d600' } } });\n}\nreturn out;\n"
      }
    },
    {
      "id": "7deba75e-1979-463b-803a-f59084e7edf6",
      "name": "Create Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "bece0760-1ee1-4bc9-81f1-f303398cd617",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Config').all();\nconst res = $input.all();\nconst rows = [];\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || { json: {} }).json;\n  const r = res[i].json || {};\n  const b = r.body || {};\n  const st = b.custom_translation_status || null;\n  rows.push({\n    project: meta.name,\n    pid: meta.pid,\n    status_code: r.statusCode,\n    created_id: st ? st.status_id : null,\n    created_title: st ? st.title : null,\n    error: st ? null : JSON.stringify(b).slice(0, 300)\n  });\n}\nreturn [{ json: { results: rows } }];\n"
      }
    }
  ],
