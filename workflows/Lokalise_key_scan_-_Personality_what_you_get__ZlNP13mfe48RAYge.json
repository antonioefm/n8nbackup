    {
      "id": "120a419d-6367-4b7a-8aae-01bbc7cd4e34",
      "name": "Pick Source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nlet scanned = 0;\nfor (const it of $input.all()) {\n  for (const k of (it.json.keys || [])) {\n    scanned++;\n    const names = (k.key_name && typeof k.key_name === 'object') ? k.key_name : { all: k.key_name };\n    const blob = JSON.stringify(names).toLowerCase();\n    if (blob.indexOf('challenges_ps') < 0 && blob.indexOf('courses_ps') < 0) { continue; }\n    const tr = {};\n    for (const t of (k.translations || [])) { tr[t.language_iso] = t.translation; }\n    out.push({ json: { key_id: k.key_id, key_name: names, is_archived: k.is_archived, en: tr['en'] } });\n  }\n}\nout.push({ json: { scanned: scanned } });\nreturn out;\n"
      }
    }
