    {
      "id": "7978586f-facb-487c-9f37-3dab7c92c422",
      "name": "Collect Yesterday Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const FROM = Date.parse('2026-10-25T23:00:00Z') / 1000;\nconst TO = Date.parse('2026-10-26T23:00:00Z') / 1000;\nconst out = [];\nlet total = 0;\nconst errors = [];\nfor (const it of items) {\n  const b = it.json.body || {};\n  if (it.json.statusCode && it.json.statusCode !== 200) { errors.push(it.json.statusCode + ' ' + JSON.stringify(b).slice(0, 200)); }\n  for (const k of (b.keys || [])) {\n    total++;\n    const ts = k.created_at_timestamp;\n    if (ts >= FROM && ts < TO) {\n      const tr = (k.translations || [])[0] || {};\n      const kn = typeof k.key_name === 'object' ? (k.key_name.web || k.key_name.other || k.key_name.ios || k.key_name.android) : k.key_name;\n      out.push({ key_id: k.key_id, key_name: kn, created_at: k.created_at, source: tr.translation, screenshots: (k.screenshots || []).length, tags: k.tags, description: k.description, platforms: k.platforms });\n    }\n  }\n}\nreturn [{ json: { total_keys_scanned: total, matched: out.length, errors: errors, keys: out } }];\n"
      }
    }
  ],
