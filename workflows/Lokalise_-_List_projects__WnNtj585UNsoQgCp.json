      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = [];\nfor (const it of $input.all()) {\n  for (const p of ((it.json || {}).projects || [])) {\n    const st = p.statistics || {};\n    rows.push(p.project_id + ' | ' + p.name + ' | keys ' + (st.keys_total || 0) + ' | langs ' + (st.languages ? st.languages.length : 0) + ' | base ' + (p.base_language_iso || ''));\n  }\n}\nrows.sort();\nreturn [{ json: { count: rows.length, rows: rows } }];\n"
      }
    }
