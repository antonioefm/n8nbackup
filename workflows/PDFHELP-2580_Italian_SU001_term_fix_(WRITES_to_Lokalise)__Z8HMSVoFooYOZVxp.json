      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const FIX = {\n  959668372: { old: 'Compila online un certificato di cessazione del rapporto di lavoro SU001 di Services Australia con PDF Help. Inserisci le date del rapporto di lavoro e la retribuzione finale, poi scarica un PDF.', nu: 'Compila online un certificato di fine rapporto SU001 di Services Australia con PDF Help. Inserisci le date del rapporto di lavoro e la retribuzione finale, poi scarica un PDF.' },\n  959668373: { old: 'Compila il certificato di cessazione del rapporto di lavoro di Centrelink con PDF Help. Controlla le date e gli importi e scarica un PDF.', nu: 'Compila il certificato di fine rapporto di Centrelink con PDF Help. Controlla le date e gli importi e scarica un PDF.' }\n};\nconst r = $input.first().json; const keys = []; const skipped = [];\nfor (const k of ((r.body && r.body.keys) || [])) {\n  const t = (k.translations || []).find(function(x){ return x.language_iso === 'it'; });\n  const f = FIX[k.key_id];\n  if (!t || !f) { skipped.push({ key_id: k.key_id, why: 'no it' }); continue; }\n  if (t.translation !== f.old) { skipped.push({ key_id: k.key_id, why: 'changed since my write', current: t.translation, by: t.modified_by_email }); continue; }\n  keys.push({ key_id: k.key_id, translations: [{ language_iso: 'it', translation: f.nu }] });\n}\nreturn [{ json: { body: { keys: keys }, n: keys.length, skipped: skipped, want: FIX } }];"
      }
