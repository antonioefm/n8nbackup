        "jsCode": "const r = $input.first().json; const b = $('Build Body').first().json; const out = [];\nfor (const k of ((r.body && r.body.keys) || [])) { const t = (k.translations || []).find(function(x){ return x.language_iso === 'it'; }); out.push({ key: k.key_name && k.key_name.web, it: t && t.translation, ok: t && t.translation === b.want[k.key_id].nu }); }\nreturn [{ json: { status: r.statusCode, errors: (r.body && r.body.errors) || null, written: out, skipped: b.skipped } }];"
