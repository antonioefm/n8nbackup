        "jsCode": "const j = items[0].json || {};\nconst topKeys = Object.keys(j);\nconst d = j.data !== undefined ? j.data : j;\nconst terms = Array.isArray(d) ? d : (d.terms || []);\nreturn [{ json: { topLevelKeys: topKeys, meta: j.meta || j.pagination || null, count: terms.length, firstTerm: (terms[0] || {}).term, lastTerm: (terms[terms.length - 1] || {}).term, nonDataDump: JSON.stringify(Object.fromEntries(Object.entries(j).filter(([k]) => k !== 'data'))).slice(0, 600) } }];\n"
      }
    }
