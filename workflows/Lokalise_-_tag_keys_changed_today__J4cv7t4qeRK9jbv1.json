    {
      "id": "b991e03f-c26b-49c5-9ce2-56dd6454f5df",
      "name": "Filter Today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Today = 2026-11-04 in Europe/Warsaw (CET, UTC+1)\nconst START = Date.UTC(2026, 10, 3, 23, 0, 0) / 1000;\nconst END = START + 86400;\nconst TAG = '041126';\nconst seen = {};\nconst matched = [];\nlet total = 0;\nlet byCreated = 0, byKeyMod = 0, byTrMod = 0, alreadyTagged = 0;\nfor (const it of $input.all()) {\n  for (const k of (it.json.keys || [])) {\n    if (seen[k.key_id]) { continue; }\n    seen[k.key_id] = 1;\n    total++;\n    const c = k.created_at_timestamp || 0;\n    const m = k.modified_at_timestamp || 0;\n    const t = k.translations_modified_at_timestamp || 0;\n    const inC = c >= START && c < END;\n    const inM = m >= START && m < END;\n    const inT = t >= START && t < END;\n    if (!(inC || inM || inT)) { continue; }\n    if (inC) byCreated++;\n    if (inM) byKeyMod++;\n    if (inT) byTrMod++;\n    const tags = k.tags || [];\n    if (tags.indexOf(TAG) >= 0) alreadyTagged++;\n    const nm = k.key_name;\n    const name = (nm && typeof nm === 'object') ? (nm.web || nm.other || nm.ios || nm.android || JSON.stringify(nm)) : nm;\n    matched.push({ key_id: k.key_id, name: name, created: inC, key_modified: inM, tr_modified: inT, tags: tags });\n  }\n}\nreturn [{ json: { total_keys_scanned: total, pages: $input.all().length, matched_count: matched.length, by_created: byCreated, by_key_modified: byKeyMod, by_translation_modified: byTrMod, already_tagged: alreadyTagged, matched: matched } }];\n"
      }
    },
    {
      "id": "307ed000-f21a-4993-8a83-a033223694cc",
      "name": "Build Tag Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const DRY_RUN = false;\nconst TAG = '041126';\nif (DRY_RUN) { return []; }\nconst ks = $input.first().json.matched.filter(function (m) { return (m.tags || []).indexOf(TAG) < 0; });\nconst out = [];\nfor (let i = 0; i < ks.length; i += 500) {\n  out.push({ json: { body: { keys: ks.slice(i, i + 500).map(function (m) { return { key_id: m.key_id, tags: [TAG], merge_tags: true }; }) } } });\n}\nreturn out;\n"
      }
    },
