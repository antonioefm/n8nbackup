    },
    {
      "id": "4c7ad238-bfd9-4223-98f8-16f471eaab6f",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "let ok = 0; let missing = []; let errors = [];\nfor (const it of $input.all()) {\n  for (const k of (it.json.keys || [])) { if ((k.tags || []).indexOf('291026') >= 0) { ok++; } else { missing.push(k.key_id); } }\n  for (const e of (it.json.errors || [])) { errors.push(e); }\n}\nreturn [{ json: { tagged: ok, missing: missing, errors: errors } }];\n",
        "mode": "runOnceForAllItems"
      }
    }
  ],
