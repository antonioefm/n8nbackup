    {
      "id": "4f73ecd2-901c-4912-a1dd-deff495e9455",
      "name": "Select Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 'Today' = 29 Oct 2026 in Europe/Warsaw (CET, UTC+1) -> from 2026-10-28T23:00:00Z\nconst START = Date.parse('2026-10-28T23:00:00Z') / 1000;\nconst END = Date.parse('2026-10-29T23:00:00Z') / 1000;\nconst proj = $('Fetch Project').first().json;\nconst base = (proj.base_language_iso || 'en').toLowerCase();\nconst seen = {};\nconst added = [];\nconst updated = [];\nlet total = 0;\nlet pages = 0;\nlet archivedSkipped = 0;\nfor (const it of $input.all()) {\n  pages++;\n  for (const k of (it.json.keys || [])) {\n    if (seen[k.key_id]) { continue; }\n    seen[k.key_id] = 1;\n    total++;\n    const name = (k.key_name && (k.key_name.web || k.key_name.other || k.key_name.ios || k.key_name.android)) || String(k.key_id);\n    const c = k.created_at_timestamp || 0;\n    let enMod = 0;\n    let enText = '';\n    for (const tr of (k.translations || [])) {\n      if ((tr.language_iso || '').toLowerCase() === base) { enMod = tr.modified_at_timestamp || 0; enText = tr.translation; }\n    }\n    const isAdded = c >= START && c < END;\n    const isUpd = !isAdded && enMod >= START && enMod < END;\n    if (!isAdded && !isUpd) { continue; }\n    if (k.is_archived) { archivedSkipped++; continue; }\n    const row = { key_id: k.key_id, name: name, created: k.created_at, en_modified: enMod ? new Date(enMod * 1000).toISOString() : null, tags: k.tags || [], en: String(enText || '').slice(0, 80) };\n    if (isAdded) { added.push(row); } else { updated.push(row); }\n  }\n}\nreturn [{ json: { base_lang: base, project_name: proj.name, pages: pages, total_keys_scanned: total, added_count: added.length, updated_count: updated.length, archived_skipped: archivedSkipped, key_ids: added.concat(updated).map(function (r) { return r.key_id; }), added: added, updated: updated } }];\n"
      }
    },
    {
      "id": "bab5a172-e8a5-4032-aab5-63ba2b871107",
      "name": "Build Tag Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const TAG = '291026';\nconst ids = $input.first().json.key_ids || [];\nconst out = [];\nfor (let i = 0; i < ids.length; i += 500) {\n  out.push({ json: { body: { keys: ids.slice(i, i + 500).map(function (id) { return { key_id: id, tags: [TAG], merge_tags: true }; }) } } });\n}\nreturn out;\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
