        }
      }
    },
    {
      "id": "00b2ecef-470f-4c04-966f-423425bd9e11",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { keys: ($input.first().json.keys || []).map(function (k) { const o = { id: k.key_id, name: k.key_name.web, tags: k.tags, desc: k.description }; for (const t of (k.translations || [])) { o[t.language_iso] = t.translation; } return o; }) } }];"
      }
    }
