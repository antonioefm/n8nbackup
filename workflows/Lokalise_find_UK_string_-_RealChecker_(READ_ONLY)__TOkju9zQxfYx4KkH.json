      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const l = ($input.first().json.languages || []).find(function (x) { return String(x.lang_iso).toLowerCase().indexOf('uk') === 0; });\nreturn [{ json: { lang_id: l ? l.lang_id : null, iso: l ? l.lang_iso : null } }];"
      }
    },
