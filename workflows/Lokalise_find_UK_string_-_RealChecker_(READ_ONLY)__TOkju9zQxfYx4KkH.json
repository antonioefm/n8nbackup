    {
      "id": "454e3e52-d883-4b30-88c1-07fa1ce1ba96",
      "name": "Find",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = $input.first().json.translations || [];\nconst hits = t.filter(function (x) { return /готов/i.test(x.translation || ''); });\nreturn [{ json: { total: t.length, ids: hits.map(function (h) { return h.key_id; }).join(','), hits: hits.map(function (h) { return { key_id: h.key_id, uk: h.translation }; }) } }];"
      }
    },
    {
      "id": "cc9d7168-11e6-4a4c-84b5-412341d4f6c1",
