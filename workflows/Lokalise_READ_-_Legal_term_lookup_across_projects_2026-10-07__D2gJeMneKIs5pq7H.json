    },
    {
      "id": "18a90fb4-f359-4407-a1d5-01c9f2868f8e",
      "name": "Pick Legal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// READ ONLY. Keep keys whose EN is 'Legal' or a short label containing it.\nconst names = {}; for (const p of ($('List projects').first().json.projects || [])) names[p.project_id] = p.name;\nconst out = []; const errs = []; let seen = 0;\nfor (const it of $input.all()) { const b = it.json.body || {};\n  if (!Array.isArray(b.keys)) { errs.push(JSON.stringify(b).slice(0, 200)); continue; }\n  for (const k of b.keys) { seen++; const en = ((k.translations || []).find(t => t.language_iso === 'en') || {}).translation;\n    if (typeof en !== 'string') continue; const s = en.trim();\n    const exact = /^legal:?$/i.test(s); const shortL = !exact && /\\blegal\\b/i.test(s) && s.split(/\\s+/).length <= 3;\n    if (!exact && !shortL) continue;\n    const kn = typeof k.key_name === 'string' ? k.key_name : (k.key_name.web || k.key_name.other || '');\n    out.push({ json: { pid: b.project_id, pname: names[b.project_id] || b.project_id, kid: k.key_id, key: kn, en: s, exact, url: 'https://api.lokalise.com/api2/projects/' + b.project_id + '/keys/' + k.key_id + '?disable_references=1' } }); } }\nif (!out.length) return [{ json: { none: true, seen, errs } }];\nout[0].json.seen = seen; out[0].json.errs = errs;\nreturn out;\n"
      }
    },
    {
      "id": "19f8f47e-dd5b-4715-bc14-5836c0a1e8f3",
      "name": "Fetch key",
