      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// READ ONLY. One item per project: EN-only key list.\nconst ps = $input.first().json.projects || [];\nreturn ps.map(p => ({ json: { pid: p.project_id, pname: p.name, url: 'https://api.lokalise.com/api2/projects/' + p.project_id + '/keys?include_translations=1&disable_references=1&filter_archived=exclude&filter_translation_lang_ids=640&limit=500&pagination=cursor' } }));\n"
      }
    },
    {
