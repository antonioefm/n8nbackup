    {
      "id": "279fb749-1d89-4a6c-b8fb-75ca3d2b2270",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// READ ONLY. Compact output.\nconst picks = $('Pick Legal').all().map(i => i.json);\nconst res = $input.all();\nconst rows = res.map((it, i) => { const p = picks[i] || {}; const k = (it.json.body || {}).key || {}; const t = {};\n  for (const x of (k.translations || [])) { if (['en','ps','pst','cus','pt_old'].includes(x.language_iso)) continue; if (x.translation) t[x.language_iso] = [x.translation, x.modified_by_email || '', x.is_reviewed ? 1 : 0]; }\n  return { proj: p.pname, key: p.key, en: p.en, exact: p.exact, t }; });\nreturn [{ json: { seen: picks[0] && picks[0].seen, errs: picks[0] && picks[0].errs, n: rows.length, rows } }];\n"
      }
    }
  ],
