      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = ['de','es','fr','it','ko','ms','nl','pt','sv','th','vi'];\nconst out = []; const meta = []; const seen = {};\nfor (const n of ['P1','P2','P3']) {\n  const it = $(n).first().json; const b = it.body || {}; const h = it.headers || {};\n  meta.push({ n: n, s: it.statusCode, next: h['x-pagination-next-cursor'], cnt: (b.data || []).length });\n  for (const t of (b.data || [])) {\n    if (seen[t.id]) continue; seen[t.id] = 1;\n    const tr = {};\n    for (const x of (t.translations || [])) { const iso = (x.langIso || x.language_iso || '').toLowerCase(); if (L.indexOf(iso) >= 0 && x.translation) tr[iso] = x.translation; }\n    out.push({ term: t.term, desc: t.description, tr: t.translatable, forbidden: t.forbidden, tags: t.tags, t: tr });\n  }\n}\nreturn [{ json: { meta: meta, count: out.length, terms: out } }];"
      }
    }
