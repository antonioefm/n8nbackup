      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of items) {\n  const ps = it.json.projects || [];\n  for (const p of ps) {\n    if (!/chat|bot/i.test(p.name)) continue;\n    out.push({ json: { project_id: p.project_id, name: p.name, keys_total: p.statistics && p.statistics.keys_total, langs: (p.statistics && p.statistics.languages || []).map(l => l.language_iso + ':' + l.progress + '%').join(', ') } });\n  }\n}\nreturn out;"
      }
    }
