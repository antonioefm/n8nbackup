      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of items) {\n  const j = it.json || {};\n  const d = j.data || j;\n  const terms = d.terms || [];\n  for (const t of terms) {\n    out.push({ json: { project_id: d.project_id || j.project_id || '', term: t.term, description: t.description, part_of_speech: t.partOfSpeech || t.part_of_speech, case_sensitive: t.caseSensitive, translatable: t.translatable, forbidden: t.forbidden, tags: t.tags || [], translations: (t.translations || []).map(x => (x.langName || x.lang_iso || x.langId) + '=' + x.translation).join(' | ') } });\n  }\n  if (!terms.length) out.push({ json: { note: 'no terms or error', raw: JSON.stringify(j).slice(0, 400) } });\n}\nreturn out;"
      }
    }
