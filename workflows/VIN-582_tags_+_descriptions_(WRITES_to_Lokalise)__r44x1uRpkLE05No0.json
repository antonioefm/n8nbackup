        "jsCode": "const cfg = $('Params').first().json;\nconst before = {}; for (const k of ($('Get Current').first().json.keys || [])) before[k.key_id] = k.tags || [];\nreturn ($('Read Back').first().json.keys || []).map(k => ({ json: { key_id: k.key_id, name: (k.key_name || {}).web, tags: k.tags, hasNewTags: cfg.tags.every(t => (k.tags || []).includes(t)), keptOldTags: before[k.key_id].every(t => (k.tags || []).includes(t)), descAppended: String(k.description || '').includes(cfg.append), description: k.description } }));"
      }
