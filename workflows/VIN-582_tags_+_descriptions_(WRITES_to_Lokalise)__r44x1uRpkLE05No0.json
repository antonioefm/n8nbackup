    {
      "id": "354ec879-8b2f-4457-957b-28e38190248c",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Params').first().json;\nconst all = new Set(); for (const it of $('Fetch Tags').all()) for (const k of (it.json.keys || [])) for (const t of (k.tags || [])) all.add(t);\nconst similar = Array.from(all).filter(t => /plate|vin-582|vin-418|search/i.test(t));\nconst keys = []; const held = [];\nfor (const k of ($('Get Current').first().json.keys || [])) {\n  if (k.is_archived) { held.push([k.key_id, 'archived']); continue; }\n  const out = { key_id: k.key_id };\n  const newTags = cfg.tags.filter(t => !(k.tags || []).includes(t));\n  if (newTags.length) { out.tags = newTags; out.merge_tags = true; }\n  const d = String(k.description || '');\n  if (!d.includes(cfg.append)) out.description = d.trim() ? d.trim() + '\\n' + cfg.append : cfg.append;\n  if (out.tags || out.description !== undefined) keys.push(out); else held.push([k.key_id, 'nothing to change']);\n}\nif (cfg.mode === 'check') throw new Error('CHECK ' + JSON.stringify({ similar, keys, held }));\nconst body = { keys: cfg.mode === 'one' ? keys.slice(0, 1) : keys };\nif (!body.keys.length) throw new Error('nothing to write ' + JSON.stringify(held));\nreturn [{ json: { body, held } }];"
      }
    },
