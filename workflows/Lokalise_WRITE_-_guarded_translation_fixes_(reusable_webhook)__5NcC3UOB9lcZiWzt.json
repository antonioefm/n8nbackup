        "jsCode": "const cfg = $('Params').first().json;\nconst same = (a, b) => { if (a === b) return true; try { return JSON.stringify(typeof a === 'string' ? JSON.parse(a) : a) === JSON.stringify(typeof b === 'string' ? JSON.parse(b) : b); } catch (e) { return false; } };\nconst live = {}; for (const k of ($('Read Back').first().json.keys || [])) for (const t of (k.translations||[])) live[k.key_id + '|' + t.language_iso] = t;\nlet fixed = 0, unver = 0; const notFixed = [];\nfor (const [id, iso, oldT, newT] of cfg.F) { const t = live[id + '|' + iso] || {}; if (same(t.translation, newT)) { fixed++; if (t.is_unverified) unver++; } else notFixed.push([id, iso, t.translation]); }\nconst b = $('Build').all();\nreturn [{ json: { sent: b.reduce((a, i) => a + i.json.n, 0), held: b[0].json.held, fixedNow: fixed, unverified: unver, notFixed } }];"
