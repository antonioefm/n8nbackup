      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Params').first().json;\nconst norm = v => (v && typeof v === 'object') ? JSON.stringify(v) : v;\nconst same = (a, b) => { if (a === b) return true; try { return JSON.stringify(typeof a === 'string' ? JSON.parse(a) : a) === JSON.stringify(typeof b === 'string' ? JSON.parse(b) : b); } catch (e) { return false; } };\nconst live = {}; for (const k of ($('Get Current').first().json.keys || [])) { if (k.is_archived) continue; for (const t of (k.translations||[])) live[k.key_id + '|' + t.language_iso] = t.translation; }\nconst per = {}; const held = [];\nfor (const [id, iso, oldT, newT] of cfg.F) { const l = live[id + '|' + iso]; if (!same(l, oldT)) { held.push([id, iso, 'changed since read']); continue; } (per[id] = per[id] || []).push({ language_iso: iso, translation: newT, is_unverified: true }); }\nlet keys = Object.keys(per).map(id => ({ key_id: Number(id), translations: per[id] }));\nif (cfg.mode === 'one') keys = keys.slice(0, 1);\nconst out = []; for (let i = 0; i < keys.length; i += 40) out.push({ json: { body: { keys: keys.slice(i, i + 40) }, n: keys.slice(i, i + 40).reduce((a, k) => a + k.translations.length, 0), held } });\nif (!out.length) throw new Error('nothing to write: ' + JSON.stringify(held.slice(0, 20)));\nreturn out;"
      }
