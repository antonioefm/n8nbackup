    {
      "id": "2b400001-12f1-43da-a306-41eaf0a354d6",
      "name": "Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// EDIT ME for each run.\nreturn [{ json: {\n \"project_id\": \"31393214664f295f94dd86.76792605\",\n \"descriptions\": {\n  \"978903953\": \"Checkout page, A/B test PERSO-016 (variant test_a). Accessibility label (aria-label) of the small back-arrow button next to the “Credit card” heading, shown after the user taps “Credit or Debit card”. Not visible on screen: screen readers read it aloud. It is an action: tapping it takes the user back to the list of payment method buttons (Apple Pay, Google Pay, card). Translate as an instruction (“Go back to payment methods”), not as a heading. “Payment methods” = the ways to pay (wallets, card). Ticket: PERSO-4510.\",\n  \"978903954\": \"Checkout page, A/B test PERSO-016 (variant test_a), section “Select a payment method”. Label of the full-width green button under the Apple Pay and Google Pay buttons; tapping it opens the card form (card number, expiry, CVC). Noun phrase naming the payment method (pay by credit or debit card), not a verb. Button text: keep it short, one line on mobile. The capital D in “Debit” is English styling only; use your language’s normal capitalisation. Ticket: PERSO-4510.\"\n },\n \"image_url\": \"https://www.figma.com/api/mcp/asset/8fc7b93c-f295-4045-913b-cb3b6392400a.png\",\n \"shot_title\": \"PERSO-4510 – Checkout: payment method buttons and card form\",\n \"shot_desc\": \"Figma design (Personality.co, node 29204-395788). Payment method buttons with “Credit or Debit card” (test_a), then the card form opened from it: the ‹ back arrow next to “Credit card” carries the aria-label “Back to payment methods”.\",\n \"shot_tag\": \"PERSO-4510\"\n} }];\n"
      }
    },
    {
      "id": "010100cd-155b-4d0e-941a-048d8ef9deef",
      "name": "Get Keys",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/keys?include_screenshots=1&limit=500&filter_key_ids={{ Object.keys($json.descriptions).join(\",\") }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f87409d7-829e-422c-b74c-1a6a859baf56",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Params').first().json; const keys = ($input.first().json.body && $input.first().json.body.keys) || [];\nconst put = []; const kept = []; const shotIds = []; const hadShot = [];\nfor (const k of keys) {\n  if (k.is_archived) { continue; }\n  const d = p.descriptions[String(k.key_id)];\n  if (d && !(k.description || '').trim()) { put.push({ key_id: k.key_id, description: d }); } else { kept.push(k.key_id); }\n  if ((k.screenshots || []).length === 0) { shotIds.push(k.key_id); } else { hadShot.push(k.key_id); }\n}\nreturn [{ json: { project_id: p.project_id, body: { keys: put.length ? put : [{ key_id: 0 }] }, put_count: put.length, kept: kept, shot_ids: shotIds, had_shot: hadShot, image_url: p.image_url } }];"
      }
    },
    {
