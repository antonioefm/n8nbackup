      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('Build').first().json; const put = $('Put Descriptions').first().json; const shot = $('Post Screenshot').first().json;\nconst keys = ($input.first().json.body && $input.first().json.body.keys) || [];\nreturn [{ json: { put_count: b.put_count, kept: b.kept, put_status: put.statusCode, put_errors: put.body && put.body.errors, shot_status: shot.statusCode, shot_ids: b.shot_ids, shot_result: shot.body && (shot.body.screenshots || []).map(function (s) { return { id: s.screenshot_id, key_ids: s.key_ids, title: s.title }; }), shot_errors: shot.body && (shot.body.errors || shot.body.error), after: keys.map(function (k) { return { id: k.key_id, tags: k.tags, description: k.description, screenshots: (k.screenshots || []).length }; }) } }];"
