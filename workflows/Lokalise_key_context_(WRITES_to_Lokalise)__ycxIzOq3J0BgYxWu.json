      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Params').first().json; const b = $('Build').first().json;\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst ids = b.shot_ids;\nreturn [{ json: { project_id: p.project_id, skip: ids.length === 0, body: { screenshots: [{ data: 'data:image/png;base64,' + buf.toString('base64'), title: p.shot_title, description: p.shot_desc, ocr: false, key_ids: ids, tags: [p.shot_tag] }] } } }];"
      }
