    {
      "id": "19e044c6-d678-4d72-8156-2e7cdfe0278f",
      "name": "PR Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rq = $('Compare Reqs').all(); const res = $input.all(); const out = [];\nfor (let i = 0; i < res.length; i++) {\n  const b = res[i].json.body || {}; const m = rq[i].json;\n  for (const c of (b.commits || []).slice(-40)) {\n    if ((c.parents || []).length > 1) { continue; }\n    out.push({ json: { repo: m.repo, merge: m.merge, sha: c.sha, message: (c.commit && c.commit.message) || '', date: c.commit && c.commit.committer && c.commit.committer.date } });\n  }\n}\nif (out.length === 0) { out.push({ json: { repo: 'none', merge: 'none', sha: 'none' } }); }\nreturn out;"
      }
    },
    {
      "id": "4913c7e9-0588-460b-a9ea-6783dd75cb49",
      "name": "Commit Detail",
      "type": "n8n-nodes-base.httpRequest",
