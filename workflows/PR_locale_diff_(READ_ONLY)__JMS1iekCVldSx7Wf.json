    {
      "id": "7501bf34-866f-4aec-afbe-29b1787f95d8",
      "name": "Compare Reqs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cf = $('Config').all(); const res = $input.all(); const out = [];\nfor (let i = 0; i < res.length; i++) {\n  const b = res[i].json.body || {}; const ps = (b.parents || []).map(function (p) { return p.sha; });\n  out.push({ json: { repo: cf[i].json.repo, merge: cf[i].json.merge, sha: b.sha, message: (b.commit && b.commit.message) || '', date: b.commit && b.commit.committer && b.commit.committer.date, p0: ps[0] || '', p1: ps[1] || ps[0] || '' } });\n}\nreturn out;"
      }
    },
    {
      "id": "e29a943a-e4ff-44ff-8f74-812efdef667f",
      "name": "Compare",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/compare/{{ $json.p0 }}...{{ $json.p1 }}",
