      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// EDIT ME: repo + merge commit shas (one per PR)\nconst repo = 'QR-CODE-App/vinchecker-frontend';\nconst merges = ['7039b1b36','b5400ce8c','2fd074266','ab409346e','df79c7e2b','839535d7e','2a2b1eb4b','397d893fc','5141fb961','0b8ff475a','694630eb1','85d390429'];\nreturn merges.map(function (s) { return { json: { repo: repo, merge: s } }; });"
      }
    },
    {
