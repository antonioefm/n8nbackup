    },
    {
      "id": "7d08b918-b418-4b6a-96c4-b94dddae7a12",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rq = $('Compare Reqs').all(); const cmp = $('Compare').all(); const pc = $('PR Commits').all(); const det = $input.all();\nconst enPatch = function (files) { const f = (files || []).filter(function (x) { return /locales\\/en\\.json$/.test(x.filename); })[0]; return f ? String(f.patch || '') : ''; };\nconst prs = [];\nfor (let i = 0; i < rq.length; i++) {\n  const m = rq[i].json; const b = (cmp[i] && cmp[i].json.body) || {};\n  const pr = (m.message.match(/pull request #(\\d+) from ([^\\s]+)/) || []);\n  prs.push({ merge: m.merge, pr: pr[1] || null, branch: pr[2] || null, date: m.date, message: m.message, compare_status: cmp[i] && cmp[i].json.statusCode, files: (b.files || []).map(function (f) { return f.filename; }), en_patch: enPatch(b.files), commits: [] });\n}\nfor (let i = 0; i < pc.length; i++) {\n  const c = pc[i].json; const d = (det[i] && det[i].json.body) || {};\n  const p = prs.filter(function (x) { return x.merge === c.merge; })[0];\n  if (p) { p.commits.push({ sha: c.sha.slice(0, 9), date: c.date, message: c.message, files: (d.files || []).map(function (f) { return f.filename; }), en_patch: enPatch(d.files) }); }\n}\nreturn [{ json: { prs: prs } }];"
      }
    }
