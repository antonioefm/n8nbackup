        }
      }
    },
    {
      "id": "482f32a5-8144-4e3c-a064-0e91364a26ab",
      "name": "Flatten Projects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  for (const p of ((it.json || {}).projects || [])) {\n    out.push({ json: { project_id: p.project_id, project_name: p.name, keys: (p.statistics && p.statistics.keys_total) || 0 } });\n  }\n}\nreturn out;\n"
      }
    },
    {
      "id": "44758857-18e9-48e6-91fa-749bd837ec06",
      "name": "Fetch Webhooks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/webhooks?limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 250
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "07ae0b5e-8324-4517-bb1a-4346873aec7e",
      "name": "Report Coverage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NEEDLE = 'lokalise-to-review';\nconst meta = $('Flatten Projects').all();\nconst rows = $input.all();\nconst withHook = [];\nconst without = [];\nconst failed = [];\nfor (let i = 0; i < rows.length; i++) {\n  const pi = rows[i].pairedItem;\n  let idx = i;\n  if (pi && typeof pi === 'object' && typeof pi.item === 'number') { idx = pi.item; }\n  else if (typeof pi === 'number') { idx = pi; }\n  const m = (meta[idx] || meta[i] || {}).json || {};\n  const r = rows[i].json || {};\n  if (r.statusCode !== 200) { failed.push(m.project_name + ' -> ' + r.statusCode); continue; }\n  const hooks = (r.body && r.body.webhooks) ? r.body.webhooks : [];\n  let found = null;\n  for (const h of hooks) {\n    if (String(h.url || '').indexOf(NEEDLE) !== -1) { found = h; }\n  }\n  if (found) {\n    withHook.push(m.project_name + ' (' + m.keys + ' keys) events=[' + (found.events || []).join(',') + ']');\n  } else {\n    without.push(m.project_name + ' (' + m.keys + ' keys)' + (hooks.length ? ' [has ' + hooks.length + ' other hook(s)]' : ''));\n  }\n}\nwithHook.sort();\nwithout.sort();\nreturn [{ json: { projects_total: meta.length, registered: withHook.length, not_registered: without.length, failures: failed, with_webhook: withHook, without_webhook: without } }];\n"
      }
    }
  ],
