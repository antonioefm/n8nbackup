  "isArchived": false,
  "versionId": "b6b04984-3386-4aaa-9df0-3d0f79dc3aee",
  "versionCounter": 20,
  "sourceWorkflowId": null,
  "triggerCount": 0,
  "nodes": [
    {
      "id": "ffa544c4-0758-43c2-8166-576ecd304434",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "d53025e6-2cb9-4153-b863-3d7430f54859",
      "name": "Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// AICHAT-1694: Jira attachment 75634 (Levko, local validation of the pricing cards, 6 Nov) -> Lokalise screenshot on the 3 keys\nconst project_id = '691331356a3b9a68428ab3.43540470';\nconst only = [];\nconst shots = [\n  { url: 'https://futuremedia.atlassian.net/rest/api/3/attachment/content/75634', title: 'AICHAT-1694 – Pricing cards, A/B/C pricing test (local, 6 Nov)', description: 'Pricing cards on /pricing with the new plan names and the recurring-payment line for quarterly / 6-month plans. Dev screenshot from Jira AICHAT-1694 (local validation, 6 Nov 2026).', key_ids: [974945012, 974945013, 974945014], tags: ['AICHAT-1694'] }\n];\nconst rows = only.length ? shots.filter(function (s, i) { return only.indexOf(i) >= 0; }) : shots;\nreturn rows.map(function (s) { return { json: Object.assign({ project_id: project_id }, s) }; });"
      }
    },
    {
      "id": "b5044c8d-5064-4afd-b738-4bf4195a3c24",
      "name": "Get Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi"
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "QJte7dJbX10mIzJI",
          "name": "Jira SW Cloud account"
        }
      }
    },
    {
      "id": "0d9f9a06-65f7-4b3e-9a0a-bba6f2d878f5",
      "name": "To Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const P = $('Params').all(); const items = $input.all(); const out = [];\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const p = P[i].json;\n  out.push({ json: { project_id: p.project_id, title: p.title, bytes: buf.length, body: { screenshots: [{ data: 'data:image/png;base64,' + buf.toString('base64'), title: p.title, description: p.description, ocr: false, key_ids: p.key_ids, tags: p.tags || [] }] } } });\n}\nreturn out;"
      }
    },
    {
      "id": "23a97306-1092-4d66-ba66-55f382b28f2c",
      "name": "POST Screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/screenshots",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "onError": "continueRegularOutput",
      "disabled": true
    },
    {
      "id": "88a3899a-af77-44d3-970b-fb505e47bef1",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const T = $('To Body').all(); const res = $input.all(); const out = [];\nfor (let i = 0; i < res.length; i++) {\n  const r = res[i].json; const b = r.body || {}; const s = (b.screenshots || [])[0] || {};\n  out.push({ title: T[i] && T[i].json.title, bytes: T[i] && T[i].json.bytes, http: r.statusCode, screenshot_id: s.screenshot_id, key_ids: s.key_ids, w: s.width, h: s.height, errors: b.errors || b.error || null });\n}\nreturn [{ json: { results: out } }];"
      }
    }
  ],
