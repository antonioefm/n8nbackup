{
  "id": "tYNeckdVNJFvV7hs",
  "name": "VIN screenshots from Figma (WRITES to Lokalise)",
  "description": "WRITES to Lokalise: fetches Figma screenshot URLs and uploads them as Lokalise screenshots attached to given keys.",
  "active": false,
  "activeVersionId": null,
  "createdAt": "2026-10-29T11:24:37.483Z",
