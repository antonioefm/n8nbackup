      ],
      "parameters": {
        "jsCode": "const L = $('Glossary Languages').first().json;\nconst lb = L.body || L;\nconst langMap = {}; for (const l of (lb.languages || [])) langMap[l.lang_id] = l.lang_iso;\nconst pages = $input.all(); const out = []; const pageInfo = [];\nfor (const p of pages) {\n  const r = p.json || {}; const b = r.body || r; const h = r.headers || {};\n  pageInfo.push({ status: r.statusCode, n: Array.isArray(b.data) ? b.data.length : null, meta: b.meta || null, next: h['x-pagination-next-cursor'] || null, total: h['x-pagination-total-count'] || null });\n  for (const t of (b.data || [])) {\n    const tr = {};\n    for (const x of (t.translations || [])) { const iso = langMap[x.langId]; if (iso) tr[iso] = { t: x.translation, d: x.description || '' }; }\n    out.push({ term: t.term, description: t.description || '', casesensitive: !!t.caseSensitive, translatable: !!t.translatable, forbidden: !!t.forbidden, tags: t.tags || [], tr });\n  }\n}\nreturn [{ json: { langMap, pageInfo, count: out.length, terms: out } }];"
      }
    }
