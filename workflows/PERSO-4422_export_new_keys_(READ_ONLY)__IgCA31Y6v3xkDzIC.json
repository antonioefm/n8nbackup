      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PERSO-4422 new keys: ids 959968986..959969984. LIDS = en + languages to export.\nconst LIDS = '640,1056,734,673,708,748,770,10153,10152';\nconst out = []; let cur = [];\nfor (let i = 959968986; i <= 959969984; i++) { cur.push(i); if (cur.length === 300) { out.push({ json: { ids: cur.join(','), lids: LIDS } }); cur = []; } }\nif (cur.length) { out.push({ json: { ids: cur.join(','), lids: LIDS } }); }\nreturn out;"
      }
    },
