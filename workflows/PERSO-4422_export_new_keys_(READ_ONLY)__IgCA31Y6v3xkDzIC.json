      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = []; const st = [];\nfor (const it of $input.all()) { st.push(it.json.statusCode); for (const k of ((it.json.body || {}).keys || [])) { if (k.is_archived) { continue; } const r = { id: k.key_id, k: (typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other) : k.key_name }; for (const t of (k.translations || [])) { r[t.language_iso] = typeof t.translation === 'string' ? t.translation : JSON.stringify(t.translation || ''); } rows.push(r); } }\nreturn [{ json: { statuses: st, n: rows.length, rows: rows } }];"
      }
    }
