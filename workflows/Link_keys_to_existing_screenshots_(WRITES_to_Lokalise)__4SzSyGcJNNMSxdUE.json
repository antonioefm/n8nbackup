      "parameters": {}
    },
    {
      "id": "03d09626-04fe-4c90-9501-f67e079818ec",
      "name": "Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// EDIT ME. links: [{ screenshot_id, add: [key ids] }]; only: [] = all, [index] = test one\nconst project_id = '2944050668d5010cbd95e8.36175908';\nconst only = [1,2,3];\nconst range = function (a, b) { const r = []; for (let i = a; i <= b; i++) { r.push(i); } return r; };\nconst links = [\n  { screenshot_id: 6933266, add: [967641274, 967641275, 967641276] },\n  { screenshot_id: 7098874, add: [965839968] },\n  { screenshot_id: 7098875, add: [967230264, 967230265, 967230266, 967230267, 967230268] },\n  { screenshot_id: 6933273, add: range(965839925, 965839967).concat(range(967230242, 967230254)) }\n];\nconst rows = only.length ? links.filter(function (s, i) { return only.indexOf(i) >= 0; }) : links;\nreturn rows.map(function (s) { return { json: { project_id: project_id, screenshot_id: s.screenshot_id, add: s.add } }; });"
      }
    },
    {
      "id": "57ffd808-90a5-4d3b-aa0e-c1c799d28189",
      "name": "Get Screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/screenshots/{{ $json.screenshot_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          },
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "VW7WtJP8PzJMR813",
          "name": "Lokalise read-only"
        }
      }
    },
    {
      "id": "5107c7e3-9608-4b8c-8168-ed6a3e85050b",
      "name": "Merge Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const P = $('Params').all(); const res = $input.all(); const out = [];\nfor (let i = 0; i < res.length; i++) {\n  const p = P[i].json; const s = (res[i].json.body && res[i].json.body.screenshot) || {};\n  const cur = (s.key_ids || []).slice(); const added = [];\n  for (const k of p.add) { if (cur.indexOf(k) < 0) { cur.push(k); added.push(k); } }\n  out.push({ json: { project_id: p.project_id, screenshot_id: p.screenshot_id, title: s.title, before: (s.key_ids || []).length, added: added, body: { key_ids: cur } } });\n}\nreturn out;"
      }
    },
    {
      "id": "a9cfc409-b0f0-40e6-8af0-f3d055e84a14",
      "name": "PUT Screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "PUT",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/screenshots/{{ $json.screenshot_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "onError": "continueRegularOutput",
      "disabled": true
    },
    {
      "id": "982563fe-8598-47fc-b4d6-da486b2d36e5",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const M = $('Merge Keys').all(); const res = $input.all(); const out = [];\nfor (let i = 0; i < res.length; i++) {\n  const r = res[i].json; const s = (r.body && r.body.screenshot) || {}; const m = M[i].json;\n  const missing = m.body.key_ids.filter(function (k) { return (s.key_ids || []).indexOf(k) < 0; });\n  out.push({ screenshot_id: m.screenshot_id, title: m.title, http: r.statusCode, before: m.before, added: m.added.length, after: (s.key_ids || []).length, missing: missing, error: r.body && (r.body.error || r.body.errors) || null });\n}\nreturn [{ json: { results: out } }];"
      }
    }
  ],
