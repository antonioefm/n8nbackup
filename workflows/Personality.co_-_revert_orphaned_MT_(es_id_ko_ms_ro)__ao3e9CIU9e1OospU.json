      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const BASE = \"https://api.lokalise.com/api2\";\nconst PID = \"31393214664f295f94dd86.76792605\";\nconst IDS = \"866733809,866733810,866733811,866733812,866733814,866733815,866733817,866733818,866733820,866733821,866733823,866733824,866733826,866733827,866733829,866733830,866733832,866733833,866733835,866733836,866733838,866733839,866733841,866733842,866733844\";\nconst LANGS = [{iso:\"es\",id:1056},{iso:\"id\",id:757},{iso:\"ko\",id:733},{iso:\"ms\",id:749},{iso:\"ro\",id:770}];\nreturn LANGS.map(L => ({ json: { iso: L.iso, pid: PID,\n  url: BASE + \"/projects/\" + PID + \"/keys?limit=100&page=1&include_translations=1&filter_key_ids=\" + IDS + \"&filter_translation_lang_ids=640,\" + L.id } }));"
      }
    },
    {
      "id": "95cd35b0-d42c-46c9-8467-61b1cb7a68b3",
      "name": "Fetch current",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1200
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
