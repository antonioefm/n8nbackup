      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "0a272890-fa75-4585-8bd3-a24b8e58b378",
      "name": "Snapshot and build revert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const MT = 29251;\nconst items = $input.all();\nconst plans = $('Plan').all().map(p => p.json);\nconst snapshot = [];\nconst keysPayload = [];\nfor (let i = 0; i < items.length; i++) {\n  const r = items[i].json || {};\n  const b = r.body !== undefined ? r.body : r;\n  const P = plans[i];\n  if (!P || !Array.isArray(b.keys)) continue;\n  for (const k of b.keys) {\n    for (const t of (k.translations || [])) {\n      if (t.language_iso !== P.iso) continue;\n      const st = (t.custom_translation_statuses || []).map(s => s.status_id);\n      if (!t.translation || !String(t.translation).trim()) continue;\n      if (st.indexOf(MT) === -1) continue;\n      snapshot.push({ key_id: k.key_id, key_name: (k.key_name && k.key_name.web) || '',\n        language_iso: P.iso, translation_id: t.translation_id,\n        previous_translation: t.translation,\n        previous_is_reviewed: t.is_reviewed, previous_is_fuzzy: t.is_fuzzy,\n        previous_custom_translation_status_ids: st });\n      keysPayload.push({ key_id: k.key_id, translations: [{ language_iso: P.iso,\n        translation: '', is_reviewed: false, is_fuzzy: false, custom_translation_status_ids: [] }] });\n    }\n  }\n}\nreturn [{ json: {\n  to_revert: snapshot.length,\n  snapshot: snapshot,\n  url: 'https://api.lokalise.com/api2/projects/' + '31393214664f295f94dd86.76792605' + '/keys',\n  payload: { keys: keysPayload }\n} }];"
      }
    },
    {
      "id": "66337e8a-8fcb-41d5-9509-d32ce39a0c91",
      "name": "Revert Lokalise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
