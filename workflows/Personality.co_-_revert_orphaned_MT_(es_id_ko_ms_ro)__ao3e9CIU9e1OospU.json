              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "fa9c5911-23fb-439c-8094-517fe6793f70",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json || {};\nconst b = r.body !== undefined ? r.body : r;\nconst s = $('Snapshot and build revert').first().json;\nconst keys = Array.isArray(b.keys) ? b.keys : [];\nconst OUT = { es: 1, id: 1, ko: 1, ms: 1, ro: 1 };\nlet stillFilled = 0, cleared = 0;\nfor (const k of keys) {\n  for (const t of (k.translations || [])) {\n    if (!OUT[t.language_iso]) continue;\n    if (t.translation && String(t.translation).trim()) stillFilled++; else cleared++;\n  }\n}\nreturn [{ json: {\n  requested_revert: s.to_revert,\n  lokaliseStatus: r.statusCode,\n  keys_returned: keys.length,\n  cleared_confirmed: cleared,\n  still_filled: stillFilled,\n  errors: Array.isArray(b.errors) ? b.errors : [],\n  rawError: keys.length ? null : JSON.stringify(b).slice(0, 400),\n  snapshot: s.snapshot\n} }];"
      }
    }
  ],
