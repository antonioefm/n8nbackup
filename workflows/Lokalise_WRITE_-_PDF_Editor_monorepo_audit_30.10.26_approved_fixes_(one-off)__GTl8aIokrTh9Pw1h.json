      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prep = $('Write Prep').all();\nconst res = $input.all();\nconst out = [];\nconst N = s => String(s).normalize('NFC');\nfor (let i = 0; i < res.length; i++) {\n  const p = prep[i].json; const k = (res[i].json.body && res[i].json.body.key) || res[i].json.key || {};\n  const tr = (k.translations || []).find(t => t.language_iso === p.lang);\n  if (!tr) continue;\n  if (N(tr.translation) !== N(p.old)) continue;\n  out.push({ json: { translation_id: tr.translation_id, key: p.key, lang: p.lang, new: N(p.new) } });\n}\nreturn out;"
      }
    },
