        "jsCode": "const out = [];\nconst items = $input.all();\nconst plan = $('Plan').all();\nfor (let i = 0; i < items.length; i++) {\n  const p = plan[i].json;\n  let data = null; let err = null;\n  try { const buf = await this.helpers.getBinaryDataBuffer(i, 'data'); data = 'data:image/png;base64,' + buf.toString('base64'); } catch (e) { err = String(e); }\n  out.push({ json: { title: p.title, n: p.key_ids.length, err: err, body: { screenshots: [{ data: data, title: p.title, description: 'Figma: RealChecker / Ready for Dev', key_ids: p.key_ids, ocr: false, tags: ['061026'] }] } } });\n}\nreturn out;\n"
