    {
      "id": "a84b0d9f-858a-40b8-960c-7006a7dea8b3",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const res = { rows: [], errors: [], seen: 0 };\nconst str = v => (v && typeof v === 'object') ? JSON.stringify(v) : (v == null ? '' : String(v));\nconst RX = /\\bphones?\\b/i;\nfor (const it of $input.all()) {\n  const b = it.json.body || {};\n  if (!Array.isArray(b.keys)) { res.errors.push({ status: it.json.statusCode, body: JSON.stringify(b).slice(0, 300) }); continue; }\n  res.seen += b.keys.length;\n  for (const k of b.keys) {\n    const tr = k.translations || [];\n    const en = tr.find(t => t.language_iso === 'en');\n    const enTxt = en ? str(en.translation) : '';\n    if (!RX.test(enTxt)) continue;\n    const fil = tr.find(t => t.language_iso === 'fil');\n    const hu = tr.find(t => t.language_iso === 'hu');\n    res.rows.push({ p: b.project_id, k: (k.key_name || {}).web || '', en: enTxt, fil: fil ? str(fil.translation) : '', fil_by: fil ? (fil.modified_by_email || '') : '', hu: hu ? str(hu.translation) : '' });\n  }\n}\nreturn [{ json: res }];"
      }
    }
