        "jsCode": "// READ ONLY. GET urls only.\nconst B = 'https://api.lokalise.com/api2/projects/';\nconst q = 'include_translations=1&disable_references=1&filter_archived=exclude&limit=500&pagination=cursor';\nreturn [\n  { json: { label: 'qrc', url: B + '491848986923fad6dc2f85.42477363/keys?' + q } },\n  { json: { label: 'mqr', url: B + '60625870676151e1da46d0.81913446/keys?' + q } }\n];"
