      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uk = $('UK Commit').first().json.body || {};\nconst ukLines = [];\nfor (const f of (uk.files || [])) {\n  if (f.filename.indexOf('en.json') < 0 && f.filename.indexOf('HomePage') < 0 && f.filename.indexOf('nstruction') < 0) { continue; }\n  const ls = (f.patch || '').split('\\n');\n  for (let i = 0; i < ls.length; i++) { if (/subtitle|instruction|rotate|\"sign\"/i.test(ls[i])) { ukLines.push(f.filename + ' | ' + ls.slice(Math.max(0, i - 4), i + 2).join(' ⏎ ')); } }\n}\nconst b = $input.first().json.body || {};\nlet txt = '';\ntry { txt = Buffer.from(b.content || '', b.encoding || 'base64').toString('utf8'); } catch (e) { txt = 'decode error'; }\nlet hp = null;\ntry { const j = JSON.parse(txt); hp = j.HomePage && j.HomePage.instruction ? j.HomePage.instruction : (j.HomePage ? Object.keys(j.HomePage) : 'no HomePage'); } catch (e) { hp = 'parse error ' + String(e).slice(0, 80); }\nconst refs = [];\nconst idx = txt.indexOf('\"instruction\"');\nreturn [{ json: { uk_commit_status: $('UK Commit').first().json.statusCode, uk_en_files: (uk.files || []).filter(function (f) { return /en\\.json|HomePage|nstruction/i.test(f.filename); }).map(function (f) { return f.filename; }), uk_lines: ukLines.slice(0, 40), en_status: $input.first().json.statusCode, homepage_instruction: hp, raw_snippet: idx >= 0 ? txt.slice(idx, idx + 1500) : 'no instruction key' } }];"
      }
    }
