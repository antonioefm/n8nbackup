      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const hits = [];\nfor (const it of $input.all()) { const b = it.json.body || {}; if (!Array.isArray(b.keys)) continue;\n  for (const k of b.keys) { if (k.is_archived) continue;\n    const name = typeof k.key_name === 'object' ? (k.key_name.web || k.key_name.other || Object.values(k.key_name)[0]) : k.key_name;\n    const tr = k.translations || []; const en = tr.find(t => t.language_iso === 'en'); const es = tr.find(t => t.language_iso === 'es');\n    const ens = en ? (typeof en.translation === 'string' ? en.translation : JSON.stringify(en.translation)) : '';\n    const ess = es ? (typeof es.translation === 'string' ? es.translation : JSON.stringify(es.translation)) : '';\n    if (/try again|retry/i.test(ens) || /int[eé]nt|vuelve a|reintent/i.test(ess)) hits.push({ k: name, en: ens.slice(0, 300), es: ess.slice(0, 300), ed: es ? es.modified_by_email : '', pl: k.is_plural ? 1 : 0, d: String(k.description || '').slice(0, 100) });\n  } }\nreturn [{ json: { nHits: hits.length, hits } }];"
      }
    }
