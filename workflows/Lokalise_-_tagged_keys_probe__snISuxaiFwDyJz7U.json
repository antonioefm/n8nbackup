    {
      "id": "80b07936-0e51-4993-9df4-ab277a079086",
      "name": "Slim Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst keys = (r.body && r.body.keys) ? r.body.keys : [];\nconst out = [];\nfor (const k of keys) {\n  let en = null; let es = null;\n  for (const t of (k.translations || [])) {\n    const iso = (t.language_iso || '').toLowerCase();\n    if (iso === 'en') { en = t.translation; }\n    if (iso === 'es') { es = t.translation; }\n  }\n  out.push({ key_id: k.key_id, key_name: k.key_name, filenames: k.filenames, description: k.description, context: k.context, tags: k.tags, is_archived: k.is_archived, is_plural: k.is_plural, screenshots: k.screenshots, en: en, es: es });\n}\nreturn [{ json: { status: r.statusCode, total: (r.headers || {})['x-pagination-total-count'], keys: out } }];\n"
      }
    }
  ],
