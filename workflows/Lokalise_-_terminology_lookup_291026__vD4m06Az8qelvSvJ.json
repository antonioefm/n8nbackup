      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = [];\nfor (const it of $input.all()) {\n  for (const k of (it.json.keys || [])) {\n    const m = {};\n    for (const t of (k.translations || [])) { m[t.language_iso] = t.translation; }\n    rows.push({ name: (k.key_name && k.key_name.web) || '', t: m });\n  }\n}\nreturn [{ json: { rows: rows } }];\n"
      }
