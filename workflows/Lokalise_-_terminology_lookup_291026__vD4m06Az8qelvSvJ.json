    {
      "id": "d3e48c67-bd54-4e5c-a18d-ed5ffff0de65",
      "name": "Pick Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TERMS = ['ebook','bipolar','borderline','narciss','psychopath','sociopath','ocd','obsessive','autism','depression','anxiety','neurodiver','archetype','big 5','big five','occupation','political','self-reflection','medical diagnosis','up next','all tests','keep exploring','welcome','iq','minutes','min','discover your','your career','about yourself','completed','show more','refresh the page'];\nconst per = {};\nconst ids = [];\nconst seen = {};\nfor (const it of $input.all()) {\n  for (const k of (it.json.keys || [])) {\n    if (k.is_archived) { continue; }\n    if ((k.tags || []).indexOf('291026') >= 0) { continue; }\n    const tr = (k.translations || [])[0];\n    if (!tr) { continue; }\n    const en = String(tr.translation || '');\n    if (!en || en.length > 70) { continue; }\n    const low = en.toLowerCase();\n    for (const t of TERMS) {\n      const hit = (t === 'iq' || t === 'min') ? new RegExp('\\\\b' + t + '\\\\b').test(low) : low.indexOf(t) >= 0;\n      if (!hit) { continue; }\n      per[t] = per[t] || 0;\n      if (per[t] >= 6) { continue; }\n      per[t]++;\n      if (!seen[k.key_id]) { seen[k.key_id] = 1; ids.push(k.key_id); }\n    }\n  }\n}\nconst out = [];\nfor (let i = 0; i < ids.length; i += 100) { out.push({ json: { ids: ids.slice(i, i + 100).join(',') } }); }\nreturn out;\n"
      }
    },
