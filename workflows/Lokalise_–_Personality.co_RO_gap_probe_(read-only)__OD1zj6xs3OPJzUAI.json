      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst meta = $('Pick RO').first().json;\nconst all = $('Count All Keys').first().json;\nconst unt = $('Count Untranslated RO').first().json;\nfunction total(r) {\n  const h = r.headers || {};\n  return Number(h['x-pagination-total-count'] ?? h['X-Pagination-Total-Count'] ?? -1);\n}\nfunction okKeys(r) {\n  const b = r.body || {};\n  return Array.isArray(b.keys);\n}\nreturn [{ json: {\n  ...meta,\n  all_keys_call_ok: okKeys(all),\n  total_keys: total(all),\n  untranslated_call_ok: okKeys(unt),\n  ro_untranslated: total(unt),\n  ro_translated: total(all) - total(unt)\n} }];\n"
      }
