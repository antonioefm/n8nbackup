      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst body = $input.first().json;\nconst langs = body.languages;\nif (!Array.isArray(langs)) {\n  throw new Error('No languages array in response: ' + JSON.stringify(body).slice(0,500));\n}\nconst ro = langs.find(l => l.lang_iso === 'ro');\nconst en = langs.find(l => l.lang_iso === 'en');\nreturn [{ json: {\n  project_id: '31393214664f295f94dd86.76792605',\n  ro_found: !!ro,\n  ro_id: ro ? ro.lang_id : null,\n  ro_iso: ro ? ro.lang_iso : null,\n  en_id: en ? en.lang_id : null,\n  all_langs: langs.map(l => l.lang_iso + ':' + l.lang_id).sort().join(', '),\n  lang_count: langs.length\n} }];\n"
      }
    },
