      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src = $('Attachments').all(); const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  let b64 = null; let mime = null; let err = null;\n  try { const buf = await this.helpers.getBinaryDataBuffer(i, 'data'); b64 = buf.toString('base64'); mime = items[i].binary && items[i].binary.data && items[i].binary.data.mimeType; } catch (e) { err = String(e.message || e); }\n  out.push({ json: { id: src[i].json.id, mime: mime, err: err, b64: b64 } });\n}\nreturn out;"
      }
    }
