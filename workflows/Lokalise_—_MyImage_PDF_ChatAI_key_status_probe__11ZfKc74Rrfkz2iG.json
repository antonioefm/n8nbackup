    {
      "id": "809f6a5d-e98b-45d3-8544-90119e79896d",
      "name": "Pick Projects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst body = $input.first().json;\nconst projects = body.projects;\nif (!Array.isArray(projects)) {\n  throw new Error('No projects array in response: ' + JSON.stringify(body).slice(0, 400));\n}\nconst rx = /personality/i;\nconst out = [];\nfor (const p of projects) {\n  const name = p.name || '';\n  if (!rx.test(name)) continue;\n  const stats = p.statistics || {};\n  const langs = (stats.languages || []).map(l => ({ iso: l.language_iso, id: l.language_id }));\n  out.push({ json: {\n    project_id: p.project_id,\n    name,\n    keys_total: stats.keys_total,\n    base_words: stats.base_words,\n    langs\n  }});\n}\nout.sort((a, b) => a.json.name.localeCompare(b.json.name));\nreturn out;\n"
      }
    },
    {
      "id": "1503bdf8-6f0f-41b3-8ae1-b0eeeb8dcba6",
      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\nconst total_keys = rows.reduce((a, r) => a + (r.keys_total || 0), 0);\nreturn [{ json: {\n  projects: rows.length,\n  total_keys,\n  estimated_translation_records: rows.reduce((a, r) => a + (r.keys_total || 0) * (r.langs ? r.langs.length : 0), 0),\n  detail: rows\n}}];\n"
      }
    },
    {
      "id": "b6af2cc5-9fc6-492b-8208-51c61db998b9",
      "name": "Get Custom Statuses",
      "type": "n8n-nodes-base.httpRequest",
