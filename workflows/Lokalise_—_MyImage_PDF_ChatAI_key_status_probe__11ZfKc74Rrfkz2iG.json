        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/custom_translation_statuses?limit=100",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
