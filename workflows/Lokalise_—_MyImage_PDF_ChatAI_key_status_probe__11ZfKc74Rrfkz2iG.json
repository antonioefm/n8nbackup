    },
    {
      "id": "8ad611d5-9d21-4e27-9d20-ad72e4a5197b",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        272
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst src = $('Per Project').first().json;\nconst resp = $input.first().json || {};\nconst statuses = Array.isArray(resp.custom_translation_statuses)\n  ? resp.custom_translation_statuses.map(s => ({ id: s.status_id, title: s.title, color: s.color }))\n  : { error: resp.error || resp.message || 'no statuses array' };\nreturn [{ json: {\n  project_id: src.project_id,\n  name: src.name,\n  keys_total: src.keys_total,\n  langs: src.langs,\n  statuses\n}}];\n"
      }
    },
