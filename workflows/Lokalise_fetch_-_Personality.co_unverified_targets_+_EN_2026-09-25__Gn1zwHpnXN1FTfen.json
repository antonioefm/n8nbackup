      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const want=$('Mode').first().json.isos;const L={da:767,nl:737,et:10154,fr:673,de:666,id:757,it:734,ko:733,lv:10153,lt:10152,ms:749,no:760,pl:748,pt:708,ro:770,es:1056,sv:754,th:753};return Object.entries(L).filter(([iso])=>want.includes(iso)).map(([iso,id])=>({json:{iso,url:'https://api.lokalise.com/api2/projects/31393214664f295f94dd86.76792605/translations?limit=5000&pagination=cursor&disable_references=1&filter_lang_id='+id+'&filter_unverified=0'}}));"
