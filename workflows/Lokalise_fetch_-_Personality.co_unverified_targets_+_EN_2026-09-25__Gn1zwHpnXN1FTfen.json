      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out={};const errs=[];for(const it of $input.all()){const b=it.json.body||{};if(!Array.isArray(b.translations)){errs.push(JSON.stringify(b).slice(0,200));continue;}for(const t of b.translations){const iso=t.language_iso;(out[iso]=out[iso]||[]);let x=t.translation;if(x&&typeof x==='object')x=JSON.stringify(x);out[iso].push([t.key_id,x||'',t.modified_at,t.modified_by_email||'',(t.custom_translation_statuses||[]).map(s=>s.status_id).join(','),t.is_reviewed?1:0,t.is_unverified?1:0]);}}const counts={};for(const k in out)counts[k]=out[k].length;return Object.keys(out).map(iso=>({json:{iso,n:out[iso].length,rows:out[iso]}})).concat([{json:{iso:'_meta',counts,errs}}]);"
      }
    },
