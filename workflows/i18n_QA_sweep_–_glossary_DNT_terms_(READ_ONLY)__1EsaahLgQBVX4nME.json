      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pages = ['Glossary Page 1','Glossary Page 2','Glossary Page 3'];\nconst seen = new Set(); const all = []; const meta = [];\nlet prevNext = 'x';\nfor (const p of pages) {\n  if (!prevNext) break;\n  let j; try { j = $(p).first().json; } catch (e) { continue; }\n  const b = j.body || {};\n  const data = b.data || b.glossary_terms || b.terms || [];\n  prevNext = (j.headers || {})['x-pagination-next-cursor'] || '';\n  meta.push({ page: p, status: j.statusCode, count: data.length, next: prevNext });\n  for (const t of data) { const id = t.id || t.term_id || t.term; if (seen.has(id)) continue; seen.add(id); all.push(t); }\n}\nconst dnt = all.filter(t => t.translatable === false).map(t => t.term);\nconst terms = all.map(t => ({ term: t.term, d: t.description || '', cs: !!t.caseSensitive, tr: t.translatable !== false, fb: !!t.forbidden, tags: t.tags || [], x: (t.translations || []).filter(x => x.translation || x.description).map(x => [x.langId, x.langName || '', x.translation || '', x.description || '']) }));\nreturn [{ json: { total_terms: all.length, dnt_count: dnt.length, complete: !prevNext, meta, dnt, terms } }];"
      }
    }
