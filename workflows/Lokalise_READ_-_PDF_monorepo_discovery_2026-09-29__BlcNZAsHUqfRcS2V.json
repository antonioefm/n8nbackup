        "jsCode": "const b = $input.first().json; const ps = Array.isArray(b.projects) ? b.projects : [];\nconst all = ps.map(p => ({ id: p.project_id, name: p.name, base: p.base_language_iso, keys: p.statistics ? p.statistics.keys_total : null, langs: (p.statistics && p.statistics.languages ? p.statistics.languages.map(l => l.language_iso + ':' + l.progress) : []) }));\nconst pdf = all.filter(p => /pdf|mono/i.test(p.name));\nreturn [{ json: { total: all.length, pdf, names: all.map(p => p.name + ' | ' + p.id) } }];"
