        "jsCode": "const reqs=$('Projects').all();const res=$input.all();const out=[];for(let i=0;i<res.length;i++){const r=res[i].json||{};const b=r.body||{};const list=b.data||b.glossary_terms||b.terms||[];out.push({json:{project:reqs[i].json.project_name,status:r.statusCode,next_cursor:(r.headers||{})['x-pagination-next-cursor']||null,count:list.length,keys:Object.keys(b),terms:list.map(t=>({term:t.term,description:t.description,caseSensitive:t.caseSensitive,translatable:t.translatable,forbidden:t.forbidden,tags:t.tags}))}});}return out;"
