    {
      "id": "1da2f077-a709-46f0-a4a2-7724653012d7",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out={errors:[],languages:{},terms:[],project:null,keys_seen:0,archived:0,keys:[]};\nfor(const it of $input.all()){const b=it.json.body||{};\n if(Array.isArray(b.languages)){for(const l of b.languages)out.languages[l.lang_id]=l.lang_iso;continue;}\n if(Array.isArray(b.data)){for(const g of b.data)out.terms.push({term:g.term,desc:String(g.description||'').slice(0,200),tr:g.translatable,fb:g.forbidden,cs:g.caseSensitive,tags:g.tags,t:(g.translations||[]).map(t=>[t.langId,t.translation])});continue;}\n if(Array.isArray(b.keys)){for(const k of b.keys){out.keys_seen++;if(k.is_archived){out.archived++;continue;}const kn=k.key_name||{};const name=kn.web||kn.other||Object.values(kn)[0]||'';const tr=(k.translations||[]).find(t=>t.language_iso==='en'||t.language_id===640);let en=tr?tr.translation:'';if(typeof en!=='string')en=JSON.stringify(en);out.keys.push({k:name,en:en,d:String(k.description||'').slice(0,200),tg:k.tags||[],pl:!!k.is_plural});}continue;}\n if(b.project_id){out.project={id:b.project_id,name:b.name,base:b.base_language_iso,stats:b.statistics?{keys:b.statistics.keys_total}:null};continue;}\n out.errors.push({s:it.json.statusCode,b:JSON.stringify(b).slice(0,300)});}\nreturn [{json:out}];"
      }
    }
