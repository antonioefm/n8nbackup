    {
      "id": "c1aa55e3-ff81-4d28-b256-4feebed041a4",
      "name": "Lokalise Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
