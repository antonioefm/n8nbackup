        "responseMode": "onReceived",
        "options": {
          "noResponseBody": true
        }
      },
      "webhookId": "30ee3508-960b-4b6d-9a04-cae7decf0225"
    },
    {
      "id": "4a47f299-ef2d-4fbc-b026-bb1a52b16b68",
      "name": "Parse Translation Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const b = j.body || {};\n  const ev = String(b.event || '').toLowerCase();\n  if (ev.indexOf('translation') < 0) { continue; }\n  if (ev.indexOf('reviewed') >= 0 || ev.indexOf('proofread') >= 0) { continue; }\n  const proj = b.project || {};\n  const user = b.user || {};\n  let ts = parseInt(b.created_at_timestamp, 10);\n  if (!ts) { ts = Math.floor(Date.now() / 1000); }\n\n  const entries = [];\n  if (Array.isArray(b.translations)) {\n    for (const t of b.translations) {\n      entries.push({ t: t, lang: t.language || b.language || {}, key: t.key || b.key || {} });\n    }\n  } else if (b.translation) {\n    entries.push({ t: b.translation, lang: b.language || b.translation.language || {}, key: b.key || b.translation.key || {} });\n  }\n\n  for (const e of entries) {\n    const t = e.t || {};\n    const val = (t.value === undefined || t.value === null) ? '' : String(t.value);\n    const prev = (t.previous_value === undefined || t.previous_value === null) ? '' : String(t.previous_value);\n    if (val === prev) { continue; }\n    const lang = String((e.lang || {}).iso || '').toLowerCase();\n    const keyId = ((e.key || {}).id === undefined || (e.key || {}).id === null) ? '' : String(e.key.id);\n    if (!lang || !keyId) { continue; }\n    out.push({ json: {\n      event_ts: ts,\n      project_id: String(proj.id || ''),\n      project_name: String(proj.name || ''),\n      language_iso: lang,\n      key_id: keyId,\n      user_email: String(user.email || '').toLowerCase(),\n      action: String(b.action || ev)\n    }});\n  }\n}\nreturn out;\n"
      }
    },
    {
      "id": "d313138e-4a0a-4f2f-b68f-bc144c4cddc2",
      "name": "Store Event",
