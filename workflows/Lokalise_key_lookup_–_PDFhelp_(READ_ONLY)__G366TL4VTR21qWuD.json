      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst keys = (r.body && r.body.keys) ? r.body.keys : [];\nconst out = [];\nfor (const k of keys) {\n  if (k.is_archived) { continue; }\n  let en = null; const untranslated = []; const translated = [];\n  for (const t of (k.translations || [])) {\n    const iso = (t.language_iso || '').toLowerCase();\n    if (iso === 'en' || iso === 'en_us' || iso === 'en-us') { en = t.translation; continue; }\n    if (!t.translation || !String(t.translation).trim()) { untranslated.push(iso); } else { translated.push(iso); }\n  }\n  out.push({ id: k.key_id, name: k.key_name, en: en, description: k.description, tags: k.tags, filenames: k.filenames, created_at: k.created_at, modified_at: k.translations_modified_at, untranslated: untranslated, translated_count: translated.length, screenshots: (k.screenshots || []).map(function (s) { return s.url; }) });\n}\nreturn [{ json: { status: r.statusCode, total_header: (r.headers || {})['x-pagination-total-count'], returned: keys.length, archived_skipped: keys.length - out.length, keys: out } }];\n"
      }
    }
