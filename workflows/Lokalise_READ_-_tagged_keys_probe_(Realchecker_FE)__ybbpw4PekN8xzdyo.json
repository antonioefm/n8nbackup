      "id": "d1541d0f-01e2-4741-a4af-0259f7cf19c7",
      "name": "Slim Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = []; let seen = 0; const errs = [];\nfor (const it of $input.all()) {\n  const b = it.json.body || {};\n  if (it.json.statusCode && it.json.statusCode >= 400) { errs.push(it.json.statusCode + ' ' + JSON.stringify(b).slice(0,200)); }\n  for (const k of (b.keys || [])) {\n    seen++;\n    const tr = {};\n    for (const t of (k.translations || [])) { tr[t.language_iso] = { t: t.translation, by: t.modified_by_email, at: t.modified_at, rev: t.is_reviewed, unv: t.is_unverified }; }\n    out.push({ id: k.key_id, name: k.key_name && k.key_name.web ? k.key_name.web : k.key_name, desc: k.description, tags: k.tags, plural: k.is_plural, cl: k.char_limit, created: k.created_at, comments: (k.comments || []).map(function (c) { return c.comment; }), tr: tr });\n  }\n}\nreturn [{ json: { seen: seen, n: out.length, errs: errs, keys: out } }];\n"
      }
    }
  ],
