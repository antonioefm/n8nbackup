        "zendeskApi": {
          "id": "PhhvXVI6PIMK8NA1",
          "name": "BrainIQTest Zendesk account"
        }
      },
      "notes": "Sets the category field on the LOSER to Duplicate contact, before the merge closes it. onError is continueRegularOutput so a failure here never blocks the merge.",
      "onError": "continueRegularOutput"
    }
