          "combinator": "and",
          "conditions": [
            {
              "id": "dh-dup-label",
              "leftValue": "={{ !!$json.duplicate_label_body }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "notes": "True only when ticket_custom_field_category AND category_value_duplicate_contact are both configured for this brand. Otherwise merge without labelling."
    },
