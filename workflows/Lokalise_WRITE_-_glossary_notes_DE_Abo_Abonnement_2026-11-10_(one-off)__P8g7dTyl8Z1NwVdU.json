      "parameters": {
        "jsCode": "// 10.11.26 (Maria): German \"Abo\" and \"Abonnement\" are both OK -> add to the DE note of subscription + reactivate subscription.\n// Sends each term's FULL translation list back unchanged except the DE description, so no language is touched.\nconst terms = []; for (const it of $input.all()) { const b = it.json.body || {}; for (const t of (b.data || [])) terms.push(t); }\nconst NOTE = { 'subscription': '„Abo“ and „Abonnement“ are both OK; the short form suits buttons and tight spaces.', 'reactivate subscription': 'Both „Abo wieder aktivieren“ and „Abonnement reaktivieren“ are OK; „Abo“ and „Abonnement“ are both fine.' };\nconst out = []; const found = {};\nfor (const t of terms) {\n  const k = String(t.term || '').trim().toLowerCase();\n  if (!NOTE[k] || !(t.tags || []).map(x => String(x.name || x).toLowerCase()).includes('shared')) continue;\n  found[k] = t.id;\n  const tr = (t.translations || []).map(x => ({ langId: x.langId, translation: x.translation || '', description: x.description || '' }));\n  const de = tr.find(x => x.langId === 666);\n  if (!de) continue;\n  if (de.description.indexOf('both OK') !== -1 || de.description.indexOf('both fine') !== -1) continue;\n  de.description = (de.description ? de.description.replace(/\\s+$/, '') + ' ' : '') + NOTE[k];\n  out.push({ json: { label: t.term + ' (' + t.id + ')', method: 'PUT', url: 'https://api.lokalise.com/api2/projects/46552447679363c70f7ef8.58193285/glossary-terms', body: { terms: [{ id: t.id, translations: tr }] }, before_count: tr.filter(x => x.translation).length, new_de_note: de.description } });\n}\nif (!out.length) return [{ json: { none: true, found: found, terms_read: terms.length } }];\nreturn out;",
        "mode": "runOnceForAllItems"
      }
    },
