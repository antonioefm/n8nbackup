      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Params').first().json;\nconst r = $input.first().json;\nconst send = []; const skipped = [];\nfor (const k of ((r.body && r.body.keys) || [])) {\n  const d = (k.description || '').trim();\n  if (k.is_archived) { skipped.push({ key_id: k.key_id, why: 'archived' }); continue; }\n  if (d.indexOf(p.url) >= 0) { skipped.push({ key_id: k.key_id, why: 'already has link' }); continue; }\n  send.push({ key_id: k.key_id, description: (d ? d + ' ' : '') + p.note });\n}\nreturn [{ json: { body: { keys: send }, send_count: send.length, skipped: skipped, found: ((r.body && r.body.keys) || []).length } }];"
      }
    },
