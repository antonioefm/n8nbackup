    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n  const list = (item.json && Array.isArray(item.json.data)) ? item.json.data : [];\n  for (const wf of list) {\n    if (wf.isArchived === true) continue;\n    const safeName = String(wf.name || wf.id)\n      .replace(/[\\\\/:*?\"<>|]+/g, \"_\")\n      .replace(/\\s+/g, \"_\")\n      .replace(/_+/g, \"_\")\n      .replace(/^_+|_+$/g, \"\")\n      .slice(0, 100);\n    results.push({\n      json: {\n        id: wf.id,\n        name: wf.name,\n        active: wf.active === true,\n        isArchived: wf.isArchived === true,\n        filename: \"workflows/\" + safeName + \"__\" + wf.id + \".json\"\n      }\n    });\n  }\n}\nreturn results;"
      },
      "id": "e0cecff2-3aa6-46b4-b00a-c517537f17a3",
      "name": "Filter and Prep Workflows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        400
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Runs once, after the commits (or straight away when nothing changed).\nconst prepItems = $('Prepare Commit').all().map(i => i.json);\nconst stats = (prepItems[0] && prepItems[0].stats) || { listed: 0, unchanged: 0, toCommit: 0, fetchFailed: [] };\nconst toCommit = prepItems.filter(j => j.noop !== true);\nlet commits = [];\nif (toCommit.length > 0) {\n  try { commits = $('Commit to GitHub').all().map(i => i.json); } catch (e) { commits = []; }\n}\nlet committed = 0;\nlet added = 0;\nconst failures = (stats.fetchFailed || []).slice();\nfor (let i = 0; i < toCommit.length; i++) {\n  const c = commits[i] || {};\n  if (c.commit && typeof c.commit.sha === 'string') {\n    committed += 1;\n    if (toCommit[i].isNew) added += 1;\n    continue;\n  }\n  let msg = 'Unknown error';\n  if (c.error) { msg = c.error.message || JSON.stringify(c.error); }\n  else if (c.message) { msg = c.message; }\n  failures.push({ file: toCommit[i].filename, error: String(msg).slice(0, 200) });\n}\nconst ok = stats.unchanged + committed;\nconst failed = failures.length;\nconst status = failed === 0 ? 'success' : (ok === 0 ? 'failure' : 'partial');\nconst icon = status === 'success' ? ':white_check_mark:' : (status === 'partial' ? ':warning:' : ':x:');\nconst dateStr = new Date().toISOString().slice(0, 10);\nlet message = icon + ' *n8n Backup ' + dateStr + '* - ' + ok + '/' + stats.listed + ' workflows backed up to `antonioefm/n8nbackup` (' + committed + ' changed' + (added > 0 ? ', of which ' + added + ' new' : '') + ', ' + stats.unchanged + ' unchanged)';\nif (failed > 0) {\n  message += '\\n\\n*Issues (' + failed + '):*\\n';\n  for (const f of failures.slice(0, 10)) { message += '- `' + f.file + '`: ' + f.error + '\\n'; }\n  if (failed > 10) { message += '_...and ' + (failed - 10) + ' more_'; }\n}\nreturn [{ json: { status: status, listed: stats.listed, committed: committed, added: added, unchanged: stats.unchanged, failed: failed, message: message } }];"
      },
