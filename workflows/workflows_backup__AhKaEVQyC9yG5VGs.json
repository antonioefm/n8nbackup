      "id": "5f1ec9c1-8318-4cf4-84e4-2c57ac13248a",
      "name": "Fetch Workflow JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1136,
        400
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "d9womSSWKUI19oC2",
          "name": "n8n API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Compares each workflow with the copy already in the repo and keeps only new or changed files.\n// Git stores a file's blob SHA as sha1('blob <bytes>\\0<content>'), so an identical file has an identical SHA.\nconst crypto = require('crypto');\nconst blobSha = (s) => {\n  const b = Buffer.from(s, 'utf8');\n  return crypto.createHash('sha1').update(Buffer.concat([Buffer.from('blob ' + b.length + '\\0', 'utf8'), b])).digest('hex');\n};\nconst tree = $('Get repo tree').first().json;\nif (!Array.isArray(tree.tree) || tree.truncated === true) {\n  throw new Error('Could not read the full file list of the backup repo (tree missing or truncated). Nothing was committed.');\n}\nconst repo = {};\nfor (const e of tree.tree) { if (e.type === 'blob') repo[e.path] = e.sha; }\n\nconst metas = $('Filter and Prep Workflows').all();\nconst fetched = $input.all();\nconst dateStr = new Date().toISOString().slice(0, 10);\nconst out = [];\nlet unchanged = 0;\nconst fetchFailed = [];\nfor (let i = 0; i < fetched.length; i++) {\n  const p = fetched[i].pairedItem;\n  const idx = (p && typeof p.item === 'number') ? p.item : i;\n  const meta = (metas[idx] || {}).json || {};\n  const wf = fetched[i].json || {};\n  if (typeof wf.id !== 'string' || !Array.isArray(wf.nodes)) {\n    fetchFailed.push({ file: meta.filename || 'unknown', error: 'Workflow fetch failed' });\n    continue;\n  }\n  const text = JSON.stringify(wf, null, 2);\n  const existing = repo[meta.filename] || null;\n  if (existing && existing === blobSha(text)) { unchanged += 1; continue; }\n  const body = { message: 'Daily backup ' + dateStr + ' - ' + meta.name, content: Buffer.from(text, 'utf8').toString('base64'), branch: 'main' };\n  if (existing) body.sha = existing;\n  out.push({ json: { filename: meta.filename, workflowName: meta.name, workflowId: meta.id, isNew: !existing, bodyJson: JSON.stringify(body) } });\n}\nconst stats = { listed: metas.length, unchanged: unchanged, toCommit: out.length, fetchFailed: fetchFailed };\nif (out.length === 0) { return [{ json: { noop: true, stats: stats } }]; }\nfor (const o of out) { o.json.stats = stats; }\nreturn out;",
        "mode": "runOnceForAllItems"
      },
