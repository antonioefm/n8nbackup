    {
      "id": "532898f8-53ef-4864-92d7-084aeef0dcdb",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst res = $input.all();\nconst r = res[0].json || {};\nconst b = r.body || {};\nconst out = [];\nfor (const k of (b.keys || [])) {\n  const name = (k.key_name || {}).web || '';\n  const rows = [];\n  for (const t of (k.translations || [])) {\n    rows.push({ iso: t.language_iso, value: String(t.translation || '').slice(0, 80),\n      fuzzy: t.is_fuzzy, untranslated: t.is_untranslated,\n      statuses: (t.custom_translation_statuses || []).map(s => s.title || s.status_id) });\n  }\n  out.push({ key: name, is_plural: k.is_plural, rows: rows });\n}\nreturn [{ json: { status: r.statusCode, found: (b.keys || []).length, keys: out } }];\n"
      }
    }
