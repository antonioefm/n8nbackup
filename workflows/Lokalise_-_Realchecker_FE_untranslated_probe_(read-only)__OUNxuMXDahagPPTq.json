      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst B = 'https://api.lokalise.com/api2';\nconst PID = '964775386a3ce03ecca883.03770715';\nconst out = [];\nout.push({ json: { kind: 'plural_check',\n  url: B + '/projects/' + PID + '/keys?include_translations=1&limit=500&filter_keys=' +\n    encodeURIComponent('report::overview::recordFound') } });\nreturn out;\n"
      }
    },
