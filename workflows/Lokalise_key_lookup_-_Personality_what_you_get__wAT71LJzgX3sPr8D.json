        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  for (const k of (it.json.keys || [])) {\n    const name = (k.key_name && typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other || JSON.stringify(k.key_name)) : k.key_name;\n    const tr = {};\n    for (const t of (k.translations || [])) { tr[t.language_iso] = t.translation; }\n    out.push({ json: { key_id: k.key_id, key_name: name, is_archived: k.is_archived, en: tr['en'], translations: tr } });\n  }\n}\nreturn out.length ? out : [{ json: { none: true } }];\n"
