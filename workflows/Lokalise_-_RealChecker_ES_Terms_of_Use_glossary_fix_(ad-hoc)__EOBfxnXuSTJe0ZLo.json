    {
      "id": "f88adde5-216e-4157-b851-44b774afb3a2",
      "name": "Build update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const keys = ($input.first().json.keys || []);\nconst out = []; const skipped = []; const preview = [];\nfor (const k of keys) {\n  const t = (k.translations || []).find(x => x.language_iso === 'es');\n  const cur = t ? t.translation : '';\n  let nw = cur;\n  if (cur.trim() === 'Condiciones de uso') nw = 'Términos de uso';\n  nw = nw.split('nuestras <terms>Condiciones de uso</terms> y <privacy>').join('nuestros <terms>Términos de uso</terms> y nuestra <privacy>');\n  nw = nw.split('nuestras <terms>Condiciones de uso</terms>').join('nuestros <terms>Términos de uso</terms>');\n  if (nw === cur) { skipped.push({ key_id: k.key_id, why: 'nothing to change', cur }); continue; }\n  if (/Condiciones de uso/.test(nw)) { skipped.push({ key_id: k.key_id, why: 'unexpected pattern left', nw }); continue; }\n  out.push({ key_id: k.key_id, translations: [{ language_iso: 'es', translation: nw }] });\n  preview.push({ key: k.key_name && (k.key_name.web || k.key_name.other), before: cur, after: nw });\n}\nreturn [{ json: { body: { keys: out }, n: out.length, skipped, preview } }];\n"
      }
    },
