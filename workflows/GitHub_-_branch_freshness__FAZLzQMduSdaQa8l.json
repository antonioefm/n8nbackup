{
  "id": "FAZLzQMduSdaQa8l",
  "name": "GitHub - branch freshness",
  "description": "Read-only: last-commit date and sha for each repo's default branch plus develop/dev/staging/stage, to tell active dev branches from stale ones.",
  "active": false,
  "activeVersionId": null,
  "createdAt": "2026-09-14T12:09:00.548Z",
