    {
      "id": "0e43131e-ad10-46ba-a30a-a66397316d08",
      "name": "Split Tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "const list = ($input.first().json.tickets) || [];\nreturn list.map(t => ({ json: { id: t.id, created_at: t.created_at, status: t.status, subject: t.subject, requester_id: t.requester_id, assignee_id: t.assignee_id || null, channel: t.via && t.via.channel, tags: t.tags || [], description: t.description ? String(t.description).slice(0, 2000) : '' } }));\n"
      }
    },
    {
      "id": "c3b1f728-d26b-45f2-9165-64a49f8d74f6",
      "name": "Get Comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "url": "={{ \"https://\" + $('Get Project Config').first().json.zendesk_domain + \".zendesk.com/api/v2/tickets/\" + $json.id + \"/comments.json\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "zendeskApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "include_inline_images",
              "value": "false"
            },
            {
              "name": "page[size]",
              "value": "100"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 3,
              "batchInterval": 1000
            }
          }
        }
      },
      "credentials": {
        "zendeskApi": {
          "id": "z41y1j8bbsyi2W61",
          "name": "Personality Zendesk prod account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "38935db6-4053-47b5-aa5a-f74dc2a0218f",
      "name": "Build Reference Set",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const params = $('Set params').first().json;\nconst cfg = $('Get Project Config').first().json;\nconst autoId = String(cfg.automation_agent_id || '');\nconst limit = Number(params.text_limit) || 1200;\nconst tickets = $('Split Tickets').all();\nconst responses = $input.all();\nfunction clean(s, cap) {\n  if (!s) return '';\n  const c = cap || limit;\n  let t = String(s).replace(/\\r/g, '');\n  t = t.split('\\n').filter(l => !/^\\s*>/.test(l)).join(' ');\n  t = t.replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\\s+/g, ' ').trim();\n  return t.length > c ? t.slice(0, c) + '...' : t;\n}\nconst out = [];\nfor (let i = 0; i < tickets.length; i++) {\n  const t = tickets[i].json;\n  const resp = responses[i] ? responses[i].json : {};\n  const comments = (resp && resp.comments) || [];\n  const pub = comments.filter(c => c.public);\n  const cust = pub.filter(c => String(c.author_id) === String(t.requester_id));\n  const auto = autoId ? pub.filter(c => String(c.author_id) === autoId) : [];\n  const agent = pub.filter(c => String(c.author_id) !== String(t.requester_id) && (!autoId || String(c.author_id) !== autoId));\n  const notes = comments.filter(c => !c.public);\n  out.push({ id: t.id, created: t.created_at, status: t.status, channel: t.channel, subject: t.subject,\n    tags: (t.tags || []).join(','),\n    n_cust: cust.length, n_agent: agent.length, n_auto: auto.length, n_notes: notes.length,\n    first_customer_message: clean((cust[0] && cust[0].plain_body) ? cust[0].plain_body : t.description, 1500),\n    automation_reply: auto[0] ? clean(auto[0].plain_body, 400) : '',\n    agent_reply: agent[0] ? clean(agent[0].plain_body, 900) : '',\n    last_agent_reply: agent.length > 1 ? clean(agent[agent.length - 1].plain_body, 500) : '',\n    internal_notes: clean(notes.map(c => String(c.plain_body || '')).join(' || '), 800) });\n}\nreturn [{ json: { requested: (params.ticket_ids || '').split(',').length, returned: out.length, automation_agent_id: autoId, tickets: out } }];\n"
      }
    }
  ],
