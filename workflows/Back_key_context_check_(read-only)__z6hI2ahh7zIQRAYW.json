    {
      "id": "013b8d03-b151-492d-a52e-dd414ddf4a3c",
      "name": "Find Back Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nconst PROJ = {};\nfor (const it of $('Fetch Projects').all()) { for (const p of (it.json.projects || [])) { PROJ[p.project_id] = p.name; } }\nconst byProj = {};\nfor (const it of $input.all()) {\n  const b = it.json;\n  if (!b || !b.keys) { continue; }\n  const pid = b.project_id;\n  if (!byProj[pid]) { byProj[pid] = []; }\n  for (const k of b.keys) { byProj[pid].push(k); }\n}\nfunction kname(k) { const n = k.key_name || {}; return n.web || n.other || n.ios || n.android || ''; }\nfunction sepOf(n) { return n.indexOf('::') >= 0 ? '::' : '.'; }\nfunction parent(n) { const s = sepOf(n); const i = n.lastIndexOf(s); return i < 0 ? '' : n.slice(0, i); }\nfunction leaf(n) { const s = sepOf(n); const i = n.lastIndexOf(s); return i < 0 ? n : n.slice(i + s.length); }\nfunction tmap(k) {\n  const m = {};\n  for (const t of (k.translations || [])) {\n    m[t.language_iso] = { v: (typeof t.translation === 'string') ? t.translation : JSON.stringify(t.translation), id: t.translation_id, rev: t.is_reviewed, unv: t.is_unverified };\n  }\n  return m;\n}\nconst summary = [];\nfor (const pid in byProj) {\n  const keys = byProj[pid].filter(function (k) { return !k.is_archived; });\n  const byParent = {};\n  for (const k of keys) { const p = parent(kname(k)); if (!byParent[p]) { byParent[p] = []; } byParent[p].push(k); }\n  summary.push({ project: PROJ[pid], project_id: pid, keys_scanned: keys.length });\n  for (const k of keys) {\n    const n = kname(k);\n    const m = tmap(k);\n    const en = ((m.en && m.en.v) || '').trim().toLowerCase();\n    if (!(en === 'back' || /(^|[.:_])back$/i.test(n))) { continue; }\n    const sibs = (byParent[parent(n)] || []).filter(function (s) { return s.key_id !== k.key_id; }).slice(0, 25).map(function (s) { const sm = tmap(s); return leaf(kname(s)) + '=' + ((sm.en && sm.en.v) || ''); });\n    const tr = {};\n    for (const iso in m) { tr[iso] = m[iso]; }\n    out.push({ json: { project: PROJ[pid], project_id: pid, key: n, key_id: k.key_id, description: k.description || '', tags: k.tags || [], en: (m.en && m.en.v) || '', siblings: sibs, translations: tr } });\n  }\n}\nout.unshift({ json: { summary: summary } });\nreturn out;\n"
      }
    },
