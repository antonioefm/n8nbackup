                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount + 1 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.keys || $response.body.keys.length < 500 }}",
              "limitPagesFetched": true,
              "maxRequests": 40,
              "requestInterval": 300
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
