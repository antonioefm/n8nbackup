      "name": "Pick Projects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  for (const p of (it.json.projects || [])) {\n    const s = (p.name || '').toLowerCase();\n    if ((s.indexOf('mobitrace') >= 0 || s.indexOf('realcheck') >= 0) && s.indexOf('html') < 0 && s.indexOf('legal') < 0) {\n      out.push({ json: { project_id: p.project_id, project_name: p.name } });\n    }\n  }\n}\nreturn out;\n"
      }
    },
    {
      "id": "cb27168d-ca19-4caa-8b75-3071036c229a",
      "name": "Fetch Keys",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/keys?include_translations=1&limit=500",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
