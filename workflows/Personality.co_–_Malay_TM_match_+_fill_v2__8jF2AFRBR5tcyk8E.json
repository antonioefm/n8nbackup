    {
      "id": "537ce918-2e25-4ce7-906e-fddd55cdb9e5",
      "name": "Generate page list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const h = $input.first().json.headers || {};\nconst total = Number(h['x-pagination-total-count'] || 0);\nif (!total) { throw new Error('No pagination header'); }\nconst limit = 500;\nconst pages = Math.ceil(total / limit);\nconst out = [];\nconst langs = [640, 757];\nfor (const lid of langs) {\n  for (let p = 1; p <= pages; p++) { out.push({ json: { lang_id: lid, page: p, limit: limit } }); }\n}\nreturn out;"
      }
    },
    {
      "id": "8a1c5e60-af01-423d-8934-a9a9f814bb69",
      "name": "Build TM match plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pages = $input.all();\nconst en = {};\nconst tg = [];\nfor (const p of pages) {\n  const j = p.json;\n  if (!Array.isArray(j.rows)) { continue; }\n  if (j.iso === 'en') { for (const r of j.rows) { en[r[0]] = r[1]; } }\n  else { for (const r of j.rows) { tg.push({ k: r[0], text: r[1], tid: r[2] }); } }\n}\nconst byEditor = {};\nconst corpus = [];\nlet filled = 0;\nconst norm = function (s) { return String(s).replace(/\\s+/g, ' ').trim().toLowerCase(); };\nconst tm = {};\nfor (const r of tg) {\n  if (String(r.text).trim() === '') { continue; }\n  filled = filled + 1;\n  const src = en[r.k];\n  if (src === undefined || String(src).trim() === '') { continue; }\n  if (tm[norm(src)] === undefined) { tm[norm(src)] = r.text; }\n  if (corpus.length < 4000) { corpus.push([String(src), String(r.text)]); }\n}\nlet exact = 0;\nlet empties = 0;\nfor (const r of tg) {\n  if (String(r.text).trim() !== '') { continue; }\n  const src = en[r.k];\n  if (src === undefined || String(src).trim() === '') { continue; }\n  empties = empties + 1;\n  if (tm[norm(src)]) { exact = exact + 1; }\n}\nreturn [{ json: { rows: tg.length, filled: filled, empty: empties, tm_entries: Object.keys(tm).length, exact_matches: exact, corpus_size: corpus.length, corpus: corpus } }];"
      }
    },
    {
