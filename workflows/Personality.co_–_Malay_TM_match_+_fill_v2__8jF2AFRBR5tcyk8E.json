    },
    {
      "id": "f32ccb85-6bcb-4bd5-9c5b-33fa16c90eab",
      "name": "Compact page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = $input.first().json.translations;\nif (!Array.isArray(t)) { throw new Error(\"No translations array: \" + JSON.stringify($input.first().json).slice(0, 300)); }\nlet iso = \"\";\nconst rows = [];\nfor (const x of t) {\n  iso = x.language_iso;\n  const val = x.translation === null || x.translation === undefined ? \"\" : String(x.translation);\n  if (x.language_iso === \"en\") {\n    rows.push([x.key_id + \":\" + x.segment_number, val]);\n  } else {\n    rows.push([x.key_id + \":\" + x.segment_number, val, x.translation_id, x.modified_by_email || \"\", x.is_reviewed ? 1 : 0, x.is_fuzzy ? 1 : 0]);\n  }\n}\nreturn [{ json: { iso: iso, count: rows.length, rows: rows } }];"
      }
    },
