      "parameters": {
        "jsCode": "// Summary for the caller (PS prod - Refund requests flow), decision 2026-10-15.\n// This node runs at the end of each branch; n8n runs the refund branch first and\n// the cancellation branch second, so its last output is what the caller gets.\n// ok is false when the refund or the cancellation failed. Both failure paths\n// have already posted an internal note, set the ticket open, set Allow\n// automation to no and alerted Slack; the caller must not send its approval.\nfunction ran(name) {\n  try { return $(name).isExecuted; } catch (e) { return false; }\n}\nconst refundFailed = ran('Reply internally and set status to open');\nconst cancelFailed = ran('Reply internally and set status to open1');\nreturn [{ json: { ok: !refundFailed && !cancelFailed, refund_ok: !refundFailed, cancel_ok: !cancelFailed } }];\n"
      },
      "notes": "Last node: tells the caller whether the refund and the cancellation succeeded ({ ok, refund_ok, cancel_ok })."
    }
