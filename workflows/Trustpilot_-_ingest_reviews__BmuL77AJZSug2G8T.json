      "parameters": {
        "jsCode": "// Validates one page of reviews posted by the Cowork collector and turns it\n// into rows for the two data tables. Everything is checked here because the\n// payload crosses an AI agent: the key proves it came from our task, and the\n// checksum proves the agent did not alter it in transit.\nconst KEY = 'tpi_571516dd6fba9327672a3a4dfd02bd89';\nconst BRANDS = {\n  'personality.co': 'personality_prod', 'lovestyle.co': 'lovestyle_prod', 'mindspree.io': 'mindspree_prod',\n  'myimage.io': 'myimage_prod', 'resumewise.com': 'resumewise_prod', 'pdfhelp.com': 'pdfhelp_prod',\n  'unicopy.ai': 'unicopy_prod', 'realchecker.com': 'realchecker_prod', 'chatbotonline.ai': 'chatbotonline_prod',\n  'myqrcode.com': 'myqrcode_prod', 'brainiqtest.com': 'brainiqtest_prod', 'qrcreate.com': 'qrcreate_prod',\n  'vinready.com': 'vinready_prod'\n};\nconst fnv = (s) => { let h = 0x811c9dc5; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; } return h.toString(16).padStart(8, '0'); };\n\nconst now = new Date();\nconst body = ($input.first().json || {}).body || {};\nconst summary = { ok: false, received: 0, accepted: 0, rejected: 0, reasons: [] };\nconst out = [];\n\nlet p = null;\ntry { p = typeof body.data === 'string' ? JSON.parse(body.data) : null; }\ncatch (e) { summary.reasons.push('payload is not valid JSON'); }\nif (!p && !summary.reasons.length) summary.reasons.push('no payload in field \"data\"');\n\nif (p && p.key !== KEY) { summary.reasons.push('invalid key'); p = null; }\n\nif (p) {\n  // Rebuilt in a fixed key order so the hash matches the collector's exactly.\n  const core = { domain: p.domain, page: p.page, trust_score: p.trust_score, total_reviews: p.total_reviews, reviews: p.reviews };\n  if (fnv(JSON.stringify(core)) !== p.checksum) { summary.reasons.push('checksum mismatch - resend this page unchanged'); p = null; }\n}\n\nif (p) {\n  const domain = String(p.domain || '').toLowerCase().replace(/^www\\./, '');\n  const pk = BRANDS[domain];\n  if (!pk) summary.reasons.push('unknown domain ' + domain);\n  else {\n    summary.ok = true;\n    summary.domain = domain;\n    summary.page = p.page;\n    const seen = new Set();\n    for (const r of (Array.isArray(p.reviews) ? p.reviews : []).slice(0, 100)) {\n      summary.received++;\n      const id = Array.isArray(r) ? r[0] : null;\n      const rating = Array.isArray(r) ? r[1] : null;\n      const t = Array.isArray(r) ? Date.parse(r[2]) : NaN;\n      const lang = Array.isArray(r) ? r[3] : null;\n      const valid = typeof id === 'string' && /^[A-Za-z0-9]{8,64}$/.test(id) &&\n        Number.isInteger(rating) && rating >= 1 && rating <= 5 &&\n        !isNaN(t) && t <= now.getTime() + 86400000;\n      if (!valid || seen.has(id)) { summary.rejected++; continue; }\n      seen.add(id);\n      summary.accepted++;\n      out.push({ json: { kind: 'review', review_id: id, project_key: pk, domain, rating,\n        published_at: new Date(t).toISOString(), language: lang ? String(lang).slice(0, 10) : null,\n        last_seen_at: now.toISOString() } });\n    }\n    // One snapshot per brand per day, written from page 1 only, so a later\n    // page can never overwrite the TrustScore with a partial or empty read.\n    if (Number(p.page) === 1) {\n      const day = now.toISOString().slice(0, 10);\n      out.push({ json: { kind: 'snapshot', snapshot_key: pk + '|' + day, project_key: pk, domain, snapshot_date: day,\n        trust_score: typeof p.trust_score === 'number' ? p.trust_score : null,\n        total_reviews: Number.isInteger(p.total_reviews) ? p.total_reviews : null,\n        captured_at: now.toISOString() } });\n    }\n  }\n}\nreturn [{ json: { kind: 'summary', summary } }].concat(out);\n"
      },
