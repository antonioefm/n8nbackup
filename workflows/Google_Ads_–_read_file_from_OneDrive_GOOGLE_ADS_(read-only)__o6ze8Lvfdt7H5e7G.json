{
  "id": "o6ze8Lvfdt7H5e7G",
  "name": "Google Ads – read file from OneDrive GOOGLE ADS (read-only)",
  "description": "Returns one file from Maria's OneDrive under GOOGLE ADS/<path>. Read-only. Needs x-upload-key header. Used by the google-ads-localize skill.",
  "active": true,
  "activeVersionId": "60ac4580-fa30-4287-9c99-c085318a542e",
  "createdAt": "2026-11-20T10:35:40.154Z",
  "updatedAt": "2026-11-20T10:35:40.154Z",
