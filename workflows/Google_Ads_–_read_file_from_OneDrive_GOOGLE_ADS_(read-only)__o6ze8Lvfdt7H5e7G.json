  "triggerCount": 1,
  "nodes": [
    {
      "id": "ec4ce5b4-2104-4290-9b10-46dd90ee15f4",
      "name": "Request file",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "google-ads-download-5a1e8c3f9d2b4e70",
        "responseMode": "responseNode"
      },
      "webhookId": "8b68d226-94c9-422a-bb68-887b7fb70cd0"
    },
    {
      "id": "1f185464-163a-4b64-abe5-96ca8f6e8e69",
      "name": "Check key and build path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const KEY = 'gads-2b91f0c4e7a64d53a8c1';\nconst h = $json.headers || {};\nconst q = $json.query || {};\nif (h['x-upload-key'] !== KEY) throw new Error('Forbidden: wrong key');\nconst path = String(q.path || '').trim();\nif (!path || path.includes('..') || path.startsWith('/')) throw new Error('Invalid path');\nconst segs = ['GOOGLE ADS', ...path.split('/').filter(Boolean)];\nreturn { json: { url: 'https://graph.microsoft.com/v1.0/me/drive/root:/' + segs.map(encodeURIComponent).join('/') + ':/content' } };"
      }
    },
    {
      "id": "33288662-730c-4d90-837d-2c1435df3a17",
      "name": "Download from OneDrive GOOGLE ADS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOneDriveOAuth2Api",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "credentials": {
        "microsoftOneDriveOAuth2Api": {
          "id": "QCA5rX8Iyd1rbChu",
          "name": "Microsoft Drive - Maria Sica account"
        }
      }
    },
    {
      "id": "3401785e-f109-46b2-bf5f-e338267a62bd",
      "name": "Send file",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        672,
        0
      ],
      "parameters": {
        "respondWith": "binary",
        "inputDataFieldName": "data"
      }
    }
  ],
