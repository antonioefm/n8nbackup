    },
    {
      "id": "ec7aaf7b-9b6e-4d63-bb94-8cb2091097d3",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Config').all();\nconst res = $input.all();\nconst statuses = {};\nlet providers = [];\nconst errors = [];\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || { json: {} }).json;\n  const r = res[i].json || {};\n  const b = r.body || {};\n  if (r.statusCode !== 200) { errors.push(meta.kind + ' ' + meta.pid + ' status ' + r.statusCode + ' ' + JSON.stringify(b).slice(0, 200)); continue; }\n  if (meta.kind === 'cts') {\n    const list = b.custom_translation_statuses || [];\n    const m = {};\n    for (const s of list) { m[String(s.status_id)] = s.title; }\n    statuses[meta.pid] = m;\n  } else {\n    for (const p of (b.translation_providers || [])) { providers.push({ id: p.provider_id, name: p.name, slug: p.slug }); }\n  }\n}\nreturn [{ json: { statuses: statuses, providers: providers, errors: errors } }];\n"
      }
    }
  ],
