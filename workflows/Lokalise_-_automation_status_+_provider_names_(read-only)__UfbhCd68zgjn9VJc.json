    {
      "id": "28bf8e98-ad20-4301-a5c8-fd9c92482308",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const PIDS = ['1286096867dbf31146afc5.54950617','6744586768821f2c3fe845.13636914','60625870676151e1da46d0.81913446','491848986923fad6dc2f85.42477363','3070657967b5854be32cb1.65162854','146903556751632e0388b9.21648688','852017176a3ce11141ecd5.60405885','2944050668d5010cbd95e8.36175908','691331356a3b9a68428ab3.43540470','225008626a33e62b328c63.04676982','9754058268381744ebf048.90929380','14240418673f52ae29a007.74392007'];\nconst out = [];\nfor (const p of PIDS) {\n  out.push({ json: { pid: p, kind: 'cts', url: 'https://api.lokalise.com/api2/projects/' + p + '/custom_translation_statuses?limit=100' } });\n}\nout.push({ json: { pid: 'team', kind: 'providers', url: 'https://api.lokalise.com/api2/teams/457440/translation_providers?limit=50' } });\nreturn out;\n"
      }
    },
    {
      "id": "a86d61f0-b228-47e8-a763-4b7b244cfe82",
      "name": "Fetch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
