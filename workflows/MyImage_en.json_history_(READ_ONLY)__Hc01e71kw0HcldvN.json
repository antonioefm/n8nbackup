      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const c = it.json;\n  const f = (c.files || []).find(function (x) { return x.filename === 'src/locales/en.json'; });\n  const lines = f && f.patch ? f.patch.split('\\n').filter(function (l) { return /^[+-]/.test(l) && !/^(\\+\\+\\+|---)/.test(l); }) : [];\n  out.push({ sha: c.sha.slice(0, 9), date: c.commit.author.date, msg: c.commit.message.split('\\n')[0], en_patch_truncated: !(f && f.patch), files: (c.files || []).map(function (x) { return x.filename; }).slice(0, 40), en_lines: lines });\n}\nreturn [{ json: { commits: out } }];"
      }
