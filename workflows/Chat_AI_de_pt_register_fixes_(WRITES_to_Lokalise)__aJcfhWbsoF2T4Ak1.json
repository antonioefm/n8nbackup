      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Each fix: key name, lang, find (must occur exactly once in the current text), replace. Written as unverified.\nconst project_id = '691331356a3b9a68428ab3.43540470';\nconst fixes = [\n  { name: 'seo::pages::cancelSubscriptionVerify::title', lang: 'de', find: 'Bestätigung Ihrer Kündigung', replace: 'Bestätigung deiner Kündigung' },\n  { name: 'auth::title', lang: 'pt', find: 'Cadastrar-se ou iniciar sessão', replace: 'Cadastre-se ou faça login' },\n  { name: 'accountSettings::logoutEverywhere::errorDescription', lang: 'pt', find: 'Inicie sessão e', replace: 'Faça login e' }\n];\nreturn [{ json: { project_id, fixes, names: fixes.map(f => f.name) } }];"
      }
    },
    {
      "id": "e0516390-9626-4cd5-8eed-0aa583984bec",
      "name": "Get Current",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/keys?limit=500&include_translations=1&filter_keys={{ encodeURIComponent($json.names.join(',')) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "VW7WtJP8PzJMR813",
          "name": "Lokalise read-only"
        }
      }
    },
    {
      "id": "a0142b44-b3f6-40b6-a5d0-44ea5ca1891b",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Params').first().json; const keys = $input.first().json.keys || [];\nconst byName = {}; keys.forEach(k => { if (!k.is_archived) byName[k.key_name.web || k.key_name.other] = k; });\nconst byKey = {}; const skipped = []; const plan = [];\np.fixes.forEach(f => {\n  const k = byName[f.name]; const t = k && (k.translations || []).find(x => x.language_iso === f.lang);\n  if (!t) { skipped.push({ name: f.name, why: 'missing' }); return; }\n  const n = t.translation.split(f.find).length - 1;\n  if (n !== 1) { skipped.push({ name: f.name, lang: f.lang, why: 'find occurs ' + n + 'x', now: t.translation }); return; }\n  const to = t.translation.replace(f.find, f.replace);\n  (byKey[k.key_id] = byKey[k.key_id] || []).push({ language_iso: f.lang, translation: to, is_unverified: true });\n  plan.push({ key_id: k.key_id, name: f.name, lang: f.lang, from: t.translation, to: to });\n});\nconst body = { keys: Object.keys(byKey).map(id => ({ key_id: Number(id), translations: byKey[id] })) };\nif (!body.keys.length) throw new Error('Nothing to write: ' + JSON.stringify(skipped));\nreturn [{ json: { body, skipped, plan, key_ids: plan.map(x => x.key_id) } }];"
      }
    },
