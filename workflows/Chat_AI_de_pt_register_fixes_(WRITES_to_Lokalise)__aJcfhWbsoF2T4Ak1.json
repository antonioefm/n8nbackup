      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const B = $('Build').first().json; const keys = $input.first().json.keys || [];\nconst res = B.plan.map(x => { const k = keys.find(y => y.key_id === x.key_id); const t = k && k.translations.find(y => y.language_iso === x.lang); return { name: x.name, lang: x.lang, ok: !!t && t.translation === x.to, unverified: t && t.is_unverified, from: x.from, now: t && t.translation }; });\nreturn [{ json: { ok: res.every(r => r.ok), results: res, skipped: B.skipped } }];"
      }
    }
