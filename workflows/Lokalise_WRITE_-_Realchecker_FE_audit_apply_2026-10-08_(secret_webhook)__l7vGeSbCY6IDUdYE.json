      "id": "36d846fa-f610-4f8b-9940-aaafd91fc585",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const res=$input.all();const req=$('Build').all();const st=$getWorkflowStaticData('global').last||{};\nif(req.length&&req[0].json.none)return [req[0].json];\nlet ok=0;const bad=[];\nfor(let i=0;i<res.length;i++){const r=res[i].json;const q=req[i].json;const got=(r.body&&r.body.translation)?r.body.translation.translation:undefined;\n const gotS=typeof got==='string'?got:JSON.stringify(got);let wantS=q.want;try{if(typeof got==='object'){wantS=JSON.stringify(JSON.parse(q.want));}}catch(e){}\n if(r.statusCode===200&&gotS===wantS)ok++;else bad.push({k:q.key_id,iso:q.iso,status:r.statusCode,got:String(gotS).slice(0,120),err:JSON.stringify(r.body&&r.body.error||r.error||'').slice(0,200)});}\nreturn [{json:{written_ok:ok,bad:bad,skipped:st.skipped||[]}}];"
      }
    }
