      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$('Check').first().json;const b=$input.first().json.body||{};\nif(!Array.isArray(b.keys))throw new Error('fetch failed '+JSON.stringify(b).slice(0,200));\nconst LING=new Set('qrcodelocalization@gmail.com sabrathan@gmail.com farahputri@gmail.com dmluciahorea@gmail.com roxanamoldovan25@gmail.com mteres@terestraducciones.com arandatrad@gmail.com sara.guinot.trad@gmail.com daniel@dgmultilingualservices.com root-translations@outlook.com austra.muizniece@gmail.com harald.roald@gmail.com 47natcha@gmail.com ellen.de.venter@outlook.com ilaria.roncaglia@gmail.com silke.luehrmann@gmx.de boh.vozniuk@gmail.com vidiasc@gmail.com ivanaturcin@ymail.com julius.valkiunas@gmail.com jaromirvicari@me.com karahansisman@gmail.com katri.varvikko@gmail.com kenneth@phraseit.dk translation@cornell.hu ruckova.lucia@gmail.com marit.teichmann@gmail.com michal.tosza@translators.org.pl mteixeira@sacradomus.com bruno@bsttranslations.com nerissaneptuno@gmail.com straus.translations@gmail.com quentinnguyen.localize@gmail.com therese.svardsten@gmail.com mjlocalize@gmail.com silis.martins@gmail.com'.split(' '));\nconst map={};const plural={};for(const k of b.keys){if(k.is_archived)continue;plural[k.key_id]=k.is_plural;for(const t of (k.translations||[])){map[k.key_id+'|'+t.language_iso]=t;}}\nconst out=[];const skipped=[];\nfor(const it of c.items){const t=map[it.key_id+'|'+it.iso];if(!t){skipped.push({k:it.key_id,iso:it.iso,why:'no slot or archived'});continue;}\n const cur=typeof t.translation==='string'?t.translation:JSON.stringify(t.translation);\n if(cur===it.text){skipped.push({k:it.key_id,iso:it.iso,why:'already'});continue;}\n if(cur!==it.old){skipped.push({k:it.key_id,iso:it.iso,why:'changed since audit'});continue;}\n if(LING.has(t.modified_by_email)){skipped.push({k:it.key_id,iso:it.iso,why:'linguist edit '+t.modified_by_email});continue;}\n let val=it.text;if(plural[it.key_id]){val=JSON.parse(it.text);}\n out.push({json:{tid:t.translation_id,key_id:it.key_id,iso:it.iso,want:it.text,body:{translation:val}}});}\n$getWorkflowStaticData('global').last={skipped:skipped,n:out.length};\nif(c.dry){return [{json:{none:true,dry:true,would_write:out.length,skipped:skipped}}];}\nif(!out.length)return [{json:{none:true,written_ok:0,skipped:skipped}}];\nreturn out;"
      }
