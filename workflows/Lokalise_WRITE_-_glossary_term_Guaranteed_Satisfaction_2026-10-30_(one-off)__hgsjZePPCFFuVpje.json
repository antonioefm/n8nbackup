      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NEW = 'SSL encryption';\nconst DESC = 'Trust and checkout badges. Covers \"SSL encrypted\", \"SSL encryption\" and \"256-bit SSL Encryption\" (e.g. FR \"Chiffrement SSL 256 bits\"). Use the noun form on badges. FR: chiffrement/chiffré, never cryptage/crypté. NL: versleuteling, not codering. PT: Brazilian Criptografia, not Encriptado.';\nconst TR = [[666,'SSL-Verschlüsselung'],[1056,'Cifrado SSL'],[673,'Chiffrement SSL'],[734,'Crittografia SSL'],[733,'SSL 암호화'],[749,'Penyulitan SSL'],[737,'SSL-versleuteling'],[708,'Criptografia SSL'],[754,'SSL-kryptering'],[753,'การเข้ารหัส SSL'],[774,'Mã hóa SSL']];\nconst meta = []; const related = []; let complete = false;\nfor (const n of ['P1','P2','P3']) {\n  const it = $(n).first().json; const b = it.body || {}; const h = it.headers || {}; const d = b.data || [];\n  meta.push({ n: n, s: it.statusCode, cnt: d.length });\n  for (const t of d) { if (/ssl|encrypt/i.test(t.term || '')) related.push({ id: t.id, term: t.term }); }\n  if (!h['x-pagination-next-cursor']) { complete = true; break; }\n}\nconst ok = complete && meta.every(function (m) { return m.s === 200; });\nreturn [{ json: { meta: meta, related: related, proceed: ok && related.length === 0, body: { terms: [{ term: NEW, description: DESC, caseSensitive: false, translatable: true, forbidden: false, tags: ['PDF', 'checkout'], translations: TR.map(function (x) { return { langId: x[0], translation: x[1], description: '' }; }) }] } } }];"
      }
    },
