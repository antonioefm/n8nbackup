        "jsCode": "const src = $('Payload').all(); const res = []; let ok = 0, n = 0;\n$input.all().forEach((it, i) => { const s = src[i].json; const b = it.json; const exp = {}; for (const k of s.body.keys) exp[k.key_id] = k.translations[0].translation;\n  if (!Array.isArray(b.keys)) { res.push({ p: s.p, error: JSON.stringify(b).slice(0, 300) }); return; }\n  if (b.keys.length !== s.ids.length) res.push({ p: s.p, expected: s.ids.length, got: b.keys.length });\n  for (const k of b.keys) { n++; const es = (k.translations || []).find(t => t.language_iso === 'es'); if (es && es.translation === exp[k.key_id]) ok++; else res.push({ p: s.p, key_id: k.key_id, got: es ? es.translation : null }); } });\nreturn [{ json: { n, ok, bad: res } }];"
      }
