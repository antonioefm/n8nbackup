      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const BASE = 'https://api.lokalise.com/api2';\nconst PROJECTS = [\n  { name: 'Personality.co', pid: '31393214664f295f94dd86.76792605' },\n  { name: 'Personality - Members area', pid: '9933660066825e9a8005c8.58526829' }\n];\nreturn PROJECTS.map(p => ({ json: { name: p.name, pid: p.pid, url: BASE + '/projects/' + p.pid } }));\n"
      }
    },
    {
      "id": "65cb3174-15ae-4755-a3b1-dfac105e02ec",
      "name": "Fetch Lokalise",
      "type": "n8n-nodes-base.httpRequest",
