    },
    {
      "id": "78a03486-0349-4142-8353-672358e65f5d",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const EXCLUDE = new Set(['ps','pst','cus','pt_old','en']);\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  const b = r.body !== undefined ? r.body : r;\n  const proj = b.project || b;\n  const stats = proj.statistics || {};\n  const langs = (stats.languages || [])\n    .filter(l => !EXCLUDE.has(l.language_iso))\n    .map(l => ({\n      iso: l.language_iso,\n      id: l.language_id,\n      progress: l.progress,\n      words_to_do: l.words_to_do\n    }))\n    .sort((a,b2) => a.progress - b2.progress);\n  out.push({ json: {\n    project_name: proj.name,\n    project_id: proj.project_id,\n    statusCode: r.statusCode,\n    keys_total: stats.keys_total,\n    team_total: stats.team,\n    base_words: stats.base_words,\n    qa_issues: stats.qa_issues_total,\n    progress_total: stats.progress_total,\n    lang_count: langs.length,\n    languages: langs\n  }});\n}\nreturn out;\n"
      }
    }
  ],
