      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of items) {\n  const j = it.json || {};\n  const pid = j.project_id || '';\n  const keys = j.keys || [];\n  for (const k of keys) {\n    const kn = k.key_name;\n    const keyName = (typeof kn === 'string') ? kn : (kn && (kn.web || kn.other || kn.ios || kn.android || Object.values(kn)[0])) || '';\n    const tr = {};\n    for (const t of (k.translations || [])) {\n      tr[t.language_iso] = { v: t.translation, rev: t.is_reviewed, unv: t.is_unverified, words: t.words, mod: t.modified_at };\n    }\n    out.push({ json: {\n      project_id: pid,\n      key_id: k.key_id,\n      key_name: keyName,\n      description: k.description || '',\n      tags: k.tags || [],\n      platforms: k.platforms || [],\n      is_plural: !!k.is_plural,\n      plural_name: k.plural_name || '',\n      is_hidden: !!k.is_hidden,\n      screenshots: (k.screenshots || []).length,\n      char_limit: k.char_limit || 0,\n      translations: tr\n    }});\n  }\n}\nreturn out;"
      }
    }
