        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "zendeskApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\n  \"tags\": [\"automation_replied\"]\n}",
        "options": {}
      },
      "credentials": {
        "zendeskApi": {
          "id": "PhhvXVI6PIMK8NA1",
          "name": "BrainIQTest Zendesk account"
        }
      },
      "notes": "Non-translated branch. Zendesk Add Tags endpoint - appends without replacing. Body is a bare tags object, NOT wrapped in ticket. additional_tags on the single-ticket Update endpoint does not work; it is Update Many only.",
