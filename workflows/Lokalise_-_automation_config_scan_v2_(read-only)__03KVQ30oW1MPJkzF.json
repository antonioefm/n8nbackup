      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const W = [\n  ['2024-05-01','2024-07-31'],['2024-08-01','2024-10-31'],['2024-11-01','2025-01-31'],\n  ['2025-02-01','2025-04-30'],['2025-05-01','2025-07-31'],['2025-08-01','2025-10-31'],\n  ['2025-11-01','2026-01-31'],['2026-02-01','2026-04-30'],['2026-05-01','2026-07-31'],\n  ['2026-08-01','2026-09-08']\n];\nconst CODES = ['settings.automations.updated'];\nconst out = [];\nfor (const w of W) {\n  for (const c of CODES) {\n    out.push({ json: { url: 'https://api.lokalise.com/v1/audit-logs?event_type=' + c + '&date_from=' + w[0] + '&date_to=' + w[1] + '&limit=1000', label: c + ' ' + w[0] } });\n  }\n}\nreturn out;\n"
      }
    },
