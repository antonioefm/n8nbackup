    {
      "id": "e70edaba-3f86-4f21-9b39-7ab0db9f68fd",
      "name": "Collect Automations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Build Windows').all();\nconst res = $input.all();\nconst seen = {};\nconst windows = [];\nconst latest = {};\nlet total = 0;\nlet minTime = null;\nlet maxTime = null;\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || { json: {} }).json;\n  const r = res[i].json || {};\n  const body = r.body || {};\n  const list = body.data || [];\n  windows.push(meta.label + ': status=' + r.statusCode + ' n=' + list.length + ' has_more=' + body.has_more);\n  for (const ev of list) {\n    const uid = (ev.metadata && ev.metadata.uid) ? ev.metadata.uid : JSON.stringify(ev).slice(0, 60);\n    if (seen[uid]) { continue; }\n    seen[uid] = true;\n    total++;\n    const t = Number(ev.time || 0);\n    if (minTime === null || t < minTime) { minTime = t; }\n    if (maxTime === null || t > maxTime) { maxTime = t; }\n    let pid = null;\n    let pname = null;\n    for (const e of (ev.enrichments || [])) {\n      if ((e.name || '') === 'project' && e.data) { pid = String(e.data.id); pname = e.data.name; }\n    }\n    if (pid === null) { continue; }\n    const d = (ev.unmapped && ev.unmapped.data) ? ev.unmapped.data : {};\n    const actor = (ev.actor && ev.actor.user) ? ev.actor.user.uid : null;\n    if (!latest[pid] || t > latest[pid].time) {\n      latest[pid] = { time: t, project_id: pid, project_name: pname, actor: actor, rules: d.new || [] };\n    }\n  }\n}\nconst projItems = $('Fetch Projects').all();\nconst projects = [];\nfor (const it of projItems) {\n  for (const p of (it.json.projects || [])) {\n    const st = p.statistics || {};\n    const langs = [];\n    for (const l of (st.languages || [])) { langs.push(l.language_iso); }\n    projects.push({ id: p.project_id, name: p.name, base: p.base_language_iso, keys: st.key_count, progress: st.progress_total, langs: langs, imt: (p.settings || {}).inline_machine_translations });\n  }\n}\nconst rows = [];\nfor (const pid in latest) { rows.push(latest[pid]); }\nreturn [{ json: { windows: windows, event_total: total, oldest_event: minTime, newest_event: maxTime, projects_with_events: rows.length, project_count: projects.length, projects: projects, latest: rows } }];\n"
      }
    }
