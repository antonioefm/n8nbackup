            "index": 0
          }
        ]
      ]
    },
    "Get Transitions": {
      "main": [
        [
          {
            "node": "Only Done Transition",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only Done Transition": {
      "main": [
        [
          {
            "node": "Transition to Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transition to Done": {
      "main": [
        [
          {
            "node": "Loop Over Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
