{
  "id": "CcH1yM7AVJz4QGkK",
  "name": "Jira: Transition Internal QA issues to Done on version release",
  "description": null,
  "active": false,
  "activeVersionId": null,
  "createdAt": "2026-07-27T15:00:14.499Z",
  "updatedAt": "2026-07-27T15:48:37.000Z",
  "isArchived": false,
  "versionId": "0cdb8d6b-5c06-4ade-bd20-8e37ca65b664",
  "versionCounter": 4,
  "sourceWorkflowId": null,
  "triggerCount": 0,
  "nodes": [
    {
      "id": "1aca8a4d-aeca-44bd-94bd-5eb9abdebb61",
      "name": "On Version Released",
      "type": "n8n-nodes-base.jiraTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        80
      ],
      "parameters": {
        "jiraVersion": "cloud",
        "events": [
          "jira:version_released"
        ]
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "sp1h1DLVHlZpxymh",
          "name": "Jira n8n Cloud Account"
        }
      },
      "webhookId": "68429461-a3b1-45e5-af89-6bcbc66568c5"
    },
    {
      "id": "cfba4458-24eb-4be2-8310-cefb8ac7b927",
      "name": "Get Internal QA Issues",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        224,
        80
      ],
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "jiraVersion": "cloud",
        "returnAll": true,
        "options": {
          "fields": "key,summary,status,fixVersions",
          "jql": "=project = AC AND fixVersion = \"{{ $json.version.name }}\" AND status = \"Internal QA\""
        }
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "sp1h1DLVHlZpxymh",
          "name": "Jira n8n Cloud Account"
        }
      }
    },
    {
      "id": "3055f7e0-d961-4356-aae1-a68ace2306c0",
      "name": "Loop Over Issues",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        448,
        80
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "981eaf88-0913-43af-8197-5183b33763c7",
      "name": "Get Transitions",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "issue",
        "operation": "transitions",
        "jiraVersion": "cloud",
        "issueKey": "={{ $json.key }}"
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "sp1h1DLVHlZpxymh",
          "name": "Jira n8n Cloud Account"
        }
      }
    },
    {
      "id": "86e90b09-c679-4faf-ac94-bcececad3949",
      "name": "Only Done Transition",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        896,
        0
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "to-done",
              "leftValue": "={{ $json.to.name }}",
              "rightValue": "Done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "e1b59215-90f6-4c57-bbbc-07c98abf5046",
      "name": "Transition to Done",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        1120,
        80
      ],
      "parameters": {
        "resource": "issue",
        "operation": "update",
        "jiraVersion": "cloud",
        "issueKey": "={{ $('Loop Over Issues').item.json.key }}",
        "updateFields": {
          "statusId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $json.id }}"
          }
        }
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "sp1h1DLVHlZpxymh",
          "name": "Jira n8n Cloud Account"
        }
      }
    }
  ],
  "connections": {
    "On Version Released": {
      "main": [
        [
          {
            "node": "Get Internal QA Issues",
            "type": "main",
            "index": 0
