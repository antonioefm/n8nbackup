    },
    {
      "id": "178c121b-1528-4625-b45e-66b5be7b5bb6",
      "name": "Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// EDIT ME: one item per Jira attachment to upload.\n// key_ids empty = download only (preview).\nconst P = '185916266aa3d6649ca6f7.57851232';\nconst D = 'Jira IQTST-1027 attachment, captured by Kseniya Krasovskaya on DEV (2 Nov 2026) before the fix: shows the English source of the email. Subject = headline at the top.';\nreturn [\n  { json: { project_id: P, attachment_id: '74999', title: 'IQTST-1027 – Visual-spatial result-ready email', description: D, ticket: 'IQTST-1027', key_ids: [974823249, 974823250, 974823251] } },\n  { json: { project_id: P, attachment_id: '74997', title: 'IQTST-1027 – Quantitative reasoning result-ready email', description: D, ticket: 'IQTST-1027', key_ids: [974823252, 974823253, 974823254] } },\n  { json: { project_id: P, attachment_id: '74996', title: 'IQTST-1027 – Verbal comprehension result-ready email', description: D, ticket: 'IQTST-1027', key_ids: [974823255, 974823256, 974823257] } },\n  { json: { project_id: P, attachment_id: '74995', title: 'IQTST-1027 – Working memory result-ready email', description: D, ticket: 'IQTST-1027', key_ids: [974823258, 974823259, 974823260] } },\n  { json: { project_id: P, attachment_id: '74998', title: 'IQTST-1027 – Processing speed result-ready email', description: D, ticket: 'IQTST-1027', key_ids: [974823261, 974823262, 974823263] } }\n];"
      }
    },
    {
      "id": "6fe5bf06-4d6f-4d2d-908a-1ceb2185ba79",
      "name": "Download Attachment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://futuremedia.atlassian.net/rest/api/3/attachment/content/{{ $json.attachment_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "QJte7dJbX10mIzJI",
          "name": "Jira SW Cloud account"
        }
      }
    },
    {
      "id": "78561e95-f369-4ca1-94d0-bc7473b0b6e2",
      "name": "Build Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ps = $('Params').all(); const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const p = ps[i].json;\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const mime = (items[i].binary && items[i].binary.data && items[i].binary.data.mimeType) || 'image/png';\n  const uri = 'data:' + mime + ';base64,' + buf.toString('base64');\n  out.push({ json: { project_id: p.project_id, attachment_id: p.attachment_id, bytes: buf.length, upload: p.key_ids.length > 0, body: { screenshots: [{ data: uri, title: p.title, description: p.description, ocr: false, key_ids: p.key_ids, tags: [p.ticket] }] } } });\n}\nreturn out;"
      }
    },
    {
      "id": "00b40224-dcb1-4742-a939-957c89e1cda9",
      "name": "Only With Keys",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.upload }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "09180400-3933-4113-b6de-0c77e5f8e509",
      "name": "Upload Screenshot (WRITE)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/screenshots",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "disabled": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "a8189bbd-411c-4db5-9078-0af074cd3008",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(function (it) { const b = it.json.body || {}; const s = (b.screenshots || [])[0] || {}; return { json: { status: it.json.statusCode, screenshot_id: s.screenshot_id, title: s.title, key_ids: s.key_ids, errors: b.errors || b.error || null } }; });"
      }
    }
  ],
