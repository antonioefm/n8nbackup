      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TARGET = ['Set request data test2', 'Set translated request data test1', \"Language isn't English\", 'Translate ticket to english1', 'Translate macro to local language', 'Build ticket update payload', 'Get Project Config'];\nconst PREFIX = /^(BrainIQ|ChatbotOnline|LS|MS|MyImage|MyQRCode|PDF Help|PS|QR Create|Realchecker|ResumeWise|Unicopy|VinReady) /;\nconst out = [];\nfor (const page of $input.all()) {\n  for (const w of (page.json.data || [])) {\n    if (!w || !w.nodes || w.isArchived || !PREFIX.test(w.name || '')) continue;\n    const nodes = w.nodes.filter(n => TARGET.includes(n.name)).map(n => ({ name: n.name, type: n.type, typeVersion: n.typeVersion, disabled: !!n.disabled, parameters: n.parameters, conns: (w.connections || {})[n.name] || null }));\n    if (nodes.length) out.push({ id: w.id, name: w.name, active: w.active, versionId: w.versionId, activeVersionId: w.activeVersionId, updatedAt: w.updatedAt, nodes });\n  }\n}\nreturn [{ json: { workflows: out } }];"
      }
    }
