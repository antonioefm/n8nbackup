    {
      "id": "b489069d-7164-41b9-9e72-a59367b74db9",
      "name": "Build Header Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const sheets = $input.first().json.sheets || [];\nconst ranges = sheets.map(s => \"ranges=\" + encodeURIComponent(\"'\" + s.properties.title.replace(/'/g, \"''\") + \"'!1:3\")).join('&');\nreturn [{ json: { url: 'https://sheets.googleapis.com/v4/spreadsheets/1j6Zh4Fc886J65XVjSnf7sSsaFe6FbkUu0CykbBNOcxY/values:batchGet?' + ranges, sheets } }];"
      }
    },
    {
      "id": "852ce2d2-cde9-47bc-b659-a518252510d0",
      "name": "Get Header Rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Gt1NY0PXKDxBUQGy",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "fbe77237-3ecc-49c4-abc4-f11375f03e5d",
      "name": "Build Hide Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "const sheets = $('Build Header Request').first().json.sheets;\nconst valueRanges = $input.first().json.valueRanges || [];\nconst norm = h => String(h).toLowerCase().replace(/[^a-z]/g, '');\nconst targets = ['lokalisestatus', 'localisestatus', 'localizestatus'];\nconst HIDDEN = false;\nconst requests = [];\nconst report = [];\nsheets.forEach((s, i) => {\n  const p = s.properties;\n  const rows = ((valueRanges[i] || {}).values) || [];\n  let col = -1, row = -1;\n  for (let r = 0; r < rows.length && col === -1; r++) {\n    const idx = (rows[r] || []).findIndex(h => targets.indexOf(norm(h)) !== -1);\n    if (idx !== -1) { col = idx; row = r; }\n  }\n  if (col === -1) { report.push({ tab: p.title, status: 'skipped: no Lokalise status header' }); return; }\n  requests.push({ updateDimensionProperties: {\n    range: { sheetId: p.sheetId, dimension: 'COLUMNS', startIndex: col, endIndex: col + 1 },\n    properties: { hiddenByUser: HIDDEN }, fields: 'hiddenByUser' } });\n  report.push({ tab: p.title, status: (HIDDEN ? 'hid' : 'unhid') + ' column ' + (col + 1) });\n});\nif (!requests.length) { throw new Error('No Lokalise status column found in any tab'); }\nreturn [{ json: { body: { requests }, report, requestCount: requests.length } }];"
      }
    },
    {
