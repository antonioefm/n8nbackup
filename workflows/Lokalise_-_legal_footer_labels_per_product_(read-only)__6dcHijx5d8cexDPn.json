    {
      "id": "7cd871fc-47c1-4efe-b0f9-60230ab35328",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const meta = $('Pick Labels').all().map(i => i.json);\nconst rows = [];\n$input.all().forEach((it, i) => {\n  for (const k of (it.json.keys || [])) {\n    const kn = k.key_name && (k.key_name.web || k.key_name.other || Object.values(k.key_name)[0]);\n    const tr = {}; for (const t of (k.translations || [])) tr[t.language_iso] = t.translation;\n    rows.push({ repo: meta[i].repo, key_id: k.key_id, key: kn, tags: k.tags, tr });\n  }\n});\nreturn [{ json: { rows } }];"
      }
    }
