      "id": "b0e41a32-8234-4118-999d-45a216992286",
      "name": "Pick Labels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').all().map(i => i.json);\nconst RX = /^(terms of use|terms of service|terms and conditions|terms|privacy policy|privacy notice|privacy)$/i;\nconst out = [];\n$input.all().forEach((it, i) => {\n  const b = it.json; if (!Array.isArray(b.keys)) throw new Error('no keys for ' + cfg[i].repo);\n  const ids = [];\n  for (const k of b.keys) {\n    const en = (k.translations || []).find(t => t.language_iso === 'en');\n    const v = en && typeof en.translation === 'string' ? en.translation.replace(/<[^>]+>/g,'').trim() : '';\n    if (RX.test(v)) ids.push(k.key_id);\n  }\n  out.push({ json: Object.assign({}, cfg[i], { key_ids: ids.join(','), n: ids.length }) });\n});\nreturn out.filter(o => o.json.n > 0);"
      }
    },
