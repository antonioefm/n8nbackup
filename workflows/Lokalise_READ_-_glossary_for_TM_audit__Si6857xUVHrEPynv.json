        "jsCode": "// READ ONLY. Compact copy of the shared Lokalise glossary for the TM audit.\nconst ISO = {640:'en',1056:'es',793:'hr',765:'cs',767:'da',737:'nl',10154:'et',818:'fil',768:'fi',673:'fr',666:'de',761:'el',773:'hu',757:'id',734:'it',733:'ko',10153:'lv',10152:'lt',749:'ms',760:'no',748:'pl',708:'pt',770:'ro',799:'sk',10159:'sl',754:'sv',753:'th',744:'tr',769:'uk',774:'vi'};\nconst a = $('Glossary p1').first().json; const b = $input.first().json || {};\nconst all = [...(a.data || []), ...(((a.meta || {}).nextCursor) ? (b.data || []) : [])];\nlet last = '';\nconst terms = all.map(t => { const u = String(t.updatedAt || t.updated_at || t.createdAt || ''); if (u > last) last = u; const tr = {}; for (const x of (t.translations || [])) { const i = ISO[x.langId]; if (i && x.translation) tr[i] = x.translation; } return { term: t.term, cs: !!t.caseSensitive, tl: t.translatable !== false, fb: !!t.forbidden, tr, u }; });\nreturn [{ json: { count: terms.length, last_updated: last, terms } }];"
      }
    }
