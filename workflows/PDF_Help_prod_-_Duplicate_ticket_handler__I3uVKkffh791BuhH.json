      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "zendeskApi": {
          "id": "9M06uRPbxoSk63jK",
          "name": "PDF Zendesk account"
        }
      }
    },
