    {
      "id": "ad05f36a-efd8-4498-9617-4236178f522f",
      "name": "Split Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pr = $('Get PR').first().json;\nconst sha = pr.head && pr.head.sha;\nconst repo = $('Config').first().json.repo;\nconst files = $input.all().map(i => i.json).filter(f => f && f.filename);\nreturn files.filter(f => f.status !== 'removed').map(f => ({ json: { repo, sha, path: f.filename, status: f.status, additions: f.additions, deletions: f.deletions, patch: f.patch || '' } }));"
      }
    },
    {
      "id": "dd7dd193-85dd-408f-b558-19578c1ab740",
      "name": "Get Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/QR-CODE-App/' + $json.repo + '/contents/' + encodeURI($json.path) + '?ref=' + $json.sha }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            }
          ]
        },
        "options": {
