              "outputPropertyName": "data"
            }
          },
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 500
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "credentials": {
        "githubApi": {
          "id": "mUh6urSdgDMQojf1",
          "name": "GitHub account 2"
        }
      }
    },
    {
      "id": "975e192d-5f81-4f0a-9066-fe32b0c358bd",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pr = $('Get PR').first().json;\nconst src = $('Split Files').all().map(i => i.json);\nconst got = $input.all().map(i => i.json);\nconst files = src.map((f, i) => ({ path: f.path, status: f.status, additions: f.additions, deletions: f.deletions, patch: f.patch, content: typeof (got[i] || {}).data === 'string' ? got[i].data : null }));\nreturn [{ json: { pr: pr.number, title: pr.title, state: pr.state, merged: pr.merged, head_ref: pr.head && pr.head.ref, head_sha: pr.head && pr.head.sha, base_ref: pr.base && pr.base.ref, changed_files: pr.changed_files, files } }];"
      }
    }
