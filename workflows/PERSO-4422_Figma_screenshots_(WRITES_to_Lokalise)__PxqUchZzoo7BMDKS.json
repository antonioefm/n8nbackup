        "jsCode": "const p = $('Params').item.json;\nconst buf = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\nif (!buf || buf.length < 1000) { throw new Error('download failed for ' + p.title); }\nreturn { json: { project_id: p.project_id, bytes: buf.length, body: { screenshots: [{ data: 'data:image/png;base64,' + buf.toString('base64'), title: p.title, description: p.description, key_ids: p.key_ids, tags: p.tags }] } } };"
      }
