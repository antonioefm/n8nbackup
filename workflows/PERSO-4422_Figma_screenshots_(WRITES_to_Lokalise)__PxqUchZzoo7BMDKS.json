        "jsCode": "return $input.all().map(function (it, i) { const b = it.json.body || {}; const s = (b.screenshots || [])[0] || {}; return { json: { status: it.json.statusCode, title: s.title, screenshot_id: s.screenshot_id, keys_linked: (s.key_ids || []).length, url: s.url, errors: b.errors || b.error || null } }; });"
