    {
      "id": "d2c61c38-3372-4447-b046-85ede0fe5a2a",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CUT = 1792145000;\nconst rows = [];\nconst ref = [];\nlet seen = 0; const errors = [];\nconst langs = {};\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  if (r.statusCode && r.statusCode !== 200) { errors.push(r.statusCode); }\n  for (const k of ((r.body || {}).keys || [])) {\n    seen++;\n    if (k.is_archived) { continue; }\n    const kn = (typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other || '') : k.key_name;\n    const t = {};\n    for (const tr of (k.translations || [])) {\n      langs[tr.language_iso] = 1;\n      let v = tr.translation; if (typeof v !== 'string') { v = JSON.stringify(v); }\n      t[tr.language_iso] = v;\n    }\n    const row = { id: k.key_id, k: kn, en: t.en || '', es: t.es || '', d: String(k.description || '').slice(0, 300), tg: k.tags || [], pl: k.is_plural ? 1 : 0, ts: k.created_at_timestamp };\n    if (k.created_at_timestamp >= CUT) { rows.push(row); } else { ref.push(row); }\n  }\n}\nreturn [{ json: { keys_seen: seen, new_count: rows.length, ref_count: ref.length, errors: errors, langs: Object.keys(langs), new_empty_es: rows.filter(function(x){return !x.es;}).length, rows: rows, ref: ref } }];\n"
      }
    },
