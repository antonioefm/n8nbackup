    {
      "id": "22668180-894e-44f3-ab3c-12e38479c70a",
      "name": "Scan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const NAMES={'964775386a3ce03ecca883.03770715':'Realchecker (FE)','852017176a3ce11141ecd5.60405885':'Realchecker (BE)'};\nconst CJK_OK=['zh','zh_CN','zh_TW','ja','ko'];\nconst han=/[\\u3400-\\u9FFF\\uF900-\\uFAFF]/;\nconst moji=/(脙[\\u0080-\\u00BF搂露录陇漏篓陋卤鲁潞]|脛[卤掳鸥啪\\u0080-\\u00BF]|脜[鸥啪\\u0080-\\u00BF]|\\uFFFD)/;\nconst hits=[]; const stats={};\nfor (const it of $input.all()) { const b=it.json; const p=NAMES[b.project_id]||b.project_id; stats[p]=stats[p]||{keys:0,trs:0};\n for (const k of (b.keys||[])) { stats[p].keys++; const kn=(k.key_name&&(k.key_name.web||k.key_name.other||k.key_name.ios))||'';\n  for (const t of (k.translations||[])) { stats[p].trs++; const v=t.translation||''; if(!v) continue;\n   const isHan = han.test(v) && !CJK_OK.includes(t.language_iso);\n   const isMoji = moji.test(v);\n   if (isHan||isMoji) hits.push({project:p,key_id:k.key_id,key:kn,lang:t.language_iso,type:isHan?'han':'latin-mojibake',text:v,by:t.modified_by_email,at:t.modified_at,reviewed:t.is_reviewed,unverified:t.is_unverified});\n  }}}\nreturn [{json:{CORRUPT_SCAN:{stats,count:hits.length,hits}}}];"
      }
    }
  ],
