          "name": "Lokalise access token read-write"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "0709d524-554c-42ce-965d-4b6d94df0c80",
      "name": "Find PT Variants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('List Projects').all();\nconst res = $input.all();\nconst rows = [];\nconst failed = [];\nconst variantTally = {};\nfor (let i = 0; i < res.length; i++) {\n  const pi = res[i].pairedItem;\n  let idx = i;\n  if (pi && typeof pi === 'object' && typeof pi.item === 'number') { idx = pi.item; }\n  else if (typeof pi === 'number') { idx = pi; }\n  const meta = (reqs[idx] || reqs[i]).json;\n  const body = res[i].json;\n  const arr = (body && body.languages) ? body.languages : null;\n  if (!arr) { failed.push(meta.project_name); continue; }\n  const pts = [];\n  for (const L of arr) {\n    const iso = (L.lang_iso || '');\n    if (iso.toLowerCase().indexOf('pt') === 0) {\n      pts.push({ iso: iso, id: L.lang_id, name: L.lang_name });\n      variantTally[iso] = (variantTally[iso] || 0) + 1;\n    }\n  }\n  rows.push({ project: meta.project_name, project_id: meta.project_id, total_langs: arr.length, pt_variants: pts });\n}\nconst glossary = [];\nfor (const r of rows) { if (r.project_id === '46552447679363c70f7ef8.58193285') { glossary.push(r); } }\nreturn [{ json: { kind: 'summary', projects_read: rows.length, failed: failed, pt_variant_tally: variantTally, glossary_project: glossary } }].concat(rows.map(function (r) { return { json: Object.assign({ kind: 'row' }, r) }; }));\n"
      }
    }
  ],
