    {
      "id": "c91939ac-2222-4c9a-b932-f88dacb5e92e",
      "name": "List Projects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of items) {\n  for (const p of (it.json.projects || [])) {\n    out.push({ json: { project_id: p.project_id, project_name: p.name, base: p.base_language_iso || '' } });\n  }\n}\nreturn out;\n"
      }
    },
    {
      "id": "06e9b346-4c94-49cb-a5eb-0267b84eb9d6",
      "name": "Fetch Languages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
