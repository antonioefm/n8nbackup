  "nodes": [
    {
      "id": "ed2c5a91-bc55-40ac-befd-13aeefd40592",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "384713f7-f1d9-4cc9-b491-9491a9eb2d34",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const BASE = 'https://api.lokalise.com/api2';\nconst PCO = '31393214664f295f94dd86.76792605';\nconst MA  = '9933660066825e9a8005c8.58526829';\nreturn [\n  { json: { label: 'PCO statuses hyphen', url: BASE + '/projects/' + PCO + '/custom-translation-statuses?limit=100' } },\n  { json: { label: 'PCO statuses underscore', url: BASE + '/projects/' + PCO + '/custom_translation_statuses?limit=100' } },\n  { json: { label: 'MA statuses hyphen', url: BASE + '/projects/' + MA + '/custom-translation-statuses?limit=100' } },\n  { json: { label: 'PCO one translation', url: BASE + '/projects/' + PCO + '/translations?limit=1&filter_lang_id=666' } },\n  { json: { label: 'PCO tags', url: BASE + '/projects/' + PCO + '/keys?limit=1&page=1' } }\n].map(x => ({ json: x.json }));\n"
      }
    },
    {
      "id": "bd56df1a-f194-4571-8e13-271713e9eec5",
      "name": "Fetch Lokalise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1200
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "8ad611d5-9d21-4e27-9d20-ad72e4a5197b",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst cfgs = $('Config').all().map(c => c.json);\nreturn items.map((it, i) => {\n  const r = it.json || {};\n  const b = r.body !== undefined ? r.body : r;\n  return { json: { label: cfgs[i].label, statusCode: r.statusCode, body: JSON.stringify(b).slice(0, 1200) } };\n});\n"
      }
    }
  ],
