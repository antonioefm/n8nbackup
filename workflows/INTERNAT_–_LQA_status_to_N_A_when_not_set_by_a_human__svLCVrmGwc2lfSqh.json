      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const src = $('Split targets').all();\nconst res = $input.all();\nconst ok = [], failed = [];\nres.forEach((r, n) => {\n  const t = src[n].json; const code = r.json.statusCode;\n  if (code === 204) ok.push(t.key); else failed.push({ key: t.key, code, body: JSON.stringify(r.json.body || '').slice(0, 300) });\n});\nreturn [{ json: { mode: 'apply', updated: ok.length, failed_count: failed.length, ok, failed } }];"
      }
