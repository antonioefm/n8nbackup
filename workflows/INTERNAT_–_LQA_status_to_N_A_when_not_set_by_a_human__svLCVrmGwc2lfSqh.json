        "jsCode": "const ids = [];\nfor (const p of $input.all()) for (const i of (p.json.issues || [])) ids.push(i.id);\nconst out = [];\nfor (let k = 0; k < ids.length; k += 1000) out.push({ json: { ids: ids.slice(k, k + 1000) } });\nif (!out.length) throw new Error('search returned no issues');\nreturn out;"
      }
