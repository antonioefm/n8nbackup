        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const it = $input.first().json;\nconst secret = (it.headers || {})['x-lqa-secret'];\nif (secret !== '066775c80be1290ba4739c8e574fdba5') throw new Error('unauthorized');\nconst b = it.body || {};\nconst mode = b.mode === 'apply' ? 'apply' : 'dry';\nconst keys = Array.isArray(b.keys) ? b.keys.map(String) : [];\nconst all = b.all === true;\nif (mode === 'apply' && !all && keys.length === 0) throw new Error('apply needs keys[] or all:true');\nreturn [{ json: { mode, keys, all } }];"
      }
    },
