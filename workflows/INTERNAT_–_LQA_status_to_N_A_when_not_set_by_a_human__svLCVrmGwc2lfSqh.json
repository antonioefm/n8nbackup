    {
      "id": "77a1dcc8-278b-4ba3-8d30-40fcb3e4c89e",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Auth and mode').first().json;\nconst issues = [];\nfor (const p of $('Search issues').all()) for (const i of (p.json.issues || [])) issues.push(i);\nconst hist = {};\nfor (const p of $input.all()) for (const c of (p.json.issueChangeLogs || [])) {\n  hist[c.issueId] = (hist[c.issueId] || []).concat(c.changeHistories || []);\n}\nconst isHuman = a => a && a.accountType === 'atlassian';\nconst iso = v => { const d = new Date(typeof v === 'string' && /^\\d+$/.test(v) ? Number(v) : v); return isNaN(d) ? String(v) : d.toISOString(); };\nconst DEFAULT = 'To do';\nconst keep = [], targets = [];\nfor (const i of issues) {\n  const f = i.fields || {};\n  const cur = f.customfield_11581 ? f.customfield_11581.value : null;\n  const changes = [];\n  for (const h of (hist[i.id] || [])) for (const it of (h.items || [])) {\n    if (it.fieldId === 'customfield_11581') changes.push({ when: iso(h.created), by: (h.author && h.author.displayName) || 'unknown', human: isHuman(h.author), from: it.fromString, to: it.toString });\n  }\n  changes.sort((a, b) => a.when < b.when ? -1 : 1);\n  const humanChange = changes.find(c => c.human);\n  const creationValue = changes.length ? (changes[0].from || null) : cur;\n  const creatorHuman = isHuman(f.creator);\n  const humanAtCreation = creatorHuman && creationValue && creationValue !== DEFAULT && !changes.length;\n  const row = { key: i.key, summary: f.summary, current: cur || '(empty)', labels: (f.labels || []).join(','), creator: f.creator ? f.creator.displayName : '', changes: changes.length };\n  if (humanChange) { row.reason = 'human changed it (' + humanChange.by + ' ' + humanChange.when.slice(0,10) + ')'; keep.push(row); }\n  else if (humanAtCreation) { row.reason = 'human picked ' + cur + ' at creation'; keep.push(row); }\n  else {\n    row.reason = !cur ? 'empty' : (changes.length ? 'set by automation (' + changes[changes.length-1].by + ')' : 'default at creation');\n    targets.push({ ...row, id: i.id });\n  }\n}\nconst count = (arr, k) => arr.reduce((m, r) => (m[r[k]] = (m[r[k]] || 0) + 1, m), {});\nlet selected = targets;\nif (cfg.mode === 'apply' && !cfg.all) { const s = new Set(cfg.keys); selected = targets.filter(t => s.has(t.key)); }\nreturn [{ json: {\n  mode: cfg.mode, scanned: issues.length,\n  keep_count: keep.length, keep_by_value: count(keep, 'current'),\n  target_count: targets.length, target_by_value: count(targets, 'current'), target_by_reason: count(targets.map(t => ({ r: t.reason.replace(/ \\(.*\\)/, '') })), 'r'),\n  keep, targets: targets.map(({ id, ...r }) => r), selected\n} }];"
      }
    },
