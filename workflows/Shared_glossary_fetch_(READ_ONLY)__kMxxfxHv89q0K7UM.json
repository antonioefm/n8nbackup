      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = ['de','es','fr','it','ko','ms','nl','pt','sv','th','vi'];\nconst out = []; const meta = []; const seen = {};\nfor (const it of $input.all()) {\n  const b = it.json.body || {}; const h = it.json.headers || {};\n  meta.push({ s: it.json.statusCode, total: h['x-pagination-total-count'], next: h['x-pagination-next-cursor'], keys: Object.keys(b).slice(0,5), err: b.error || null });\n  const arr = b.data || b.glossary_terms || b.terms || [];\n  for (const t of arr) {\n    if (seen[t.id]) continue; seen[t.id] = 1;\n    const tr = {};\n    for (const x of (t.translations || [])) { const iso = (x.langIso || x.language_iso || '').toLowerCase(); if (L.indexOf(iso) >= 0 && x.translation) tr[iso] = x.translation; }\n    out.push({ term: t.term, desc: t.description, cs: t.caseSensitive, tr: t.translatable, forbidden: t.forbidden, tags: t.tags, t: tr });\n  }\n}\nreturn [{ json: { meta: meta, count: out.length, terms: out } }];"
      }
    }
