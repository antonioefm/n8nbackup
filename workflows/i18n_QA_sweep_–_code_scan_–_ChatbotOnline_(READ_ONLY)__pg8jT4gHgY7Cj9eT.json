    {
      "id": "eba88361-5b5f-4572-a57a-2fcafaf6efe8",
      "name": "Get Tree",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/QR-CODE-App/{{ $('Config').item.json.repo }}/git/trees/{{ $('Config').item.json.branch || $json.default_branch }}?recursive=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi"
      },
      "credentials": {
        "githubApi": {
          "id": "mUh6urSdgDMQojf1",
          "name": "GitHub account 2"
        }
