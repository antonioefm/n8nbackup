              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          },
          "batching": {
            "batch": {
              "batchSize": 10,
              "batchInterval": 1000
            }
          }
        }
      },
      "credentials": {
        "githubApi": {
          "id": "mUh6urSdgDMQojf1",
          "name": "GitHub account 2"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "08c0b6f4-5c83-4d96-8678-46af9a907c42",
      "name": "Emit File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        272
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Loop Files').itemMatching($itemIndex).json;\nconst c = $json.data;\nif (src.skip) return { json: { skip: true } };\nreturn { json: { repo: src.repo, path: src.path, content: typeof c === 'string' ? c : (c == null ? null : JSON.stringify(c)), dnt: $('Config').first().json.dnt } };"
      }
    },
