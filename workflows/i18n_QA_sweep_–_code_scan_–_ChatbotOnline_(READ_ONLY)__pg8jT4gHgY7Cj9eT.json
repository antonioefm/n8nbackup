    },
    {
      "id": "e3fc9fc1-185a-4f29-aeed-7d41c2d8e394",
      "name": "Filter Tree",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const res = $input.first().json;\nconst tree = res.tree || [];\nconst cfg = $('Config').first().json;\nconst branch = cfg.branch || $('Get Repo').first().json.default_branch;\nconst repo = cfg.repo;\nconst sub = (cfg.subdir || '').replace(/\\/$/, '');\nconst EXT = /\\.(js|jsx|ts|tsx|vue|svelte|html|hbs|mjml|njk|ejs|json|svg|py|ya?ml)$/i;\nconst SKIP = /(^|\\/)(node_modules|dist|build|\\.next|coverage|__tests__|__mocks__|mocks?|fixtures|storybook|\\.storybook|e2e|cypress|playwright|tests?|migrations|\\.github)(\\/|$)|\\.(test|spec|stories)\\.[jt]sx?$|\\.d\\.ts$|(package-lock|yarn\\.lock|pnpm-lock)|(^|\\/)package\\.json$|(^|\\/)tsconfig[^/]*$/i;\nconst isEn = p => /(^|\\/)(en|en-US|en_US)(\\.json|\\/[^/]+\\.json)$/.test(p);\nlet files = tree.filter(t => t.type === 'blob' && EXT.test(t.path) && !SKIP.test(t.path) && (t.size || 0) < 600000 && (!sub || t.path.startsWith(sub + '/')));\nfiles = files.filter(t => !/\\.json$/i.test(t.path) || isEn(t.path) || /(^|\\/)(locales?|i18n|messages|translations?)\\/[^/]*\\.json$/i.test(t.path));\nfiles = files.slice(0, 1500);\nif (!files.length) return [{ json: { skip: true, tree_truncated: !!res.truncated } }];\nreturn files.map(f => ({ json: { repo, branch, path: f.path } }));\n"
      }
    },
    {
      "id": "4e0351ba-bee8-4c15-b8e5-283698c66c6a",
      "name": "Scan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pass-through mode: return the light/color-correction funnel files and locale JSON so the scan runs in the container with code_scan.js.\nconst RE = /light[_-]?colou?r|colou?r[_-]?correct|lightColou?r|colou?rCorrection/i;\nconst items = $input.all().map(i => i.json).filter(j => j && j.path && typeof j.content === 'string');\nconst keep = items.filter(j => RE.test(j.path) || RE.test(j.content) || /(^|\\/)(en|en-US|en_US)(\\.json|\\/[^/]+\\.json)$/.test(j.path) || /(^|\\/)(locales?|i18n|messages|translations?)\\/[^/]*\\.json$/i.test(j.path));\nconst other = items.filter(j => !keep.includes(j)).map(j => j.path);\nreturn [{ json: { repo: $('Config').first().json.repo, branch: $('Config').first().json.branch, total_files: items.length, other_paths: other, files: keep.map(j => ({ path: j.path, content: j.content })) } }];\n"
      }
    },
    {
      "id": "c3886409-a8e4-4bac-8fd2-cfe0b16dfc7c",
      "name": "Get File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        192
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/QR-CODE-App/{{ $json.repo }}/contents/{{ encodeURI($json.path) }}?ref={{ $json.branch }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            }
          ]
        },
        "options": {
          "response": {
