    {
      "id": "f11ea452-9ff0-4833-b604-917a6058337b",
      "name": "Condense ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const req = $('Normalize request').first().json;\nconst sub = req.subdomain;\nconst tid = req.ticket_id;\nlet rows = [];\ntry { rows = $('Get brand config').all().map(i => i.json).filter(r => r && r.project_key); } catch (e) { rows = []; }\nconst cfg = rows.filter(r => String(r.project_key).slice(-5) === '_prod')[0] || rows[0] || {};\nconst cut = (v, n) => {\n  if (v === undefined || v === null) return '';\n  let s = typeof v === 'string' ? v : JSON.stringify(v);\n  if (!s) return '';\n  s = s.split(String.fromCharCode(13)).join('');\n  return s.length > n ? s.slice(0, n) + ' [...]' : s;\n};\nlet ticket = null;\nlet auditsBody = null;\nconst errors = [];\nif (!cfg.project_key) errors.push('No cs_project_config row for zendesk_domain ' + sub);\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  if (j.ticket && j.ticket.id) ticket = j.ticket;\n  else if (Array.isArray(j.audits)) auditsBody = j;\n  else if (j.kind && j.url) { if (errors.indexOf('No Zendesk credential branch for subdomain ' + sub) < 0) errors.push('No Zendesk credential branch for subdomain ' + sub); }\n  else errors.push('Zendesk API: ' + cut(j, 300));\n}\nconst agentId = cfg.automation_agent_id ? String(cfg.automation_agent_id) : '';\nconst names = {};\nconst addName = (id, label) => { if (id) names[String(id)] = label; };\naddName(cfg.ticket_field_allow_automation, 'Allow automation');\naddName(cfg.ticket_custom_field_category, 'Category');\naddName(cfg.ticket_field_language_id, 'Language');\naddName(cfg.ticket_custom_field_automation_label_id, 'Automation label');\naddName(cfg.ticket_field_rejection_complaint, 'Rejection complaint');\naddName(cfg.ticket_field_chatbot_classification_id, 'Chatbot classification');\naddName(cfg.ticket_field_contact_form_classification_id, 'Contact form classification');\nconst users = {};\n((auditsBody && auditsBody.users) || []).forEach(u => { users[String(u.id)] = u; });\nconst who = id => {\n  const k = String(id);\n  if (agentId && k === agentId) return 'AUTOMATION (n8n agent)';\n  if (k === '-1') return 'Zendesk system';\n  const u = users[k];\n  return u ? (u.name + ' (' + u.role + ')') : ('user ' + k);\n};\nconst fieldLabel = f => names[String(f)] || (/^[0-9]+$/.test(String(f)) ? 'field ' + f : String(f));\nconst toList = v => Array.isArray(v) ? v : String(v || '').split(' ').filter(Boolean);\nconst describe = ev => {\n  const t = ev.type;\n  if (t === 'Comment') return (ev.public ? 'PUBLIC REPLY: ' : 'INTERNAL NOTE: ') + cut(ev.plain_body || ev.body, 500);\n  if (t === 'AgentMacroReference') return 'MACRO APPLIED: ' + (ev.macro_title || '') + ' (' + ev.macro_id + ')';\n  if (t === 'Change' || t === 'Create') {\n    const f = ev.field_name;\n    if (f === 'tags') {\n      const prev = t === 'Change' ? toList(ev.previous_value) : [];\n      const val = toList(ev.value);\n      const add = val.filter(x => prev.indexOf(x) < 0);\n      const rem = prev.filter(x => val.indexOf(x) < 0);\n      if (!add.length && !rem.length) return null;\n      return 'TAGS' + (add.length ? ' +' + add.join(' +') : '') + (rem.length ? ' -' + rem.join(' -') : '');\n    }\n    if (t === 'Create' && ['status', 'subject', 'priority', 'type'].indexOf(f) < 0 && !names[String(f)]) return null;\n    return fieldLabel(f) + ': ' + (t === 'Change' ? cut(ev.previous_value, 80) + ' -> ' : '') + cut(ev.value, 120);\n  }\n  if (['Notification', 'NotificationWithCc', 'Cc', 'FollowerChange', 'CommentPrivacyChange', 'EmailCcChange', 'FollowerNotification'].indexOf(t) >= 0) return null;\n  return t + (ev.value ? ': ' + cut(ev.value, 120) : '');\n};\nlet audits = ((auditsBody && auditsBody.audits) || []).slice().sort((a, b) => String(a.created_at).localeCompare(String(b.created_at)));\nconst total = audits.length;\nconst truncated = total > 60 || !!(auditsBody && auditsBody.next_page);\nif (audits.length > 60) audits = audits.slice(-60);\nconst timeline = audits.map(a => {\n  const via = a.via || {};\n  const src = via.source || {};\n  const from = src.from || {};\n  let viaText = via.channel || '';\n  if (src.rel) viaText += ' / ' + src.rel;\n  if (from.title) viaText += ' (' + from.title + ')';\n  const evs = (a.events || []).map(describe).filter(Boolean);\n  return { at: a.created_at, by: who(a.author_id), via: viaText, events: evs };\n}).filter(e => e.events.length);\nconst cf = {};\n((ticket && ticket.custom_fields) || []).forEach(f => { cf[String(f.id)] = f.value; });\nconst key = {};\nObject.keys(names).forEach(id => { key[names[id]] = cf[id] !== undefined ? cf[id] : null; });\nconst autoEntries = timeline.filter(e => e.by.indexOf('AUTOMATION') === 0);\nconst last = autoEntries[autoEntries.length - 1];\nreturn [{ json: {\n  ok: !!ticket && errors.length === 0,\n  subdomain: sub,\n  ticket_id: tid,\n  project_key: cfg.project_key || null,\n  ticket_url: 'https://' + sub + '.zendesk.com/agent/tickets/' + tid,\n  status: ticket ? ticket.status : null,\n  subject: ticket ? cut(ticket.subject, 160) : null,\n  channel: ticket && ticket.via ? ticket.via.channel : null,\n  created_at: ticket ? ticket.created_at : null,\n  updated_at: ticket ? ticket.updated_at : null,\n  tags: ticket ? ticket.tags : [],\n  key_fields: key,\n  automation: { agent_id: agentId || null, actions: autoEntries.length, last_action_at: last ? last.at : null, last_action: last ? cut(last.events.join(' | '), 400) : null },\n  timeline: timeline,\n  timeline_total_audits: total,\n  timeline_truncated: truncated,\n  errors: errors\n} }];"
      }
    },
