    {
      "id": "22333d42-8a8e-42a5-a377-171df2f027c5",
      "name": "Filter Feature Names",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const RE = /\\bcredits?\\b|\\bcredit balance|subscription|trial|my account|\\baccount\\b/i;\nconst out = [];\nlet total = 0; let statuses = [];\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  statuses.push(r.statusCode);\n  const keys = (r.body && r.body.keys) ? r.body.keys : [];\n  total += keys.length;\n  for (const k of keys) {\n    if (k.is_archived) { continue; }\n    let en = null; const tr = {};\n    for (const t of (k.translations || [])) {\n      const iso = (t.language_iso || '').toLowerCase();\n      if (iso === 'en') { en = t.translation; } else { tr[iso] = t.translation; }\n    }\n    if (typeof en !== 'string' || en.length > 45) { continue; }\n    if (!RE.test(en)) { continue; }\n    const name = (k.key_name && (k.key_name.web || k.key_name.other)) || String(k.key_id);\n    out.push({ key: name, en: en, tr: tr });\n  }\n}\nreturn [{ json: { scanned: total, statuses: statuses, matches: out.length, items: out.slice(0, 150) } }];\n"
      }
    }
  ],
