    {
      "id": "22333d42-8a8e-42a5-a377-171df2f027c5",
      "name": "Filter Feature Names",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const RE = /hola/i;\nconst out = [];\nlet total = 0; const statuses = []; const hdr = [];\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  statuses.push(r.statusCode);\n  if (r.headers) { hdr.push(r.headers['x-pagination-total-count']); }\n  const keys = (r.body && r.body.keys) ? r.body.keys : [];\n  total += keys.length;\n  for (const k of keys) {\n    if (k.is_archived) { continue; }\n    const tr = {};\n    for (const t of (k.translations || [])) { tr[(t.language_iso || '').toLowerCase()] = t.translation; }\n    const es = Object.keys(tr).filter(function (i) { return i.indexOf('es') === 0; });\n    let hit = false;\n    for (const i of es) { if (RE.test(tr[i] || '')) { hit = true; } }\n    if (!hit) { continue; }\n    const name = (k.key_name && (k.key_name.web || k.key_name.other)) || String(k.key_id);\n    const esOut = {}; for (const i of es) { esOut[i] = tr[i]; }\n    out.push({ key_id: k.key_id, key: name, filenames: k.filenames, tags: k.tags, description: k.description, en: tr['en'], es: esOut, de: tr['de'], fr: tr['fr'] });\n  }\n}\nreturn [{ json: { scanned: total, statuses: statuses, total_header: hdr[0], matches: out.length, items: out } }];\n"
      }
    }
  ],
