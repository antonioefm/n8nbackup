    {
      "id": "0e3fb45c-7d54-44f9-b73f-0182ce313271",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tm = [];\nconst projs = $('Pick BrainIQ').all().map(x => x.json.name);\nfor (const it of $('Fetch Keys').all()) {\n  const b = it.json.body || {};\n  const pid = b.project_id || '';\n  for (const k of (b.keys || [])) {\n    if (k.is_archived || k.is_plural) continue;\n    const kn = (typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other || Object.values(k.key_name)[0]) : k.key_name;\n    if (/^members-content::/.test(kn)) continue;\n    let en = '', es = '', by = '';\n    for (const tr of (k.translations || [])) {\n      if (typeof tr.translation !== 'string') continue;\n      if (tr.language_iso === 'en') en = tr.translation;\n      if (tr.language_iso === 'es') { es = tr.translation; by = tr.modified_by_email || ''; }\n    }\n    if (!en.trim() || !es.trim()) continue;\n    if (en.length > 400) continue;\n    tm.push([pid.slice(0,8), kn, en, es, by, k.description || '']);\n  }\n}\nconst gl = [];\nfor (const it of $('Fetch Glossary').all()) {\n  for (const t of (((it.json || {}).body || {}).data || [])) {\n    const tags = (t.tags || []).map(x => String(x).toLowerCase());\n    const tr = (t.translations || []).filter(x => x.langIso === 'es' || x.langId === 1056)[0] || {};\n    gl.push([t.term, tr.translation || '', tags.join(','), t.forbidden ? 1 : 0, t.translatable ? 1 : 0, (tr.description || t.description || '').slice(0,200)]);\n  }\n}\nreturn [{ json: { projects: projs, tm_n: tm.length, tm: tm, gl_n: gl.length, gl: gl } }];\n"
      }
    },
    {
      "id": "640c6fd4-c46b-4075-8f91-ff8bfc1da191",
      "name": "Pick BrainIQ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        330,
        200
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const b = it.json.body || {};\n  for (const p of (b.projects || [])) {\n    if (/brain\\s*iq/i.test(p.name || '')) {\n      out.push({ json: { pid: p.project_id, name: p.name, keys_total: (p.statistics || {}).keys_total || 0,\n        url: 'https://api.lokalise.com/api2/projects/' + p.project_id + '/keys?include_translations=1&include_comments=1&filter_langs=en,es&disable_references=1&limit=500&pagination=cursor' } });\n    }\n  }\n}\nreturn out;\n",
        "mode": "runOnceForAllItems"
      }
    }
