    {
      "id": "1cd72946-8054-44e4-a5ba-51db3012eab1",
      "name": "Filter Tree",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const res = $input.first().json;\nconst tree = res.tree || [];\nconst cfg = $('Config').first().json;\nconst branch = cfg.branch || $('Get Repo').first().json.default_branch;\nconst repo = cfg.repo;\nconst sub = (cfg.subdir || '').replace(/\\/$/, '');\nconst EXT = /\\.(js|jsx|ts|tsx|mjs|cjs|json|ya?ml)$|(^|\\/)Dockerfile$/i;\nconst SKIP = /(^|\\/)(node_modules|dist|build|\\.next|coverage|__mocks__|storybook|\\.storybook|public)(\\/|$)|\\.d\\.ts$|(package-lock|yarn\\.lock|pnpm-lock)|(^|\\/)tsconfig[^/]*$/i;\nlet files = tree.filter(t => t.type === 'blob' && EXT.test(t.path) && !SKIP.test(t.path) && (t.size || 0) < 4000000 && (!sub || t.path.startsWith(sub + '/')));\n// JSON: keep only English locale files (site + members) and the root package.json\nfiles = files.filter(t => !/\\.json$/i.test(t.path) || /(^|\\/)en\\.json$/.test(t.path) || t.path === 'package.json');\n// YAML: keep only GitHub workflows and helm/values\nfiles = files.filter(t => !/\\.ya?ml$/i.test(t.path) || /\\.github\\/workflows\\//.test(t.path) || /values/i.test(t.path));\nconst all_paths = tree.filter(t => t.type === 'blob').map(t => t.path + '|' + (t.size || 0));\nfiles = files.slice(0, cfg.max_files || 4000);\nconst out = files.map(f => ({ json: { repo, branch, path: f.path } }));\nout[0].json.tree_truncated = !!res.truncated;\nout[0].json.all_paths = all_paths;\nreturn out;"
      }
    },
    {
      "id": "1899195f-5d2c-47ba-aaf1-3568eca3e534",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pass-through, read only: one item per file with its content, plus the tree listing.\nconst ft = $('Filter Tree').first().json;\nconst items = $input.all().map(i => i.json).filter(j => j && j.path);\nconst meta = { meta: true, repo: ft.repo, branch: ft.branch, tree_truncated: ft.tree_truncated, files_fetched: items.length, empty: items.filter(j => typeof j.content !== 'string' || !j.content.length).map(j => j.path), all_paths: ft.all_paths };\nreturn [{ json: meta }, ...items.map(j => ({ json: { path: j.path, content: j.content } }))];"
      }
    },
