      "name": "Summarize Access",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const org = $(\"Probe Org Repos\").all().map(i => i.json);\nconst usr = $(\"Probe User Repos\").all().map(i => i.json);\nconst names = [];\nfor (const r of org) { if (r && r.full_name) names.push(r.full_name); }\nfor (const r of usr) { if (r && r.full_name && !names.includes(r.full_name)) names.push(r.full_name); }\nreturn [{ json: { orgCount: org.length, userCount: usr.length, orgFirst: org[0] || null, userFirst: usr[0] || null, repos: names } }];"
      }
    },
