      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One-off 2026-10-21: add the word \"form\" before [%1$s:type] so articles agree with it (fr, pt). Guard: live == old. Written as unverified.\nconst CH = [\n  { key_id: 899111534, iso: 'fr', old: 'Remplissez le [%1$s:type] en moins de 5\\u00a0minutes', neu: 'Remplissez le formulaire [%1$s:type] en moins de 5\\u00a0minutes' },\n  { key_id: 899111534, iso: 'pt', old: 'Preencha o [%1$s:type] em menos de 5 minutos', neu: 'Preencha o formulário [%1$s:type] em menos de 5 minutos' },\n  { key_id: 899111830, iso: 'pt', old: 'Como preencher o [%1$s:type]?', neu: 'Como preencher o formulário [%1$s:type]?' }\n];\nconst b = $input.first().json.body || {};\nif (!Array.isArray(b.keys)) { throw new Error('Guard fetch failed: ' + JSON.stringify(b).slice(0, 300)); }\nconst live = {};\nfor (const k of b.keys) { for (const t of (k.translations || [])) { live[k.key_id + '|' + t.language_iso] = t.translation; } }\nconst bad = [];\nconst byKey = {};\nfor (const c of CH) {\n  const v = live[c.key_id + '|' + c.iso];\n  if (v !== c.old) { bad.push({ key_id: c.key_id, iso: c.iso, live: v }); continue; }\n  (byKey[c.key_id] = byKey[c.key_id] || []).push({ language_iso: c.iso, translation: c.neu, is_unverified: true });\n}\nif (bad.length) { throw new Error('Live text changed, nothing written: ' + JSON.stringify(bad)); }\nconst keys = Object.keys(byKey).map(function (id) { return { key_id: Number(id), translations: byKey[id] }; });\nreturn [{ json: { changes: CH.length, body: JSON.stringify({ keys: keys }), CH: CH } }];"
      }
    },
