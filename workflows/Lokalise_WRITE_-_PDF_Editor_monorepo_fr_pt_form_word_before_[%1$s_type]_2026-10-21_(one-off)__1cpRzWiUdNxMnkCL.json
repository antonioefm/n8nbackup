      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CH = $('Build writes').first().json.CH;\nconst w = $('WRITE').first().json;\nconst b = $input.first().json.body || {};\nconst live = {};\nfor (const k of (b.keys || [])) { for (const t of (k.translations || [])) { live[k.key_id + '|' + t.language_iso] = t; } }\nconst res = CH.map(function (c) { const t = live[c.key_id + '|' + c.iso] || {}; return { key_id: c.key_id, iso: c.iso, ok: t.translation === c.neu, unverified: t.is_unverified, now: t.translation }; });\nreturn [{ json: { write_status: w.statusCode, write_errors: (w.body || {}).errors || null, all_ok: res.every(function (r) { return r.ok; }), res: res } }];"
      }
