      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "day-start",
              "name": "dayStartUtc",
              "value": "2026-11-12T00:00:00Z",
              "type": "string"
            },
            {
              "id": "day-end",
              "name": "dayEndUtc",
              "value": "2026-11-13T00:00:00Z",
              "type": "string"
            },
            {
              "id": "sender-domain",
              "name": "senderDomain",
              "value": "@myimage.io",
              "type": "string"
            },
            {
              "id": "recipient-tag",
              "name": "recipientTag",
              "value": "+myimage-",
              "type": "string"
            },
            {
              "id": "zip-name",
              "name": "zipName",
              "value": "myimage-scan-emails-2026-11-12.zip",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "1397081d-77b6-46ce-a182-5e03d44f7360",
      "name": "List Emails Of The Day",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "=receivedDateTime ge {{ $json.dayStartUtc }} and receivedDateTime lt {{ $json.dayEndUtc }}"
            },
            {
              "name": "$select",
              "value": "id,subject,receivedDateTime,from,toRecipients,body"
            },
            {
              "name": "$orderby",
              "value": "receivedDateTime asc"
            },
            {
              "name": "$top",
              "value": "1000"
            }
          ]
        }
      },
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "EolDENntQmcAHoSi",
          "name": "Microsoft Outlook account"
        }
      }
    },
    {
      "id": "f2b5dd4a-a044-4894-bfd5-98d7ce1cfa11",
      "name": "One Item Per Email",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1.1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "value",
        "include": "noOtherFields"
      }
    },
    {
      "id": "59ea80e5-e5a7-4333-8e7d-6fde1f226c3d",
      "name": "Keep MyImage Scan Emails",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "from-myimage",
              "leftValue": "={{ $json.from?.emailAddress?.address ?? \"\" }}",
              "rightValue": "={{ $('Scan Settings').first().json.senderDomain }}",
              "operator": {
                "type": "string",
                "operation": "endsWith"
              }
            },
            {
              "id": "to-scan-account",
              "leftValue": "={{ ($json.toRecipients || []).map(r => r.emailAddress.address).join(\";\") }}",
              "rightValue": "={{ $('Scan Settings').first().json.recipientTag }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        }
      }
    },
    {
      "id": "5cc4fbcf-58c1-4a60-a004-11a68c1c4560",
      "name": "Download Email As EML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.microsoft.com/v1.0/me/messages/{{ encodeURIComponent($json.id) }}/$value",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 10,
              "batchInterval": 500
            }
          },
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "EolDENntQmcAHoSi",
          "name": "Microsoft Outlook account"
        }
      }
    },
    {
      "id": "c957d3d1-efe4-4284-80ba-a3f96ce343a2",
      "name": "Name Files And Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const meta = $('Keep MyImage Scan Emails').all();\nconst items = $input.all();\nconst binary = {};\nconst keys = [];\nconst used = {};\nconst rows = [['path', 'type', 'language', 'account', 'received_utc', 'from', 'to', 'subject']];\n\nfunction emailType(m) {\n  const from = ((m.from && m.from.emailAddress && m.from.emailAddress.address) || '').toLowerCase();\n  const html = (m.body && m.body.content) || '';\n  if (from.startsWith('orders@')) return '05_edited-image-reminders';\n  if (html.includes('credentials-table')) return '01_welcome';\n  if (html.includes('billing-section')) return '02_payment-confirmation';\n  if (html.includes('details-table')) return '06_credits-purchase';\n  if (html.includes('password-display')) return '03_password-reset';\n  return '04_subscription-cancelled';\n}\n\nfor (let i = 0; i < items.length; i++) {\n  const m = meta[i].json;\n  const to = (m.toRecipients || []).map(r => r.emailAddress.address).join(';');\n  const mt = to.match(/\\+myimage-([a-z0-9]+)@/i);\n  const account = mt ? mt[1].toLowerCase() : 'unknown';\n  const lang = account.replace(/[0-9]+$/, '');\n  const time = (m.receivedDateTime || '').slice(11, 19).replace(/:/g, '');\n  const fromAddr = (m.from && m.from.emailAddress && m.from.emailAddress.address) || '';\n  const type = emailType(m);\n  const base = type + '/' + lang + '_' + time + '_' + account;\n  let name = base + '.eml';\n  let n = 2;\n  while (used[name]) { name = base + '_' + n + '.eml'; n += 1; }\n  used[name] = true;\n  const b = items[i].binary.data;\n  b.fileName = name;\n  b.mimeType = 'message/rfc822';\n  b.fileExtension = 'eml';\n  const key = 'email_' + i;\n  binary[key] = b;\n  keys.push(key);\n  rows.push([name, type, lang, account, m.receivedDateTime, fromAddr, to, m.subject]);\n}\nrows.sort((a, b) => a === rows[0] ? -1 : b === rows[0] ? 1 : a[0].localeCompare(b[0]));\nconst csv = rows.map(r => r.map(v => '\"' + String(v === undefined || v === null ? '' : v).replace(/\"/g, '\"\"') + '\"').join(',')).join('\\r\\n');\nbinary.manifest = await this.helpers.prepareBinaryData(Buffer.from('\\ufeff' + csv, 'utf8'), 'manifest.csv', 'text/csv');\nkeys.push('manifest');\nreturn [{ json: { emailCount: items.length, binaryKeys: keys.join(',') }, binary }];"
      }
    },
    {
      "id": "fffdf61e-4a4b-4002-95f0-f4696982dd2d",
      "name": "Zip Emails",
      "type": "n8n-nodes-base.compression",
