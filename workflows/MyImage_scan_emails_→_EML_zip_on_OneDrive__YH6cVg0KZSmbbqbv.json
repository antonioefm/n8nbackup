{
  "id": "YH6cVg0KZSmbbqbv",
  "name": "MyImage scan emails → EML zip on OneDrive",
  "description": "Exports one day's MyImage scan emails (maria+myimage-<locale>) from Outlook as .eml files, zips them with a manifest, uploads to OneDrive and shares.",
  "active": false,
  "activeVersionId": null,
  "createdAt": "2026-11-15T12:31:08.161Z",
  "updatedAt": "2026-11-15T12:32:52.621Z",
