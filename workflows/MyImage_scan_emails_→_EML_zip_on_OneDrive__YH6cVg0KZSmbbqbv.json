        "operation": "share",
        "fileId": "={{ $json.id }}",
        "type": "view",
        "scope": "organization"
      },
      "credentials": {
        "microsoftOneDriveOAuth2Api": {
          "id": "QCA5rX8Iyd1rbChu",
          "name": "Microsoft Drive - Maria Sica account"
        }
      }
    },
    {
      "id": "ec05476d-dab3-4479-aace-48679d2f0797",
      "name": "Sticky Note 8d9480f1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        192,
        208
      ],
      "parameters": {
        "content": "## MyImage scan emails → .eml zip\nEdit **Scan Settings** (UTC day, sender domain, recipient tag, zip name) and run. Pulls every email from @myimage.io to a maria+myimage-<locale> test account on that day, saves each as .eml named <locale>_<HHMMSS>_<sender>.eml plus manifest.csv, zips them and uploads to OneDrive root with an org view link.",
        "color": 4,
        "width": 160,
        "height": 224
      }
    }
