    {
      "id": "d320cb6c-e4c1-4222-bdf3-53ddab57a324",
      "name": "Reduce",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4256,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst accounts = [\n  [\"ZD_pdf\", \"PDF Zendesk account\"],\n  [\"ZD_myimage\", \"MyImage prod Zendesk account\"],\n  [\"ZD_unicopy\", \"Unicopy Zendesk account\"],\n  [\"ZD_lovestyle\", \"LoveStyle prod Zendesk account\"],\n  [\"ZD_realchecker\", \"Realchecker Zendesk account\"],\n  [\"ZD_brainiqtest\", \"BrainIQTest Zendesk account\"],\n  [\"ZD_mindspree\", \"Mindspree prod\"],\n  [\"ZD_scannerly\", \"Scannerly Zendesk account\"],\n  [\"ZD_wapp\", \"WAPP Zendesk account\"],\n  [\"ZD_chatbotonline\", \"Chatbotonline Zendesk account\"],\n  [\"ZD_vinready\", \"Vinready Zendesk account\"],\n  [\"ZD_qrcreate\", \"QR Create Zendesk account\"],\n  [\"ZD_lovelanguage\", \"LoveLanguage Zendesk account\"],\n  [\"ZD_resumewise\", \"Resumewise Zendesk account\"],\n  [\"ZD_myqrcode\", \"MyQRCode Zendesk account\"],\n  [\"ZD_devtest\", \"Development test Zendesk account\"],\n  [\"ZD_personality\", \"Personality Zendesk prod account\"],\n  [\"ZD_mobitrace\", \"Mobitrace Zendesk account\"]\n];\nconst out = [];\nfor (const a of accounts) {\n  const nodeName = a[0];\n  const label = a[1];\n  let items = [];\n  let err = \"\";\n  try {\n    items = $(nodeName).all();\n  } catch (e) {\n    err = String((e && e.message) || e);\n  }\n  if (err) {\n    out.push({ json: { account: label, node: nodeName, fetch_error: err } });\n    continue;\n  }\n  let counted = 0;\n  for (const it of items) {\n    const j = (it && it.json) || {};\n    if (!j.id) continue;\n    let sub = \"\";\n    if (typeof j.url === \"string\") {\n      const parts = j.url.split(\"//\");\n      if (parts.length > 1) { sub = parts[1].split(\".\")[0]; }\n    }\n    counted = counted + 1;\n    out.push({ json: {\n      account: label,\n      node: nodeName,\n      subdomain: sub,\n      user_id: j.id,\n      name: j.name || \"\",\n      email: j.email || \"\",\n      role: j.role || \"\",\n      role_type: j.role_type === undefined || j.role_type === null ? \"\" : j.role_type,\n      custom_role_id: j.custom_role_id === undefined || j.custom_role_id === null ? \"\" : j.custom_role_id,\n      active: j.active === undefined ? \"\" : j.active,\n      suspended: j.suspended === undefined ? \"\" : j.suspended,\n      verified: j.verified === undefined ? \"\" : j.verified,\n      restricted_agent: j.restricted_agent === undefined ? \"\" : j.restricted_agent,\n      default_group_id: j.default_group_id === undefined || j.default_group_id === null ? \"\" : j.default_group_id,\n      last_login_at: j.last_login_at || \"\",\n      created_at: j.created_at || \"\",\n      time_zone: j.time_zone || \"\"\n    } });\n  }\n  if (counted === 0) {\n    out.push({ json: { account: label, node: nodeName, fetch_error: \"no staff users returned\" } });\n  }\n}\nreturn out;\n"
      },
      "executeOnce": true
    }
  ],
