    {
      "id": "b97b88a0-8da7-4dea-80ec-9b5edbf3d8d0",
      "name": "Find EN Updated Today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let keys = [];\nfor (const n of ['Keys Page 1', 'Keys Page 2', 'Keys Page 3']) { const r = $(n).first().json; if (r.body && r.body.keys) { keys = keys.concat(r.body.keys); } }\nconst today = '2026-10-27';\nconst hits = [];\nfor (const k of keys) {\n  const n = (k.key_name && typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other) : k.key_name;\n  for (const t of (k.translations || [])) {\n    if (t.language_iso !== 'en') { continue; }\n    if (String(t.modified_at || '').slice(0, 10) !== today) { continue; }\n    if (String(k.created_at || '').slice(0, 10) === today) { continue; }\n    const others = {};\n    for (const o of (k.translations || [])) { if (o.language_iso !== 'en') { others[o.language_iso] = { text: o.translation, modified: o.modified_at, unverified: o.is_unverified }; } }\n    hits.push({ key: n, key_id: k.key_id, created: k.created_at, en: t.translation, en_modified: t.modified_at, en_modified_by: t.modified_by_email, tags: k.tags, description: k.description, targets: others });\n  }\n}\nreturn [{ json: { total_keys: keys.length, count: hits.length, hits: hits } }];\n"
      }
    }
  ],
