    {
      "id": "77a0a659-8733-4388-abd0-b3c4ba50a536",
      "name": "Grep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TERMS = ['nat3092','statdec','su001','su580','nat-3092','statutory-declaration','disclaimerAto','disclaimerAustralianGovernment','disclaimerServicesAustralia','quickLinks','instruction','rotate'];\nconst prs = $('Pick PRs').all();\nconst res = $input.all();\nconst prOut = [];\nconst matches = [];\nfor (let i = 0; i < res.length; i++) {\n  const pr = prs[i] ? prs[i].json : {};\n  if (pr.skip) { prOut.push(pr); continue; }\n  const files = Array.isArray(res[i].json.body) ? res[i].json.body : [];\n  let hits = 0;\n  for (const f of files) {\n    const lines = (f.patch || '').split('\\n');\n    for (let j = 0; j < lines.length; j++) {\n      const ln = lines[j];\n      if (ln.charAt(0) !== '+') { continue; }\n      const low = ln.toLowerCase();\n      let t = null;\n      for (const x of TERMS) { if (low.indexOf(x.toLowerCase()) >= 0) { t = x; break; } }\n      if (!t) { continue; }\n      hits++;\n      if (matches.length < 600) { matches.push({ pr: pr.number, repo: pr.repo, file: f.filename, term: t, line: ln.slice(0, 220) }); }\n    }\n  }\n  prOut.push({ repo: pr.repo, number: pr.number, title: pr.title, head: pr.head, state: pr.state, merged_at: pr.merged_at, url: pr.url, updated_at: pr.updated_at, user: pr.user, files: files.length, file_names: files.map(function (f) { return f.filename; }).slice(0, 80), hits: hits, body: pr.body });\n}\nconst lp = $('Lokalise Project').first().json;\nreturn [{ json: { lokalise_project: { name: lp.name, id: lp.project_id, base: lp.base_language_iso }, prs: prOut, matches: matches } }];"
      }
    }
  ],
