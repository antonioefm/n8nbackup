    {
      "id": "a16468a9-b99e-4fb5-ab7d-33a6421781b5",
      "name": "Pick PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nconst reqs = $('Repos').all();\nconst res = $input.all();\nfor (let i = 0; i < res.length; i++) {\n  const r = res[i].json;\n  const repo = (reqs[i] && reqs[i].json.repo) || '?';\n  const prs = Array.isArray(r.body) ? r.body : [];\n  for (const p of prs) {\n    if ((p.updated_at || '') < '2026-10-12') { continue; }\n    out.push({ json: { repo: repo, number: p.number, title: p.title, head: p.head && p.head.ref, base: p.base && p.base.ref, state: p.state, merged_at: p.merged_at, url: p.html_url, updated_at: p.updated_at, created_at: p.created_at, user: p.user && p.user.login, body: (p.body || '').slice(0, 600) } });\n  }\n  if (prs.length === 0) { out.push({ json: { repo: repo, number: 0, status: r.statusCode, skip: true } }); }\n}\nreturn out;"
      }
    },
