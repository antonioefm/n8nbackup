      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const files = ($input.first().json.files || []);\nif (!files.length) { throw new Error('No spreadsheets found in the audit folder'); }\nreturn files.map(function (f) { return { json: { id: f.id, name: f.name } }; });"
