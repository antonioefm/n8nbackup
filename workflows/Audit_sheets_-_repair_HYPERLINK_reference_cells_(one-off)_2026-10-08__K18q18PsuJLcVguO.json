    {
      "id": "a447388a-628a-4a17-b6b8-b772609cedca",
      "name": "Plan link fixes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Replace every =HYPERLINK(\"url\",\"label\") cell with the label as text + a link (locale-independent).\nconst RX = /^=HYPERLINK\\(\\s*\"((?:[^\"]|\"\")*)\"\\s*[,;]\\s*\"((?:[^\"]|\"\")*)\"\\s*\\)$/i;\nconst out = [];\nfor (const it of $input.all()) {\n  const s = it.json || {};\n  const reqs = [];\n  for (const sh of (s.sheets || [])) {\n    const sid = sh.properties.sheetId;\n    for (const d of (sh.data || [])) {\n      const r0 = d.startRow || 0, c0 = d.startColumn || 0;\n      (d.rowData || []).forEach(function (row, ri) {\n        (row.values || []).forEach(function (v, ci) {\n          const f = v && v.userEnteredValue && v.userEnteredValue.formulaValue;\n          if (!f) { return; }\n          const m = String(f).trim().match(RX);\n          if (!m) { return; }\n          const url = m[1].split('\"\"').join('\"');\n          const label = m[2].split('\"\"').join('\"') || url;\n          reqs.push({ updateCells: { start: { sheetId: sid, rowIndex: r0 + ri, columnIndex: c0 + ci }, rows: [{ values: [{ userEnteredValue: { stringValue: label }, textFormatRuns: [{ startIndex: 0, format: { link: { uri: url } } }] }] }], fields: 'userEnteredValue,textFormatRuns' } });\n        });\n      });\n    }\n  }\n  if (reqs.length) { out.push({ json: { spreadsheetId: s.spreadsheetId, title: (s.properties || {}).title, cells: reqs.length, body: { requests: reqs } } }); }\n}\nreturn out;"
      }
    },
