      "name": "Read cells",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.id }}?fields=spreadsheetId,properties.title,sheets(properties(sheetId,title),data(startRow,startColumn,rowData(values(userEnteredValue))))",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
