      "name": "Glossary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = []; let keys = [];\nfor (const it of $input.all()) { const b = it.json.body || it.json; keys = Object.keys(b); const terms = b.data || b.terms || [];\n  for (const t of terms) { out.push({ term: t.term, d: t.description, tr8: t.translatable, cs: t.caseSensitive, tags: t.tags, t: (t.translations || []).filter(function (x) { return x.translation; }).map(function (x) { return [x.langId, x.translation]; }) }); } }\nreturn [{ json: { gl_marker: 1, pages: $input.all().length, body_keys: keys, count: out.length, terms: out } }];"
      }
    }
