    {
      "id": "be5e1309-2dd2-46b9-9ddf-8bda5722268c",
      "name": "Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = []; let scanned = 0;\nfor (const it of $input.all()) { const r = it.json;\n  for (const k of ((r.body && r.body.keys) || [])) { if (k.is_archived) { continue; } scanned++;\n    const name = (k.key_name && k.key_name.web) || ''; let en = ''; const tr = {}; let n = 0;\n    for (const t of (k.translations || [])) { if (t.language_iso === 'en') { en = t.translation; continue; } if (t.translation && String(t.translation).trim()) { tr[t.language_iso] = t.translation; n++; } }\n    if (n < 6 || !en || en.length > 200) { continue; }\n    out.push({ name: name, en: en, tr: tr }); } }\nreturn [{ json: { ctx_marker: 1, scanned: scanned, count: out.length, keys: out } }];"
      }
    },
    {
      "id": "2d4e9b3f-5d6a-465c-95e4-e91e160d4f8d",
