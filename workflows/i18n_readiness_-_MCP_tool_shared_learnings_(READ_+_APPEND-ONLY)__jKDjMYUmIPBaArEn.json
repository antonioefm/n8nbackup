    {
      "id": "bc87f87b-fe1e-4610-a62b-b923d1f95611",
      "name": "Active learnings for product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const vals = $input.first().json.values || [];\nconst head = (vals[0] || []).map(h => String(h).trim());\nconst want = String($('Receive request').first().json.product || '').trim().toLowerCase();\nconst toDate = v => (typeof v === 'number' || /^\\d{5}$/.test(String(v))) ? new Date(Date.UTC(1899, 11, 30) + Number(v) * 86400000).toISOString().slice(0, 10) : String(v);\nconst out = [];\nfor (let i = 1; i < vals.length; i++) {\n  const r = {}; head.forEach((h, j) => r[h] = vals[i][j] === null || vals[i][j] === undefined ? '' : String(vals[i][j]).trim());\n  if (!r['Finding pattern'] && !r['Reason']) continue;\n  if ((r['Status'] || 'Active').toLowerCase() === 'retired') continue;\n  const scope = (r['Scope'] || 'Product').toLowerCase();\n  if (want && scope !== 'global' && (r['Product'] || '').toLowerCase() !== want) continue;\n  out.push({ row: i + 1, date: r['Date'] ? toDate(r['Date']) : '', product: r['Product'], check: r['Check'], finding_pattern: r['Finding pattern'], decision: r['Decision'], reason: r['Reason'], scope: r['Scope'] || 'Product', decided_by: r['Decided by'], source_workbook: r['Source workbook'] });\n}\nreturn [{ json: { count: out.length, product: want || 'all', learnings: out, note: 'Shared learnings from every i18n-readiness run (SHARED COMPANY FOLDER I18N/AI AUDITS/i18n readiness learnings.xlsx). Apply them before reporting: skip findings matching a Rejected learning, keep Rules.' } }];"
      }
    },
    {
      "id": "82d69b4b-5b18-48ea-984e-509c79ffcba9",
      "name": "Validate and clean rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "jsCode": "let rows;\ntry { rows = JSON.parse($input.first().json.rows || '[]'); } catch (e) { throw new Error('rows must be a JSON array string'); }\nif (!Array.isArray(rows) || rows.length === 0) throw new Error('rows must be a non-empty JSON array');\nif (rows.length > 50) throw new Error('max 50 rows per call');\nconst clean = (v, max) => { let s = String(v === undefined || v === null ? '' : v).replace(/[\\r\\n\\t]+/g, ' ').trim().slice(0, max); if (/^[=+\\-@]/.test(s)) s = \"'\" + s; return s; };\nconst today = new Date().toISOString().slice(0, 10);\nconst values = rows.map((r, i) => {\n  const d = clean(r.decision, 20);\n  if (!['Rejected', 'Approved'].includes(d)) throw new Error('row ' + (i + 1) + ': decision must be Rejected or Approved');\n  for (const k of ['product', 'check', 'finding_pattern', 'reason']) if (!clean(r[k], 10)) throw new Error('row ' + (i + 1) + ': ' + k + ' is required');\n  return [today, clean(r.product, 60), clean(r.check, 80), clean(r.finding_pattern, 500), d, clean(r.reason, 500), 'Product', clean(r.decided_by, 80), clean(r.source_workbook, 400), 'Active'];\n});\nreturn [{ json: { values } }];"
      }
    },
