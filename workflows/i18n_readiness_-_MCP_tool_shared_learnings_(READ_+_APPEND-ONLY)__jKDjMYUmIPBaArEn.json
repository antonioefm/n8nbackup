        "url": "https://graph.microsoft.com/v1.0/me/drive/items/01O3V7XRR2CCDQ75BZXZHZ6ORHP5OOMSFI/workbook/tables/Learnings/range?$select=values",
        "authentication": "predefinedCredentialType",
