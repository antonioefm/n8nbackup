    {
      "id": "a3472555-2559-4686-a7e8-157989bcf3eb",
      "name": "Reduce to flow namespaces",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NS = ['auth','pricing','checkout','faq','footer','layout','cancel','subscription','chat','common','legal','nav','header','payment','plan','billing','modal','error'];\nconst rows = [];\nlet seen = 0;\nfor (const item of $input.all()) {\n  for (const k of (item.json.keys || [])) {\n    seen++;\n    const kn = k.key_name || {};\n    const name = kn.web || kn.other || kn.ios || kn.android || String(k.key_name);\n    let en = '', es = '', u = 0, r = 0;\n    for (const t of (k.translations || [])) {\n      if (t.language_iso === 'en') en = t.translation;\n      if (t.language_iso === 'es') { es = t.translation; u = t.is_unverified ? 1 : 0; r = t.is_reviewed ? 1 : 0; }\n    }\n    const head = String(name).split('::')[0].toLowerCase();\n    let hit = false;\n    for (const n of NS) { if (head.indexOf(n) !== -1) { hit = true; break; } }\n    if (!hit) continue;\n    rows.push({ k: name, en: String(en).slice(0, 400), es: String(es).slice(0, 400), u: u, r: r, t: (k.tags || []).join(',') });\n  }\n}\nreturn [{ json: { keys_seen: seen, rows_kept: rows.length, rows: rows } }];"
      }
    }
  ],
