    {
      "id": "5888f3ac-10b9-4fc4-963a-f25601877994",
      "name": "Pick Project",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = [];\nfor (const it of items) { for (const p of (it.json.projects || [])) { all.push({ project_id: p.project_id, name: p.name, base: p.base_language_iso }); } }\nconst hits = all.filter(function (p) { const n = p.name.toLowerCase(); return n.indexOf('mobitrace') >= 0; });\nconst front = hits.filter(function (p) { const n = p.name.toLowerCase(); return n.indexOf('front') >= 0 || n.indexOf('fe') >= 0 || n.indexOf('web') >= 0; });\nconst chosen = front.length === 1 ? front[0] : (hits.length === 1 ? hits[0] : (front[0] || hits[0] || null));\nif (!chosen) { return [{ json: { error: 'no mobitrace project found', all_project_names: all.map(function (p) { return p.name; }) } }]; }\nreturn [{ json: { project_id: chosen.project_id, project_name: chosen.name, base: chosen.base, mobitrace_candidates: hits, total_projects: all.length } }];\n"
      }
    },
