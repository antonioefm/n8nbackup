    {
      "id": "6aed85a7-bd13-4f18-80be-ff7559db79bc",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const proj = $('Pick Project').first().json;\nconst langsRaw = $('Fetch Languages').all();\nconst contribRaw = $('Fetch Contributors').all();\n\nconst langs = [];\nfor (const it of langsRaw) { for (const l of ((it.json || {}).languages || [])) { langs.push({ lang_id: l.lang_id, lang_iso: l.lang_iso, lang_name: l.lang_name }); } }\n\nconst contribs = [];\nfor (const it of contribRaw) { for (const c of ((it.json || {}).contributors || [])) {\n  const isos = [];\n  for (const l of (c.languages || [])) { isos.push(l.lang_iso); }\n  contribs.push({ user_id: c.user_id, email: c.email, fullname: c.fullname, is_admin: c.is_admin, is_reviewer: c.is_reviewer, langs: isos });\n} }\n\nconst greek = langs.filter(function (l) { const i = (l.lang_iso || '').toLowerCase(); return i === 'el' || i.indexOf('el_') === 0 || i.indexOf('el-') === 0; });\nconst greekPeople = contribs.filter(function (c) { return c.is_admin || c.langs.some(function (i) { return (i || '').toLowerCase().indexOf('el') === 0; }); });\n\nreturn [{ json: {\n  project: proj,\n  greek_languages: greek,\n  all_language_isos: langs.map(function (l) { return l.lang_iso; }),\n  language_count: langs.length,\n  contributor_count: contribs.length,\n  greek_contributors: greekPeople,\n  all_contributors: contribs\n}}];\n"
      }
    }
