    {
      "id": "fce1d62f-4966-47ed-84e4-a635ce5d667f",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Fetch Project').first().json;\nconst r = $input.first().json;\nconst keys = (r.body && r.body.keys) ? r.body.keys : [];\nconst base = (p.base_language_iso || 'en');\nconst out = keys.map(function (k) {\n  let src = '';\n  for (const t of (k.translations || [])) { if (t.language_iso === base) { src = t.translation; } }\n  let name = k.key_name;\n  if (name && typeof name === 'object') { name = name.web || name.other || name.ios || name.android || JSON.stringify(name); }\n  return { key: name, created: k.created_at, tags: k.tags, file: k.filenames, desc: k.description, source: String(src).slice(0, 200) };\n});\nout.sort(function (a, b) { return String(b.created).localeCompare(String(a.created)); });\nreturn [{ json: { project_name: p.name, project_desc: p.description, base: base, status: r.statusCode, total: (r.headers || {})['x-pagination-total-count'], keys: out } }];\n"
      }
    }
