      "id": "166d94f9-f985-4bd8-8002-220e219ef90e",
      "name": "Zendesk: Get both tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        560,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "zendeskApi": {
          "id": "hIIPIHet7ZHtczDq",
          "name": "Chatbotonline Zendesk account"
        }
