    {
      "id": "5bdf5f8e-bffd-44f8-b8ce-1caefaf08f96",
      "name": "Generate page list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const h = $input.first().json.headers || {};\nconst total = Number(h['x-pagination-total-count'] || 0);\nif (!total) { throw new Error('No pagination header'); }\nconst limit = 500;\nconst pages = Math.ceil(total / limit);\nconst langs = [767, 737, 10154, 673, 666, 757, 734, 733, 10153, 10152, 760, 748, 708, 770, 1056, 754];\nconst out = [];\nfor (const lid of langs) {\n  for (let p = 1; p <= pages; p++) { out.push({ json: { lang_id: lid, page: p, limit: limit } }); }\n}\nreturn out;"
      }
    },
    {
      "id": "cf7b0da9-8da6-4009-aec6-8fbd2b49afb0",
      "name": "Build corrections",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pages = $input.all();\nconst agg = {};\nfor (const p of pages) {\n  const j = p.json;\n  if (!j.iso || !j.counts) { continue; }\n  if (!agg[j.iso]) { agg[j.iso] = { iso: j.iso, mt_rows: 0, other_rows: 0, counts: {}, tids: {} }; }\n  const a = agg[j.iso];\n  a.mt_rows = a.mt_rows + (j.mt_rows || 0);\n  a.other_rows = a.other_rows + (j.other_rows || 0);\n  for (const k in j.counts) { a.counts[k] = (a.counts[k] || 0) + j.counts[k]; }\n  for (const k in j.tids) {\n    if (!a.tids[k]) { a.tids[k] = []; }\n    for (const v of j.tids[k]) { if (a.tids[k].length < 12) { a.tids[k].push(v); } }\n  }\n}\nconst out = [];\nfor (const iso in agg) {\n  const a = agg[iso];\n  const vocab = [];\n  for (const k in a.counts) { vocab.push([k, a.counts[k], a.tids[k] || []]); }\n  vocab.sort(function (x, y) { return y[1] - x[1]; });\n  out.push({ json: { iso: iso, mt_rows: a.mt_rows, other_rows: a.other_rows, distinct_tokens: vocab.length, vocab: vocab } });\n}\nreturn out;"
      }
    },
    {
