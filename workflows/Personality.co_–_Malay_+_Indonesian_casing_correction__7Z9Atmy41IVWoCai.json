      "waitBetweenTries": 3000,
      "disabled": true
    },
    {
      "id": "acd76405-b2c9-4e52-a87b-a39d8e4271e5",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nlet n = 0;\nfor (const it of items) { if (it.json.translation) { n = n + 1; } }\nconst plan = $(\"Build corrections\").all();\nlet remaining = 0;\nif (plan.length) { remaining = plan[0].json.remaining_after_this_run; }\nreturn [{ json: { corrected: n, remaining_after_this_run: remaining } }];"
      }
    },
    {
      "id": "3a2827cc-35d8-4bc2-81ee-98d422a8bbdf",
      "name": "Fetch translations page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/31393214664f295f94dd86.76792605/translations?disable_references=1&filter_lang_id={{ $json.lang_id }}&limit={{ $json.limit }}&page={{ $json.page }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "VW7WtJP8PzJMR813",
          "name": "Lokalise read-only"
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 4000
    },
    {
      "id": "a060a08c-97e4-475d-9c55-25bd912a9d37",
      "name": "Compact page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = $input.first().json.translations;\nif (!Array.isArray(t)) { throw new Error('No translations array'); }\n\nfunction tokens(s) {\n  let x = String(s);\n  x = x.replace(/<[^>]*>/g, ' ');\n  x = x.replace(/\\{[^}]*\\}/g, ' ');\n  x = x.replace(/\\[%[^\\]]*\\]/g, ' ');\n  x = x.replace(/%\\d*\\$?[sd]/g, ' ');\n  x = x.replace(/https?:\\/\\/\\S+/g, ' ');\n  x = x.replace(/\\S+@\\S+/g, ' ');\n  const m = x.match(/[\\p{L}]+(?:['\\u2019\\u2011-][\\p{L}]+)*/gu);\n  return m || [];\n}\n\nlet iso = '';\nconst counts = {};\nconst tids = {};\nlet mtRows = 0;\nlet otherRows = 0;\nfor (const x of t) {\n  iso = x.language_iso;\n  const val = x.translation === null || x.translation === undefined ? '' : String(x.translation);\n  if (val.trim() === '') { continue; }\n  let mt = 0;\n  if (Array.isArray(x.custom_translation_statuses)) {\n    for (const s of x.custom_translation_statuses) { if (s.status_id === 29251) { mt = 1; } }\n  }\n  if (mt !== 1) { otherRows = otherRows + 1; continue; }\n  mtRows = mtRows + 1;\n  const seen = {};\n  for (const w of tokens(val)) {\n    const lc = w.toLowerCase();\n    if (lc.length < 3) { continue; }\n    counts[lc] = (counts[lc] || 0) + 1;\n    if (seen[lc]) { continue; }\n    seen[lc] = 1;\n    if (!tids[lc]) { tids[lc] = []; }\n    if (tids[lc].length < 3) { tids[lc].push(x.translation_id); }\n  }\n}\nreturn [{ json: { iso: iso, mt_rows: mtRows, other_rows: otherRows, counts: counts, tids: tids } }];"
      }
    },
