      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Read-back.\nconst key = ($('Get key').first().json.body || {}).key || {};\nconst es = (key.translations || []).find(t => t.language_iso === 'es') || {};\nconst terms = []; for (const it of $input.all()) { const b = it.json.body || {}; for (const t of (b.data || b.glossary_terms || [])) terms.push(t); }\nconst hit = terms.filter(t => String(t.term).trim().toLowerCase() === 'legal').map(t => ({ id: t.id, term: t.term, desc: t.description, tags: t.tags, tr: (t.translations || []).filter(x => x.translation).map(x => x.langIso + '=' + x.translation) }));\nreturn [{ json: { plan: { es_now: es.translation, es_unverified: es.is_unverified, es_fuzzy: es.is_fuzzy, glossary: hit }, skip: true } }];\n"
      }
    },
