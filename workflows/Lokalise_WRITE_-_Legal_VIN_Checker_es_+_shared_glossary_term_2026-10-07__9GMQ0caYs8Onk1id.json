        "jsCode": "// MODE: 'check' = read + plan only; 'all' = perform both writes. DONE 2026-10-07 (term 7384723) — keep on check.\nconst MODE = 'check';\nconst VIN = '2944050668d5010cbd95e8.36175908'; const KEY = 894212362; const TID = 9138735925;\nconst GLOSS = '46552447679363c70f7ef8.58193285';\nconst T = { es:[1056,'Legal'] };\nconst term = { term: 'Legal', translations: [] };\nreturn [{ json: { MODE, VIN, KEY, TID, GLOSS, term, keyUrl: 'https://api.lokalise.com/api2/projects/' + VIN + '/keys/' + KEY + '?disable_references=1', glossUrl: 'https://api.lokalise.com/api2/projects/' + GLOSS + '/glossary-terms?limit=500' } }];\n"
