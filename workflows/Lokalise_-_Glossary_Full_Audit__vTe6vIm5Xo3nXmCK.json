    {
      "id": "fbc66cf1-1d4e-44bd-b10a-483c1cdd25c2",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const MINE = [\"Chatbot Online\",\"CHATBOT ONLINE LLC\",\"ChatGPT\",\"Claude\",\"DeepSeek\",\"Gemini\",\"Grok\",\"Norton\",\"OpenAI\",\"Premium\",\"PRO\",\"use.ai\",\"bank statement\",\"billing period\",\"chat\",\"checkout\",\"clipboard\",\"contact\",\"conversation\",\"copy\",\"create\",\"credentials\",\"feature\",\"file\",\"free trial\",\"image style\",\"model\",\"payment method\",\"project\",\"prompt\",\"receipt\",\"refund\",\"rename\",\"send\",\"start chatting\",\"support\",\"trial\"];\nconst norm = (s) => String(s || '').trim().toLowerCase().replace(/\\s+/g, ' ');\nconst seenPage = new Set();\nconst all = [];\nconst pageInfo = [];\nfor (const nm of ['Page A','Page B','Page C','Page D']) {\n  let arr = [];\n  try { arr = $(nm).all(); } catch (e) { pageInfo.push(nm + ': unavailable'); continue; }\n  for (const it of arr) {\n    const j = it.json || {};\n    const terms = Array.isArray(j.data) ? j.data : [];\n    const m = j.meta || {};\n    pageInfo.push(nm + ': ' + terms.length + ' items, cursor=' + m.cursor + ', next=' + m.nextCursor + ', hasMore=' + m.hasMore);\n    for (const t of terms) {\n      if (t && t.id && !seenPage.has(t.id)) { seenPage.add(t.id); all.push(t); }\n    }\n  }\n}\nconst byTerm = new Map();\nfor (const t of all) {\n  const n = norm(t.term);\n  if (!byTerm.has(n)) byTerm.set(n, []);\n  byTerm.get(n).push({ id: t.id, term: t.term, tags: (t.tags || []).join('/') });\n}\nconst realDupes = [];\nfor (const [n, list] of byTerm) if (list.length > 1) realDupes.push({ term: n, entries: list });\nconst mineStatus = MINE.map(m => {\n  const list = byTerm.get(norm(m)) || [];\n  return m + ' -> ' + list.length + (list.length ? ' [' + list.map(x => x.id + ':' + (x.tags || 'untagged')).join(' , ') + ']' : ' MISSING');\n});\nreturn [{ json: {\n  pages: pageInfo,\n  unique_terms_fetched: all.length,\n  distinct_normalised: byTerm.size,\n  real_duplicate_groups: realDupes.length,\n  real_duplicates: realDupes.slice(0, 60),\n  my_terms_status: mineStatus\n} }];\n"
      }
    }
  ],
