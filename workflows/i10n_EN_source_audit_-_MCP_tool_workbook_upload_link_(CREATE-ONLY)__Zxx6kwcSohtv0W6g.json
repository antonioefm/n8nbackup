        "nodeCredentialType": "microsoftOneDriveOAuth2Api",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"item\":{\"@microsoft.graph.conflictBehavior\":\"rename\"}}",
        "options": {
          "timeout": 60000
        }
      },
