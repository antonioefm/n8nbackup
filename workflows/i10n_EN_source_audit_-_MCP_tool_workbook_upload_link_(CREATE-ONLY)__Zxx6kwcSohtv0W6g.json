    {
      "id": "a08486f3-ebb8-456d-ae8a-7c90a8384797",
      "name": "Validate file name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// CREATE-ONLY. Validates the workbook name and builds the Graph upload-session URL.\nconst name = String(($input.first().json || {}).file_name || '').trim();\nif (!name) { throw new Error('file_name is required, e.g. \"03.11.26 Chat AI.xlsx\"'); }\nif (!/[.]xlsx$/i.test(name)) { throw new Error('file_name must end in .xlsx'); }\nif (/[\\/\\\\:*?\"<>|#%]/.test(name) || name.length > 180 || name.indexOf('..') !== -1) {\n  throw new Error('file_name contains characters OneDrive does not allow or is too long');\n}\nconst folder = ['ENGLISH SOURCE', 'AI source audits'].map(encodeURIComponent).join('/');\nconst url = 'https://graph.microsoft.com/v1.0/me/drive/root:/' + folder + '/' + encodeURIComponent(name) + ':/createUploadSession';\nreturn [{ json: { file_name: name, url: url } }];\n"
      }
    },
    {
      "id": "ecea76a6-d590-418d-89b0-f13099134d87",
