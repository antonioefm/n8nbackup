        "httpHeaderAuth": {
          "id": "4cb6G6nZVVtP4HIO",
          "name": "Lokalise access token read-write"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "887803ef-fcfb-41cc-9aa3-3f9c9df7fb24",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json || {};\nconst b = r.body || {};\nconst rows = [];\nfor (const k of (b.keys || [])) { rows.push({ key_id: k.key_id, name: (k.key_name || {}).web || k.key_name }); }\nreturn [{ json: { status: r.statusCode, created: rows, errors: b.errors || null, raw: rows.length ? null : JSON.stringify(b).slice(0, 400) } }];\n"
      }
    }
  ],
