    {
      "id": "557eecf8-197e-420a-905c-d83c28dcba0b",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const PID = '14240418673f52ae29a007.74392007'; // Mobitrace\n// NOTE: on POST /keys, key_name must be a STRING. GET returns it as a per-platform object,\n// but sending that object back gets `key_name parameter should be a string` 400.\nconst KEY = 'zz::claude::automation_probe_070926';\nconst EN = 'Your parcel is on its way and should arrive within two working days.';\nreturn [{ json: { url: 'https://api.lokalise.com/api2/projects/' + PID + '/keys', body: { keys: [ { key_name: KEY, platforms: ['web'], tags: ['zz_temp_probe'], translations: [ { language_iso: 'en', translation: EN } ] } ] } } }];\n"
      }
    },
    {
      "id": "689d4a1d-c025-4344-a423-0f3fc00ee60f",
      "name": "Create Key",
      "type": "n8n-nodes-base.httpRequest",
