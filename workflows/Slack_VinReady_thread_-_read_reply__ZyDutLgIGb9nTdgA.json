{
  "id": "ZyDutLgIGb9nTdgA",
  "name": "Slack VinReady thread - read / reply",
  "description": "Reads a Lokalise push thread in the vinready Slack workspace and, in reply mode, posts the trace reply (skipped if a reply already names the ticket). Needs the 'Slack VinReady bot' credential.",
  "active": false,
  "activeVersionId": null,
  "createdAt": "2026-11-04T13:35:16.966Z",
  "updatedAt": "2026-11-04T13:51:56.472Z",
  "isArchived": false,
  "versionId": "602a7208-aa4a-4824-9b99-b48b9834480c",
  "versionCounter": 9,
  "sourceWorkflowId": null,
  "triggerCount": 0,
  "nodes": [
    {
      "parameters": {},
      "id": "e96f227a-4f7c-4d07-a0cc-297d77d8400d",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// EDIT ME for each run.\n// mode 'read' = read the thread only; 'reply' = post reply_text or each of reply_texts (in order) in the thread.\n// ticket: if set, nothing is posted when a reply already names it. Messages already in the thread are skipped.\nreturn [{ json: {\n  mode: 'read',\n  channel: 'C09GZHLNFRB',\n  thread_ts: '',\n  ticket: '',\n  reply_texts: []\n} }];"
      },
      "id": "d43b4ada-f7a2-4139-92e4-c606b7576608",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://slack.com/api/conversations.replies?channel={{ $json.channel }}&ts={{ $json.thread_ts }}&limit=200",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "options": {
          "timeout": 60000
        }
      },
      "id": "85096412-d278-41e4-a93a-354d3ad74696",
      "name": "Read Thread",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "credentials": {
        "slackApi": {
          "id": "gZGtWo8Wgg8QvWsx",
          "name": "Slack Vinready bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst r = $('Read Thread').first().json;\nif (!r.ok) throw new Error('Slack error: ' + r.error + ' (is the bot invited to the channel?)');\nconst msgs = (r.messages || []).map(m => ({ ts: m.ts, user: m.user || m.bot_id, text: m.text }));\nif (cfg.mode !== 'reply') return [{ json: { thread: msgs, posted: false } }];\nconst texts = cfg.reply_texts || (cfg.reply_text ? [cfg.reply_text] : []);\nif (!texts.length) throw new Error('reply mode needs reply_text or reply_texts');\nif (cfg.ticket && msgs.slice(1).some(m => (m.text || '').includes(cfg.ticket))) return [{ json: { thread: msgs, posted: false, skipped: 'a reply already names ' + cfg.ticket } }];\nconst existing = msgs.slice(1).map(m => (m.text || '').slice(0, 60));\nconst todo = texts.filter(t => !existing.includes(t.slice(0, 60)));\nif (!todo.length) return [{ json: { thread: msgs, posted: false, skipped: 'all messages already in thread' } }];\nreturn todo.map(t => ({ json: { post: { channel: cfg.channel, thread_ts: cfg.thread_ts, text: t, unfurl_links: false } } }));"
      },
      "id": "742475ef-cb62-4927-8438-bae64237b4c2",
      "name": "Plan Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.post }}",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "92992e9c-4201-4932-96c8-4d133f5e4fa2",
      "name": "Has Reply To Post",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
