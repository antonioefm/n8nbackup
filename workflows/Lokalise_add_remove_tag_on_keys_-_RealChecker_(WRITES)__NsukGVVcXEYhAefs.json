    {
      "id": "cefacfa6-c4ce-4356-8dd9-570a2715ce07",
      "name": "Fetch Before",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/keys?limit=500&filter_key_ids={{ $json.ids.join(\",\") }}",
        "authentication": "genericCredentialType",
