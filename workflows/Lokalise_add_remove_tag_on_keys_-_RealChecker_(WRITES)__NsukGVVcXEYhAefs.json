    },
    {
      "id": "2a0107f3-485a-4432-9da8-037f85dab664",
      "name": "Build Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Config').first().json;\nconst keys = $input.first().json.keys || [];\nconst todo = []; const skipped = [];\nfor (const k of keys) {\n  const t = k.tags || [];\n  if (t.indexOf(c.tag) < 0) { skipped.push({ id: k.key_id, why: 'tag not present' }); continue; }\n  todo.push({ key_id: k.key_id, tags: t.filter(function (x) { return x !== c.tag; }), merge_tags: false });\n}\nconst found = keys.map(function (k) { return k.key_id; });\nconst missing = c.ids.filter(function (i) { return found.indexOf(i) < 0; });\nconst out = [];\nfor (let i = 0; i < todo.length; i += 40) { out.push({ json: { project_id: c.project_id, body: { keys: todo.slice(i, i + 40) }, skipped: skipped, missing: missing } }); }\nif (!out.length) { out.push({ json: { project_id: c.project_id, body: null, skipped: skipped, missing: missing } }); }\nreturn out;"
      }
    },
    {
