        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "89fc928f-04e1-4248-892f-439ea4464f97",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const st = $input.all().map(function (i) { return { status: i.json.statusCode, errors: (i.json.body && i.json.body.errors) || null }; });\nconst c = $('Config').first().json;\nreturn [{ json: { project_id: c.project_id, ids: c.ids, put_results: st } }];"
      }
    },
    {
      "id": "7c584d81-9c08-4e6e-93eb-462c8616abc3",
      "name": "Fetch After",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/keys?limit=500&filter_key_ids={{ $json.ids.join(\",\") }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
