    },
    {
      "id": "9436e4e1-5d52-4233-8399-9eb9a5e5df44",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Config').first().json;\nconst b = {}; for (const k of ($('Fetch Before').first().json.keys || [])) { b[k.key_id] = k.tags || []; }\nconst ok = []; const bad = [];\nfor (const k of ($input.first().json.keys || [])) {\n  const t = k.tags || []; const lost = (b[k.key_id] || []).filter(function (x) { return x !== c.tag && t.indexOf(x) < 0; });\n  if (t.indexOf(c.tag) < 0 && !lost.length) { ok.push(k.key_id); } else { bad.push({ id: k.key_id, still_has_tag: t.indexOf(c.tag) >= 0, lost: lost }); }\n}\nconst bb = $('Build Batches').all().map(function (i) { return i.json; });\nreturn [{ json: { requested: c.ids.length, verified_removed: ok.length, problems: bad, skipped: bb[0].skipped, missing: bb[0].missing, put_results: $('Collect').first().json.put_results } }];"
      }
    }
