      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ids = $('Params').all(); const out = []; const items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  let b64 = '';\n  try { const buf = await this.helpers.getBinaryDataBuffer(i, 'data'); b64 = buf.toString('base64'); } catch (e) { b64 = 'ERR ' + e.message; }\n  out.push({ json: { id: ids[i].json.id, b64: b64 } });\n}\nreturn out;"
      }
    }
