      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const seen=new Set(); const rows=[];\nfor (const it of $input.all()) { const b=it.json; if(!Array.isArray(b.keys)) throw new Error('bad '+JSON.stringify(b).slice(0,200));\n for (const k of b.keys){ if(seen.has(k.key_id)) continue; seen.add(k.key_id);\n  const tag=(k.tags||[]).find(t=>t.startsWith('test_questions::'));\n  const en=(k.translations.find(t=>t.language_iso==='en')||{}).translation;\n  for (const t of k.translations){ if(t.language_iso==='en') continue; rows.push([t.language_iso,t.translation_id,k.key_id,tag,t.modified_by_email,t.translation,en]); } } }\nreturn [{json:{n:rows.length,rows}}];"
      }
    }
