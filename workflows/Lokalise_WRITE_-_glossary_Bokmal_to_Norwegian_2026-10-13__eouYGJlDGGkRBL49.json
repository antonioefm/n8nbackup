      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ONLY = []; // TEST: set to ['term'] to limit\nconst terms = [];\nfor (const it of $input.all()) {\n  const b = it.json.body || {};\n  for (const t of (b.data || [])) terms.push(t);\n}\nconst fix = []; const backup = [];\nfor (const t of terms) {\n  const nb = (t.translations || []).filter(function (x) { return x.langId === 759; });\n  if (nb.length === 0) continue;\n  if (ONLY.length && ONLY.indexOf(t.term) < 0) continue;\n  const no = (t.translations || []).filter(function (x) { return x.langId === 760; })[0];\n  const src = nb[0];\n  const tr = (no && no.translation) ? no.translation : (src.translation || '');\n  const ds = (no && no.description) ? no.description : (src.description || '');\n  backup.push({ id: t.id, term: t.term, translations: t.translations });\n  fix.push({ id: t.id, translations: [{ langId: 760, translation: tr, description: ds }] });\n}\nreturn [{ json: { count: fix.length, body: { terms: fix }, backup: backup, total_terms: terms.length } }];\n"
      }
    },
