    {
      "id": "446f9e30-2c2d-453d-86d2-c20665a05a06",
      "name": "Process",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst action = body.action || 'sample';\nlet keys = [];\nfor (const n of ['Keys Page 1', 'Keys Page 2', 'Keys Page 3']) { const r = $(n).first().json; if (r.body && r.body.keys) { keys = keys.concat(r.body.keys); } }\nfunction nm(k) { const n = k.key_name; return (n && typeof n === 'object') ? (n.web || n.other) : n; }\nif (action === 'sample') {\n  const out = {};\n  for (const k of keys) { const t = {}; let any = false; for (const tr of (k.translations || [])) { t[tr.language_iso] = tr.translation; if (tr.language_iso !== 'en' && tr.translation) { any = true; } } if (any) { out[nm(k)] = t; } }\n  return [{ json: { action: action, total_keys: keys.length, payload: { keys: [] }, sample: out } }];\n}\nconst T = body.translations || {};\nconst upd = []; const skipped = []; const found = {};\nfor (const k of keys) {\n  const n = nm(k); const want = T[n]; if (!want) { continue; }\n  found[n] = 1;\n  const have = {}; for (const tr of (k.translations || [])) { have[tr.language_iso] = tr.translation; }\n  const trs = [];\n  for (const lang in want) { if (have[lang]) { skipped.push(n + '/' + lang); continue; } trs.push({ language_iso: lang, translation: want[lang], is_unverified: true, is_reviewed: false }); }\n  if (trs.length) { upd.push({ key_id: k.key_id, translations: trs }); }\n}\nconst notFound = Object.keys(T).filter(function (x) { return !found[x]; });\nreturn [{ json: { action: action, total_keys: keys.length, payload: { keys: upd }, keys_to_update: upd.length, skipped_existing: skipped, not_found: notFound } }];\n"
      }
    },
