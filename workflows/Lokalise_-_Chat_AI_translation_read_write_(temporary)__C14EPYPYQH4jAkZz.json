      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Process').first().json;\nconst w = $input.first().json;\nif (p.action === 'sample') { return [{ json: { action: 'sample', total_keys: p.total_keys, sample: p.sample } }]; }\nconst b = w.body || {};\nreturn [{ json: { action: 'write', total_keys: p.total_keys, keys_sent: p.keys_to_update, skipped_existing: p.skipped_existing, not_found: p.not_found, status: w.statusCode, updated: (b.keys || []).length, errors: b.errors || b.error || null } }];\n"
      }
