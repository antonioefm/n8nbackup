        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const h = $input.first().json.headers || {};\nconst total = Number(h[\"x-pagination-total-count\"] || 0);\nif (!total) { throw new Error(\"No pagination header: \" + JSON.stringify(h).slice(0, 300)); }\nconst limit = 500;\nconst pages = Math.ceil(total / limit);\nconst out = [];\nfor (let p = 1; p <= pages; p++) { out.push({ json: { page: p, limit: limit, total: total } }); }\nreturn out;"
      }
    },
