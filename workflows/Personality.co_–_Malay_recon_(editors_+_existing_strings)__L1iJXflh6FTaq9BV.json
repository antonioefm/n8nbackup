    {
      "id": "a3568a64-b04b-49c6-b11d-84d07a4629c4",
      "name": "Summarise ms editors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nlet seen = 0;\nconst filled = [];\nconst byEditor = {};\nfor (const it of items) {\n  const t = it.json.translations;\n  if (!Array.isArray(t)) { throw new Error(\"No translations array on a page: \" + JSON.stringify(it.json).slice(0, 300)); }\n  for (const x of t) {\n    seen = seen + 1;\n    const val = x.translation === null || x.translation === undefined ? \"\" : String(x.translation);\n    if (val.trim() === \"\") { continue; }\n    const e = x.modified_by_email || \"unknown\";\n    byEditor[e] = (byEditor[e] || 0) + 1;\n    filled.push({ key_id: x.key_id, translation_id: x.translation_id, editor: e, is_reviewed: x.is_reviewed, is_fuzzy: x.is_fuzzy, statuses: x.custom_translation_statuses, text: val });\n  }\n}\nconst contributors = $(\"Fetch contributors\").first().json.contributors || [];\nconst accounts = [];\nfor (const c of contributors) { accounts.push({ user_id: c.user_id, email: c.email, fullname: c.fullname, is_admin: c.is_admin }); }\nreturn [{ json: { segments_seen: seen, non_empty: filled.length, by_editor: byEditor, filled: filled, contributors: accounts } }];"
      }
    }
  ],
