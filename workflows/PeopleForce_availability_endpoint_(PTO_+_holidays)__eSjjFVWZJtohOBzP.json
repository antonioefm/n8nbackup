      "id": "9d18d098-6d35-404d-9215-a8754c546e1a",
      "name": "PF: List approved leave",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "cItb79MRupYkKrjv",
          "name": "Peopleforce company api key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const params = $('Read request params').first().json;\nconst from = params.from_date;\nconst to = params.to_date;\n\nconst rawEmails = String(params.emails_filter || '').toLowerCase();\nconst emailFilter = rawEmails ? rawEmails.split(',').map(s => s.trim()).filter(Boolean) : [];\n\nconst employees = $('Flatten employees').all().map(i => i.json);\nconst holidayItems = $('PF: Employee holidays').all();\n\nconst byId = {};\nconst people = [];\n\nemployees.forEach((emp, idx) => {\n  const email = String(emp.email || '').toLowerCase();\n  if (emailFilter.length && emailFilter.indexOf(email) === -1) return;\n\n  const hItem = holidayItems[idx];\n  const hRows = hItem && hItem.json && Array.isArray(hItem.json.data) ? hItem.json.data : [];\n  const publicHolidays = [];\n  hRows.forEach(h => {\n    const d = String(h.date || h.starts_on || h.day || '').slice(0, 10);\n    if (d && d >= from && d <= to) publicHolidays.push({ date: d, name: h.name || h.title || null });\n  });\n\n  const person = { name: emp.name, email: emp.email, time_off: [], public_holidays: publicHolidays };\n  byId[emp.id] = person;\n  people.push(person);\n});\n\n$('PF: List approved leave').all().forEach(item => {\n  const rows = item.json && Array.isArray(item.json.data) ? item.json.data : [];\n  rows.forEach(lr => {\n    const empId = lr.employee && lr.employee.id ? lr.employee.id : lr.employee_id;\n    const person = byId[empId];\n    if (!person) return;\n    const start = String(lr.starts_on || lr.start_date || '').slice(0, 10);\n    const end = String(lr.ends_on || lr.end_date || start).slice(0, 10);\n    if (!start || end < from || start > to) return;\n    person.time_off.push({ start: start, end: end, status: 'away' });\n  });\n});\n\npeople.forEach(p => {\n  p.time_off.sort((a, b) => (a.start < b.start ? -1 : 1));\n  p.public_holidays.sort((a, b) => (a.date < b.date ? -1 : 1));\n});\n\nreturn [{ json: { range: { from: from, to: to }, generated_at: $now.toISO(), people: people } }];"
      },
