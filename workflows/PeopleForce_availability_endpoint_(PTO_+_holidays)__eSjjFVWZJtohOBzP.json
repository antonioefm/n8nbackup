    {
      "parameters": {
        "jsCode": "const rows = [];\nfor (const item of $input.all()) {\n  const page = Array.isArray(item.json.data) ? item.json.data : [];\n  for (const emp of page) {\n    const name = emp.full_name || [emp.first_name, emp.last_name].filter(Boolean).join(' ');\n    rows.push({ json: { id: emp.id, name: name, email: emp.email || null } });\n  }\n}\nreturn rows;"
      },
