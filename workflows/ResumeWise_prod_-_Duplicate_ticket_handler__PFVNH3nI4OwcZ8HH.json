        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "zendeskApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.merge_body) }}",
        "options": {}
      },
      "notes": "Both merge comments are PRIVATE. Returns a job_status object - the merge runs as a background job.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "zendeskApi": {
          "id": "v3ktZIJxpaFIH2Uy",
          "name": "Resumewise Zendesk account"
        }
      }
    },
