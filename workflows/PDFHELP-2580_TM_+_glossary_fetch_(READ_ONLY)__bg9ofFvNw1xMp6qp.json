    {
      "id": "07509bd1-3b82-49f9-a799-ba87cedf33ad",
      "name": "Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const RE = /^(metadata::[a-z0-9-]*form[a-z0-9-]*::|Forms::|Navigation::forms|components::quickLinks::forms|dashboard::forms)/;\nconst out = []; let total = 0;\nfor (const it of $input.all()) {\n  const ks = (it.json.body && it.json.body.keys) || [];\n  total += ks.length;\n  for (const k of ks) {\n    if (k.is_archived) continue;\n    const n = (k.key_name && k.key_name.web) || k.key_name;\n    if (!RE.test(n)) continue;\n    const t = {}; const m = {}; let en = null;\n    for (const tr of (k.translations || [])) { if (tr.language_iso === 'en') { en = tr.translation; continue; } t[tr.language_iso] = tr.translation; m[tr.language_iso] = (tr.modified_by_email || '') + (tr.is_reviewed ? '|R' : ''); }\n    out.push({ id: k.key_id, k: n, en: en, d: k.description, tg: k.tags, t: t, m: m });\n  }\n}\nreturn [{ json: { total: total, keys: out } }];"
      }
    },
    {
