        224,
        480
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/orgs/QR-CODE-App/repos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
