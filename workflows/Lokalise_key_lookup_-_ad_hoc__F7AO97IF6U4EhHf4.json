        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (let p = 1; p <= 4; p++) { out.push({ json: { project_id: '691331356a3b9a68428ab3.43540470', page: p } }); }\nreturn out;\n"
