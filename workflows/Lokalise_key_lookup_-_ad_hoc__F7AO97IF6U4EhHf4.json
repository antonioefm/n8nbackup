    {
      "id": "c986e04c-b832-4520-8597-933b4124a2e1",
      "name": "Filter Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const RE = /claudeGemini|chatgpt/i;\nconst hits = [];\nconst statuses = [];\nlet total = null;\nlet scanned = 0;\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  statuses.push(r.statusCode);\n  const h = r.headers || {};\n  if (h['x-pagination-total-count']) { total = h['x-pagination-total-count']; }\n  const keys = (r.body && r.body.keys) ? r.body.keys : [];\n  scanned += keys.length;\n  for (const k of keys) {\n    const nm = (k.key_name && typeof k.key_name === 'object') ? (k.key_name.web || k.key_name.other || JSON.stringify(k.key_name)) : String(k.key_name);\n    if (!RE.test(nm)) { continue; }\n    const tr = {};\n    for (const t of (k.translations || [])) {\n      tr[t.language_iso] = { text: t.translation, reviewed: t.is_reviewed, unverified: t.is_unverified, modified_at: t.modified_at, by: t.modified_by_email };\n    }\n    hits.push({ key_id: k.key_id, name: nm, archived: k.is_archived, tags: k.tags, created_at: k.created_at, filenames: k.filenames, tr: tr });\n  }\n}\nreturn [{ json: { statuses: statuses, total: total, scanned: scanned, hits: hits } }];\n"
      }
    }
  ],
