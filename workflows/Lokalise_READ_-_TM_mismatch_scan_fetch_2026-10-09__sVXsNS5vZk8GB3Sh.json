        "jsCode": "// READ ONLY. 2026-10-29: Slovak (799) + EN (640) for strings mentioning location/locate/address.\nconst pids = ['3070657967b5854be32cb1.65162854','50011170688b3050b0a7f8.40995136','9274956467e3e224807498.79791832','491848986923fad6dc2f85.42477363','1286096867dbf31146afc5.54950617','6744586768821f2c3fe845.13636914','964775386a3ce03ecca883.03770715','852017176a3ce11141ecd5.60405885','146903556751632e0388b9.21648688','35679002689c4f3ba6dd50.31739712','1600517668d38be7f36ba4.51132642','2944050668d5010cbd95e8.36175908','4780438967fe077b4e6484.83742970','1274536968b58980dc56a0.78363786','691331356a3b9a68428ab3.43540470','225008626a33e62b328c63.04676982','8241074569a69e614ce094.27318095','14240418673f52ae29a007.74392007','60625870676151e1da46d0.81913446','31393214664f295f94dd86.76792605'];\nreturn pids.map(pid => ({ json: { pid, url: 'https://api.lokalise.com/api2/projects/' + pid + '/keys?include_translations=1&disable_references=1&filter_archived=exclude&filter_translation_lang_ids=640,799&limit=500&pagination=cursor' } }));\n",
