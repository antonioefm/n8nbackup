      ],
      "parameters": {
        "jsCode": "// READ ONLY. 2026-11-20: 'save' strings, one or more projects per call (?pids=a,b).\nconst q = (($('Webhook (temp)').first() || {}).json || {}).query || {};\nconst pids = String(q.pids || '').split(',').filter(Boolean);\nif (!pids.length) throw new Error('no pids');\nreturn pids.map(pid => ({ json: { pid, url: 'https://api.lokalise.com/api2/projects/' + pid + '/keys?include_translations=1&disable_references=1&filter_archived=exclude&limit=500&pagination=cursor' } }));\n",
        "mode": "runOnceForAllItems"
      }
    },
