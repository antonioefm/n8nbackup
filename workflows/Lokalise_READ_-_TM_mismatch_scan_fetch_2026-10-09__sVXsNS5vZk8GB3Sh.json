      "parameters": {
        "jsCode": "// READ ONLY. Cross-project scan for audit notes 2026-10-28: EN 'Reset' -> nl, EN with 'blur' -> de. Archived excluded.\nconst pids = ['225008626a33e62b328c63.04676982','8241074569a69e614ce094.27318095','14240418673f52ae29a007.74392007','9274956467e3e224807498.79791832','901014606819db6d0bc999.26230201','46552447679363c70f7ef8.58193285','3070657967b5854be32cb1.65162854','50011170688b3050b0a7f8.40995136','60625870676151e1da46d0.81913446','18564477693fc9bba4cec8.54789459','1286096867dbf31146afc5.54950617','46919453689d5d729a1e70.59972091','6744586768821f2c3fe845.13636914','479073796a6095e8c10e35.09051894','9933660066825e9a8005c8.58526829','31393214664f295f94dd86.76792605','491848986923fad6dc2f85.42477363','852017176a3ce11141ecd5.60405885','964775386a3ce03ecca883.03770715','899698826a7340184c6a03.84153135','4780438967fe077b4e6484.83742970','1274536968b58980dc56a0.78363786','410385576a9fb240ac4f42.73305789'];\nreturn pids.map(pid => ({ json: { pid, url: 'https://api.lokalise.com/api2/projects/' + pid + '/keys?include_translations=1&disable_references=1&filter_archived=exclude&filter_translation_lang_ids=640,737,666&limit=500&pagination=cursor' } }));\n",
