    {
      "id": "50b44e2e-0eee-4f50-aac5-4b2830f53f8f",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "// READ ONLY. Keeps keys whose EN contains \"save\" (<=160 chars).\nconst out = []; const errors = []; const per = {};\nfor (const it of $input.all()) { const j = it.json; if (j.statusCode && j.statusCode >= 400) { errors.push(j.statusCode + ' ' + JSON.stringify(j.body || '').slice(0, 200)); continue; }\n  const b = j.body || {}; const pid = b.project_id || ''; per[pid] = (per[pid] || 0) + (b.keys || []).length;\n  for (const k of (b.keys || [])) { const tr = {}; let en = '';\n    for (const t of (k.translations || [])) { if (t.language_iso === 'en') en = t.translation; tr[t.language_iso] = [t.translation, t.modified_by_email || '']; }\n    if (typeof en !== 'string' || en.length > 160 || !/\\bsav(e|es|ed|ing)\\b/i.test(en)) continue;\n    out.push({ p: pid, k: (k.key_name && (k.key_name.web || k.key_name.other)) || '', d: (k.description || '').slice(0, 150), en, t: tr }); } }\nreturn [{ json: { per_project: per, errors, count: out.length, keys: out } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
