      "parameters": {
        "jsCode": "const out = []; const errors = []; let keys = 0;\nfor (const it of $input.all()) { const j = it.json; if (j.statusCode && j.statusCode >= 400) { errors.push(j.statusCode); continue; }\n  const b = j.body || {}; const pid = b.project_id || '';\n  for (const k of (b.keys || [])) { keys++; const name = (k.key_name && (k.key_name.web || k.key_name.other)) || '';\n    const tr = k.translations || []; const en = (tr.find(t => t.language_iso === 'en') || {}).translation || '';\n    if (typeof en !== 'string') continue;\n    const isReset = /^\\s*reset\\b/i.test(en) && en.length <= 40;\n    const isBlur = /\\bblur/i.test(en) && en.length <= 200;\n    if (!isReset && !isBlur) continue;\n    const lang = isReset ? 'nl' : 'de'; const t = tr.find(x => x.language_iso === lang) || {};\n    out.push({ pid, key: name, check: isReset ? 'reset-nl' : 'blur-de', en, tr: t.translation, by: t.modified_by_email, mod: t.modified_at, reviewed: t.is_reviewed }); } }\nreturn [{ json: { keys, errors, rows: out } }];\n",
        "mode": "runOnceForAllItems"
      }
    }
