      "parameters": {
        "jsCode": "const RE = /locat|address|\\bwhere\\b|position|gps|whereabouts/i;\nconst out = []; const errors = []; let keys = 0; const perProject = {}; const editors = {};\nfor (const it of $input.all()) { const j = it.json; if (j.statusCode && j.statusCode >= 400) { errors.push(j.statusCode + ' ' + JSON.stringify(j.body || '').slice(0, 200)); continue; }\n  const b = j.body || {}; const pid = b.project_id || '';\n  for (const k of (b.keys || [])) { keys++; perProject[pid] = (perProject[pid] || 0) + 1;\n    const tr = k.translations || []; const enT = (tr.find(t => t.language_iso === 'en') || {}).translation;\n    const sk = tr.find(t => t.language_iso === 'sk');\n    if (!sk || typeof sk.translation !== 'string' || !sk.translation) continue;\n    const by = sk.modified_by_email || ''; editors[by] = (editors[by] || 0) + 1;\n    if (typeof enT !== 'string' || !RE.test(enT) || enT.length > 400) continue;\n    const name = (k.key_name && (k.key_name.web || k.key_name.other)) || '';\n    out.push({ pid, key: name, en: enT, sk: sk.translation, by, rev: sk.is_reviewed ? 1 : 0 }); } }\nreturn [{ json: { keys_seen: keys, per_project: perProject, sk_editors: editors, errors, rows_kept: out.length, rows: out } }];\n",
