    {
      "id": "ffac6e64-cde6-4691-8d02-1e6542eb94b8",
      "name": "Filter Tree",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tree = $input.first().json.tree || [];\nconst branch = $('Get Repo').first().json.default_branch;\nconst CODE = /^apps\\/frontend-onepdf\\/src\\/.*(checkout|select-plan|pricing|price|plan|subscription|sales|payrails|adyen|billing|duration|period|interval|format).*\\.(ts|tsx)$/i;\nconst EN = /^apps\\/frontend-onepdf\\/.*(\\/en\\.json|\\/en\\/[^/]+\\.json)$/;\nconst SKIP = /(node_modules|__tests__|\\.test\\.|\\.spec\\.|\\.stories\\.|\\.d\\.ts$)/;\nconst files = tree.filter(t => t.type === 'blob' && !SKIP.test(t.path) && (CODE.test(t.path) || EN.test(t.path)) && (t.size || 0) < 600000).slice(0, 400);\nif (!files.length) return [{ json: { skip: true, path: '', branch } }];\nreturn files.map(f => ({ json: { path: f.path, branch } }));"
      }
    },
