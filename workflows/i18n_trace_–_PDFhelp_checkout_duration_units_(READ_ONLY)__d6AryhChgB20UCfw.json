    {
      "id": "974b2cc6-130e-4cf8-9084-e947ffd5b41c",
      "name": "Grep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src = $('Filter Tree').all();\nconst items = $input.all();\nconst out = { ns: [], keys: [] };\nconst walk = (o, pre) => { if (o && typeof o === 'object') { for (const [k, v] of Object.entries(o)) { const p = pre ? pre + '.' + k : k; if (v && typeof v === 'object') walk(v, p); else if (/(^|\\.)(units|plan_units|plan_names|durationUnits|duration_units)(\\.|$)/i.test(p) || /^(weeks?|months?|years?|days?)$/i.test(k)) out.keys.push({ file: '', key: p, value: String(v).slice(0, 160) }); } } };\nfor (let i = 0; i < items.length; i++) {\n  const path = (src[i] && src[i].json.path) || '';\n  const c = items[i].json.data; if (typeof c !== 'string') continue;\n  if (/\\.json$/.test(path)) { try { const before = out.keys.length; walk(JSON.parse(c), ''); for (let j = before; j < out.keys.length; j++) out.keys[j].file = path; } catch (e) {} continue; }\n  if (/CheckoutBenefits|CheckoutDisclaimer/.test(path)) {\n    const m = c.match(/use(?:Translations|Translation)\\([^)]*\\)|getTranslations\\([^)]*\\)/g) || [];\n    out.ns.push({ path, translations: m, tUnits: (c.match(/tUnits\\s*=\\s*[^;\\n]+/) || [''])[0] });\n  }\n}\nreturn [{ json: out }];"
      }
    }
