    {
      "id": "d11ac81d-6dc7-48a1-b7b0-0cc291128483",
      "name": "Diff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CAND = [\"Chatbot Online\",\"CHATBOT ONLINE LLC\",\"ChatGPT\",\"Claude\",\"DeepSeek\",\"Gemini\",\"Grok\",\"Norton\",\"OpenAI\",\"Premium\",\"PRO\",\"use.ai\",\"account\",\"background\",\"bank statement\",\"billing period\",\"chat\",\"checkout\",\"clipboard\",\"conversation\",\"credentials\",\"email\",\"feature\",\"file\",\"free trial\",\"image\",\"image style\",\"invoice\",\"link\",\"message\",\"model\",\"password\",\"payment\",\"payment details\",\"payment method\",\"plan\",\"project\",\"prompt\",\"receipt\",\"refund\",\"settings\",\"subscription\",\"support\",\"trial\",\"cancel\",\"close\",\"confirm\",\"contact\",\"continue\",\"copy\",\"create\",\"delete\",\"download\",\"enter\",\"get started\",\"log in\",\"reactivate\",\"remove\",\"rename\",\"save\",\"search\",\"send\",\"share\",\"sign in\",\"sign up\",\"start chatting\",\"try again\",\"update\",\"upload\"];\n\nconst norm = (s) => String(s || '').trim().toLowerCase().replace(/\\s+/g, ' ');\nconst counts = new Map();\nlet total = 0;\nconst tagCounts = {};\nfor (const it of items) {\n  const j = it.json || {};\n  const d = j.data !== undefined ? j.data : j;\n  const terms = Array.isArray(d) ? d : (d.terms || []);\n  for (const t of terms) {\n    total++;\n    const n = norm(t.term);\n    counts.set(n, (counts.get(n) || 0) + 1);\n    for (const g of (t.tags || [])) tagCounts[g] = (tagCounts[g] || 0) + 1;\n  }\n}\nconst dupInGlossary = [];\nfor (const [n, c] of counts) if (c > 1) dupInGlossary.push(n + ' x' + c);\nconst stillMissing = CAND.filter(c => !counts.has(norm(c)));\nreturn [{ json: {\n  total_items: total,\n  distinct_terms: counts.size,\n  duplicate_terms_in_glossary: dupInGlossary.sort(),\n  tagCounts: tagCounts,\n  candidates_still_missing: stillMissing\n} }];\n"
      }
    }
  ],
