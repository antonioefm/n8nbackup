{
  "id": "cErt3gMVC8V0QdWe",
  "name": "Google Ads – upload to OneDrive GOOGLE ADS (create-only)",
  "description": "Uploads one file to Maria's OneDrive under GOOGLE ADS/<folder>/<name>. Create-only (renames on clash). Needs x-upload-key header. Used by the google-ads-localize skill.",
  "active": true,
  "activeVersionId": "c9a93181-01c6-4ecf-b9ed-99a96d46b3ac",
  "createdAt": "2026-11-20T10:33:38.543Z",
  "updatedAt": "2026-11-20T10:33:38.543Z",
