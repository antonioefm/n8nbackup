  "nodes": [
    {
      "id": "54f64872-1e9d-41d2-8450-d28719523443",
      "name": "Receive file",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "google-ads-upload-7f3c9e21b4d84a6f",
        "responseMode": "lastNode",
        "options": {
          "rawBody": true,
          "binaryPropertyName": "data"
        }
      },
      "webhookId": "3d2db1f0-4a02-4be4-b7ab-c9f77cc0db4e"
    },
    {
      "id": "f7386558-a134-4f37-aefb-c4b6b8df512d",
      "name": "Check key and build path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const KEY = 'gads-2b91f0c4e7a64d53a8c1';\nconst h = $json.headers || {};\nconst q = $json.query || {};\nif (h['x-upload-key'] !== KEY) throw new Error('Forbidden: wrong upload key');\nconst folder = String(q.folder || '').trim();\nconst name = String(q.name || '').trim();\nif (!folder || !name) throw new Error('folder and name are required');\nconst bad = s => s.includes('..') || /[\\\\:*?\"<>|]/.test(s) || s.startsWith('/');\nif (bad(folder) || bad(name) || name.includes('/')) throw new Error('Invalid folder or file name');\nif (!/\\.(xlsx|csv|pdf|zip)$/i.test(name)) throw new Error('Only xlsx, csv, pdf, zip');\nconst segs = ['GOOGLE ADS', ...folder.split('/').filter(Boolean), name];\nconst path = segs.map(encodeURIComponent).join('/');\nreturn { json: { folder, name, url: 'https://graph.microsoft.com/v1.0/me/drive/root:/' + path + ':/content?@microsoft.graph.conflictBehavior=rename' }, binary: $input.item.binary };"
      }
    },
    {
      "id": "a85ec9f0-cbed-482b-b919-a1ad40d09a43",
      "name": "Upload to OneDrive GOOGLE ADS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOneDriveOAuth2Api",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data"
      },
      "credentials": {
        "microsoftOneDriveOAuth2Api": {
          "id": "QCA5rX8Iyd1rbChu",
          "name": "Microsoft Drive - Maria Sica account"
        }
      }
    },
    {
      "id": "e93b50a4-5b59-4014-9e37-26f569935ce2",
      "name": "Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "n",
