      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const adf = (n) => { if (!n) { return ''; } if (typeof n === 'string') { return n; } let s = n.text || ''; if (n.attrs && n.attrs.url) { s += ' ' + n.attrs.url; } if (n.marks) { for (const m of n.marks) { if (m.attrs && m.attrs.href) { s += ' <' + m.attrs.href + '>'; } } } if (Array.isArray(n.content)) { s += ' ' + n.content.map(adf).join(' '); } return s; };\nconst th = $('Slack thread').first().json || {};\nconst msgs = (th.messages || []).map(m => ({ ts: m.ts, user: m.user || m.bot_id, text: String(m.text || '').slice(0, 600) }));\nconst jira = $('Jira').all().map(it => { const b = it.json.body || {}; const f = b.fields || {}; return { key: b.key, status: it.json.statusCode, summary: f.summary, state: f.status && f.status.name, parent: f.parent ? f.parent.key + ' ' + (f.parent.fields && f.parent.fields.summary) : '', links: (f.issuelinks || []).map(l => ({ type: l.type && l.type.name, key: (l.outwardIssue || l.inwardIssue || {}).key, status: ((l.outwardIssue || l.inwardIssue || {}).fields || {}).status ? (l.outwardIssue || l.inwardIssue).fields.status.name : '', summary: ((l.outwardIssue || l.inwardIssue || {}).fields || {}).summary })), description: adf(f.description).replace(/\\s+/g, ' ').slice(0, 3000) }; });\nconst c = $('Password key commit').first().json || {};\nreturn [{ json: { slack_ok: th.ok, slack_error: th.error || null, thread: msgs, jira: jira, pw_commit: { status: c.statusCode, items: ((c.body || {}).items || []).map(i => ({ sha: i.sha.slice(0,9), date: i.commit.committer.date, msg: i.commit.message.slice(0, 160) })) } } }];"
      }
    }
