    {
      "id": "25ca4239-8f31-45a4-9da3-126531547a2d",
      "name": "Build Key Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leaves = ['results_saved_badge','results_saved_expired','get_my_results'];\nconst prefixes = ['pages.get_results.uncover.','get_results.uncover.','uncover.','','pages::get_results::uncover::'];\nconst names = [];\nfor (const p of prefixes) { for (const l of leaves) { names.push(p + l); } }\nconst filter = encodeURIComponent(names.join(','));\nconst out = [];\nfor (const it of items) {\n  for (const p of (it.json.projects || [])) {\n    const n = (p.name || '').toLowerCase();\n    if (n.indexOf('perso') < 0) { continue; }\n    out.push({ json: { project_id: p.project_id, project_name: p.name, filter: filter } });\n  }\n}\nreturn out;\n"
      }
    },
    {
      "id": "82094bb0-6fb7-4a3b-9861-ba881c38a2ed",
      "name": "Fetch Keys",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/keys?filter_keys={{ $json.filter }}&include_translations=1&limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 250
            }
          },
          "response": {
            "response": {
