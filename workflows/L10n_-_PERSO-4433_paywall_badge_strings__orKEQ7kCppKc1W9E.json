              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "VW7WtJP8PzJMR813",
          "name": "Lokalise read-only"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f5cb12d7-2fc8-4994-94f2-596539279f6e",
      "name": "Collect Strings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const LANGS = ['en','es','pl','de','fr','it','nl','pt','ko','th'];\nconst reqs = $('Build Key Requests').all();\nconst res = $input.all();\nconst out = [];\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || {}).json || {};\n  const r = res[i].json || {};\n  const keys = (r.body && r.body.keys) ? r.body.keys : [];\n  const found = [];\n  for (const k of keys) {\n    const tr = {};\n    for (const t of (k.translations || [])) {\n      const iso = (t.language_iso || '').toLowerCase();\n      if (LANGS.indexOf(iso) >= 0) { tr[iso] = { text: t.translation, reviewed: t.is_reviewed, modified: t.modified_at }; }\n    }\n    found.push({ key: k.key_name, archived: k.is_archived, description: k.description, tags: k.tags, translations: tr });\n  }\n  out.push({ json: { project: meta.project_name, project_id: meta.project_id, status: r.statusCode, keys: found } });\n}\nreturn out;\n"
      }
    }
  ],
