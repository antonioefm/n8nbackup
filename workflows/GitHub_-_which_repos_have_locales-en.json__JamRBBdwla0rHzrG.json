      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(function (i) { return { json: { repo: i.json.full_name, defaultBranch: i.json.default_branch } }; });"
      }
    },
    {
      "id": "7a089f2c-d729-40c3-b3ae-991f50019134",
      "name": "Summarise Coverage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(function (i) { return i.json; });\nconst withFile = rows.filter(function (r) { return r.found; });\nconst withoutFile = rows.filter(function (r) { return !r.found; });\nreturn [{ json: {\n  checked: rows.length,\n  withEnJson: withFile.length,\n  repos: withFile.map(function (r) { return r.repo + ' (' + r.keys + ' keys)'; }),\n  missing: withoutFile.map(function (r) { return r.repo; }),\n} }];"
      }
    },
    {
      "id": "cf52666a-8cff-4469-b947-01a1637408d4",
      "name": "Try locales/en.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/contents/locales/en.json?ref={{ $json.defaultBranch }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            }
