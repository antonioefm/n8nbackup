              "responseFormat": "text",
              "outputPropertyName": "fileText"
            }
          }
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "githubApi": {
          "id": "mUh6urSdgDMQojf1",
          "name": "GitHub account 2"
        }
      }
    },
    {
      "id": "fd576a20-e3c7-42f9-8094-725ed01167e9",
      "name": "Shape Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TICK = String.fromCharCode(96);\nfunction flatten(value, prefix, out) {\n  const isPlainObject = value !== null && typeof value === 'object' && !Array.isArray(value);\n  if (isPlainObject) {\n    const names = Object.keys(value);\n    if (names.length === 0 && prefix) out.push(prefix);\n    for (const name of names) { flatten(value[name], prefix ? prefix + '::' + name : name, out); }\n  } else if (prefix) { out.push(prefix); }\n  return out;\n}\nconst repo = $('Loop Repos').item.json.repo;\nconst body = $json;\nlet keys = 0;\nlet found = false;\nif (body && typeof body.fileText === 'string' && body.fileText.trim() !== '') {\n  try { keys = flatten(JSON.parse(body.fileText), null, []).length; found = true; } catch (e) { found = false; }\n}\nreturn [{ json: { repo: repo, found: found, keys: keys } }];"
      }
    },
