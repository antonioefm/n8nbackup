    {
      "id": "3f8776a8-9644-4a46-9fce-512d4ebc0450",
      "name": "Pick question keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = []; for (const it of $input.all()) { const ks = it.json.keys; if (!Array.isArray(ks)) throw new Error('no keys array: ' + JSON.stringify(it.json).slice(0,300)); all.push(...ks); }\nconst ids = []; const nm = k => typeof k.key_name === 'object' ? (k.key_name.web || k.key_name.other || k.key_name.ios || k.key_name.android) : k.key_name;\nfor (const k of all) { if (/_questions\\.\\d+/.test(nm(k))) ids.push(k.key_id); }\nconst out = []; for (let i = 0; i < ids.length; i += 100) out.push({ json: { n: ids.length, total: all.length, url: 'https://api.lokalise.com/api2/projects/9933660066825e9a8005c8.58526829/keys?limit=100&include_translations=1&disable_references=1&filter_key_ids=' + ids.slice(i, i+100).join(',') } });\nreturn out;"
      }
    },
