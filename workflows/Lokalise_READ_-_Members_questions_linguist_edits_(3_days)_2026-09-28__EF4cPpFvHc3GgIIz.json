        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const EXC = ['maria@efuturemedia.com','maria+devs@efuturemedia.com','kseniya.krasovskaya@efuturemedia.com','raul@efuturemedia.com','support@lokalise.com','mjlocalize@gmail.com'];\nconst cs = ($input.first().json.contributors) || [];\nconst out = [];\nfor (const c of cs) { const em = (c.email||'').toLowerCase();\n  if (c.is_admin || EXC.includes(em) || em.endsWith('@efuturemedia.com')) continue;\n  const w = (c.languages||[]).filter(l => l.is_writable).map(l => l.lang_iso);\n  if (w.length < 1 || w.length > 3) continue;\n  out.push({ json: { uid: c.user_id, email: em, w: w.join(','), url: 'https://api.lokalise.com/v1/audit-logs?limit=1000&user_id=' + c.user_id + '&event_type=translation.updated&date_from=2026-09-25&date_to=2026-09-29' } }); }\nreturn out;"
      }
    },
