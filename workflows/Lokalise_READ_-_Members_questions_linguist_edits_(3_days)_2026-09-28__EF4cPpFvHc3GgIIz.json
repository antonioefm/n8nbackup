    {
      "id": "86b51b4d-17bc-4195-9051-7de314927acb",
      "name": "Collect audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Plan audit').all(); const res = $input.all();\nconst ev = [], errs = [], capped = [], seen = new Set(), pnames = {};\nres.forEach((it, i) => { const b = it.json, r = reqs[i] ? reqs[i].json : {};\n  const arr = Array.isArray(b.data) ? b.data : null; if (!arr) { errs.push({ email: r.email, b: JSON.stringify(b).slice(0,300) }); return; }\n  if (b.has_more) capped.push(r.email);\n  for (const e of arr) { const uid = (e.metadata||{}).uid; if (uid && seen.has(uid)) continue; if (uid) seen.add(uid);\n    const en = (e.enrichments||[]).find(x => x.name === 'project'); const pn = en && en.data ? en.data.name : '';\n    const d = (e.unmapped||{}).data || {};\n    pnames[pn] = (pnames[pn]||0) + 1;\n    if (!/Members/i.test(pn)) continue;\n    ev.push({ who: r.email, iso: d.lang_iso, key: d.key, kid: d.key_id, old: d.old_translation, nw: d.new_translation, t: e.created_at || (e.metadata||{}).created_at || e.timestamp }); } });\nreturn [{ json: { ling: reqs.map(r => [r.json.email, r.json.w, r.json.uid]), errs, capped, pnames, ev, sample: res[0] ? JSON.stringify(res[0].json).slice(0,1500) : '' } }];"
      }
    },
