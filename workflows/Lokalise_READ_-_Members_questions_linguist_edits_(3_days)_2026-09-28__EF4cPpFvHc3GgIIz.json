    {
      "id": "441ee0b8-9916-47e2-8f4e-032b034207ad",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const L = ['en','lt','fr','sv','et','ms','lv','th','it','es','da','nl','no','pt','ro','de','id','pl','ko'];\nconst rows = []; let bad = 0;\nfor (const it of $input.all()) { const ks = it.json.keys; if (!Array.isArray(ks)) { bad++; continue; }\n  for (const k of ks) { const nm = typeof k.key_name === 'object' ? (k.key_name.web || k.key_name.other || k.key_name.ios || k.key_name.android) : k.key_name;\n    const t = {}; for (const tr of (k.translations||[])) { if (!L.includes(tr.language_iso)) continue;\n      t[tr.language_iso] = [typeof tr.translation === 'object' ? JSON.stringify(tr.translation) : tr.translation, tr.modified_by_email, tr.modified_at_timestamp, tr.is_reviewed ? 1 : 0, tr.is_unverified ? 1 : 0, tr.translation_id]; }\n    rows.push({ id: k.key_id, k: nm, tags: k.tags, d: (k.description||'').slice(0,200), t }); } }\nreturn [{ json: { bad, n: rows.length, rows } }];"
      }
    }
