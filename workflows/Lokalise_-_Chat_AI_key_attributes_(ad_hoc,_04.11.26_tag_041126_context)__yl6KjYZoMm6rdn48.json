      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 04 Nov 2026: chat::imageAspectRatioMobile (972554123) FR Mobile -> Portrait (9:16 shape, not the device). Guard: write only if live FR is still 'Mobile'.\nconst KEY = 972554123;\nconst NEW = { fr: { old: 'Mobile', val: 'Portrait' } };\nconst res = $input.first().json;\nconst keys = (res.body && res.body.keys) ? res.body.keys : [];\nconst k = keys.find(function (x) { return x.key_id === KEY; });\nif (!k) throw new Error('key not found');\nconst tr = []; const skipped = [];\nfor (const t of (k.translations || [])) {\n  const n = NEW[t.language_iso];\n  if (!n) continue;\n  if ((t.translation || '') !== n.old) { skipped.push({ iso: t.language_iso, live: t.translation }); continue; }\n  tr.push({ language_iso: t.language_iso, translation: n.val });\n}\nif (tr.length !== 1) throw new Error('expected 1 write, got ' + tr.length + ': ' + JSON.stringify(skipped));\nreturn [{ json: { payload: { keys: [{ key_id: KEY, translations: tr }] }, count: tr.length, expected: NEW, key: KEY } }];\n"
      }
    },
