        "jsCode": "const b = $('Build Payload').first().json;\nconst u = $('Update Keys').first().json;\nconst body = u.body || {};\nconst back = $input.first().json.keys || [];\nconst k = back.find(function (x) { return x.key_id === b.key; }) || {};\nconst check = [];\nfor (const t of (k.translations || [])) {\n  const e = b.expected[t.language_iso];\n  if (!e) continue;\n  check.push({ iso: t.language_iso, ok: t.translation === e.val, translation: t.translation });\n}\nreturn [{ json: { sent: b.count, status: u.statusCode, errors: body.errors || body.error || null, readback_ok: check.filter(function (c) { return c.ok; }).length, check: check } }];\n"
