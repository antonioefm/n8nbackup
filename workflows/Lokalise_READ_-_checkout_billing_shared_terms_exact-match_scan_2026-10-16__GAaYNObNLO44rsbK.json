      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TERMS = ['promo code','total due today','regular price','instant access','get instant access',\"cardholder's name\",'credit or debit card','accepted payment methods','contact sales','individual','team'];\nfunction norm(s) { return String(s || '').replace(/[\\u2019\\u2018]/g, \"'\").trim().replace(/[\\s\\u00a0\\u202f]*[:.!]$/, '').trim().toLowerCase(); }\nconst byP = {}; const errors = []; let seen = 0;\nfor (const it of $input.all()) { const b = it.json.body || {};\n  if (!Array.isArray(b.keys)) { errors.push({ s: it.json.statusCode, b: JSON.stringify(b).slice(0, 200) }); continue; }\n  for (const k of b.keys) { seen++; if (k.is_archived) continue;\n    const en = (k.translations || []).find(t => t.language_iso === 'en'); if (!en || typeof en.translation !== 'string') continue;\n    if (TERMS.indexOf(norm(en.translation)) < 0) continue;\n    (byP[b.project_id] = byP[b.project_id] || []).push(k.key_id); } }\nconst A = 'https://api.lokalise.com/api2/projects/';\nconst out = [{ json: { url: A + '46552447679363c70f7ef8.58193285/languages?limit=500' } }];\nfor (const p in byP) { const ids = byP[p]; for (let i = 0; i < ids.length; i += 100) out.push({ json: { url: A + p + '/keys?include_translations=1&disable_references=1&limit=500&filter_key_ids=' + ids.slice(i, i + 100).join(',') } }); }\nout[0].json.meta = { seen: seen, errors: errors, projects: Object.keys(byP).length, keys: Object.values(byP).reduce((a, x) => a + x.length, 0) };\nreturn out;\n"
      }
    },
