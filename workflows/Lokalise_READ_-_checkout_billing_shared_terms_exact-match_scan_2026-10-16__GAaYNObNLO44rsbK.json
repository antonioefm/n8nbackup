    {
      "id": "9d05e86b-0e44-43ef-9952-325db33db227",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $('Match').first().json.meta;\nconst langs = []; const rows = []; const errors = [];\nfor (const it of $input.all()) { const b = it.json.body || {};\n  if (Array.isArray(b.languages)) { for (const l of b.languages) langs.push({ id: l.lang_id, iso: l.lang_iso, name: l.lang_name }); continue; }\n  if (!Array.isArray(b.keys)) { errors.push({ s: it.json.statusCode, b: JSON.stringify(b).slice(0, 200) }); continue; }\n  for (const k of b.keys) { if (k.is_archived) continue;\n    const kn = typeof k.key_name === 'object' ? (k.key_name.web || k.key_name.other || Object.values(k.key_name)[0]) : k.key_name;\n    const t = {}; let en = '';\n    for (const x of (k.translations || [])) { if (typeof x.translation !== 'string' || !x.translation) continue; if (x.language_iso === 'en') { en = x.translation; continue; } t[x.language_iso] = [x.translation, x.modified_by_email || '', x.is_reviewed ? 1 : 0, x.is_unverified ? 1 : 0]; }\n    rows.push({ p: b.project_id, k: kn, en: en, t: t }); } }\nreturn [{ json: { meta: meta, errors: errors, langs: langs, rows: rows } }];\n"
      }
    }
