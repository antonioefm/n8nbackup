      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sent = $('Guard').all().map(i => i.json);\nif (sent[0] && sent[0].skip) { return [{ json: { written: [], skipped: sent[0].skipped } }]; }\nconst res = $input.all().map(i => i.json); const ok = [], bad = [];\nres.forEach((r, i) => { const s = sent[i]; const k = r.key || {}; if ((k.description || '') === s.newv) ok.push(s.k); else bad.push({ k: s.k, got: JSON.stringify(r).slice(0, 300) }); });\nif (bad.length) throw new Error('VERIFY failed: ' + JSON.stringify(bad).slice(0, 1500));\nreturn [{ json: { written: ok, count: ok.length, skipped: sent[0].skipped || [] } }];"
      }
