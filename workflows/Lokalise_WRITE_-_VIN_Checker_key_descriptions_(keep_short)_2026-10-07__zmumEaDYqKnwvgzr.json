      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Description-only guard: key must exist, not archived, description unchanged since the fetch.\nconst plan = $('Payload').all().map(i => i.json);\nconst got = $input.all().map(i => i.json);\nconst out = []; const skipped = [];\nfor (let i = 0; i < plan.length; i++) {\n  const p = plan[i]; const k = (got[i] && got[i].key) || null;\n  if (!k || String(k.key_id) !== p.kid) { skipped.push({ k: p.k, reason: 'not found' }); continue; }\n  if (k.is_archived) { skipped.push({ k: p.k, reason: 'archived' }); continue; }\n  const d = k.description || '';\n  if (d === p.newv) { skipped.push({ k: p.k, reason: 'already applied' }); continue; }\n  if (d !== p.expected) { skipped.push({ k: p.k, reason: 'description changed', now: d.slice(0, 200) }); continue; }\n  out.push({ json: { k: p.k, newv: p.newv, url: p.url.split('?')[0], body: { description: p.newv } } });\n}\nlet sel = out; if (plan[0].mode === 'test') sel = out.slice(0, 1);\nif (!sel.length) return [{ json: { skip: true, skipped } }];\nsel[0].json.skipped = skipped; sel[0].json.eligible = out.length; return sel;"
      }
    },
