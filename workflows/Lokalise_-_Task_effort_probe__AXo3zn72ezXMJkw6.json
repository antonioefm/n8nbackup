    {
      "id": "f4089fad-7d20-4b1b-9fd7-b2809949e5c5",
      "name": "Build Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json; const raw = $input.first().json || {}; const body = raw.body || raw; const task = body.task || {}; const langs = task.languages || []; const created = task.created_at_timestamp || 0; const closed = task.completed_at_timestamp || Math.floor(Date.now() / 1000); const ymd = function (ts) { return new Date(ts * 1000).toISOString().slice(0, 10); }; const dateFrom = ymd(created); const dateTo = ymd(closed); const EVENTS = ['translation.updated', 'translation.proofread', 'translations.updated', 'task.item.closed', 'user.authentication.succeeded']; const out = []; const seen = {}; for (const L of langs) { const ids = []; for (const k of (L.keys || [])) { if (typeof k === 'number') { ids.push(k); } else if (k && k.key_id) { ids.push(k.key_id); } } for (let i = 0; i < ids.length; i += 100) { out.push({ json: { kind: 'keys', lang_id: L.language_id, lang_iso: L.language_iso, lang_key_total: ids.length, url: 'https://api.lokalise.com/api2/projects/' + cfg.project_id + '/keys?filter_key_ids=' + ids.slice(i, i + 100).join(',') + '&include_translations=1&filter_translation_lang_ids=' + L.language_id + '&limit=500&page=1' } }); } for (const u of (L.users || [])) { if (seen[u.user_id]) { continue; } seen[u.user_id] = true; for (const ev of EVENTS) { out.push({ json: { kind: 'audit', event_type: ev, user_id: u.user_id, user_email: u.email, url: 'https://api.lokalise.com/v1/audit-logs?limit=1000&date_from=' + dateFrom + '&date_to=' + dateTo + '&user_id=' + u.user_id + '&event_type=' + ev } }); } } } return out;"
      }
    },
