              "mode": "everyMinute"
            }
          ]
        },
        "output": "raw",
        "filters": {
          "readStatus": "both",
          "sender": "noreply@similarweb.com"
        },
        "options": {}
      },
      "id": "f0d54944-5700-4d93-a07a-ba1c0b532777",
