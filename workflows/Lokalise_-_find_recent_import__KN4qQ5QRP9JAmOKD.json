      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.lokalise.com/api2/projects/{{ $json.project_id }}/processes?limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
