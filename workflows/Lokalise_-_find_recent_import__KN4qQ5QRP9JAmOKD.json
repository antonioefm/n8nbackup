      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const it of items) {\n  for (const p of (it.json.projects || [])) {\n    out.push({ json: { project_id: p.project_id, project_name: p.name } });\n  }\n}\nreturn out;\n"
      }
    },
    {
      "id": "69b9cac8-eea8-4e6c-81d2-97c9a3f3c7ea",
      "name": "List Processes",
      "type": "n8n-nodes-base.httpRequest",
