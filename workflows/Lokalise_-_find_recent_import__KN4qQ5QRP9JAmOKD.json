    },
    {
      "id": "288f2807-00cd-4e2c-ab34-b36cd7d52cf4",
      "name": "Pick Recent Imports",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Split Projects').all();\nconst res = $input.all();\nconst out = [];\nconst cutoff = Date.now() - 4 * 24 * 3600 * 1000;\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || {}).json || {};\n  const body = (res[i].json || {}).body || {};\n  for (const p of (body.processes || [])) {\n    const t = (p.created_at_timestamp ? p.created_at_timestamp * 1000 : Date.parse(p.created_at || ''));\n    if (p.type !== 'file-import') { continue; }\n    if (t && t < cutoff) { continue; }\n    out.push({ json: { project_id: meta.project_id, project_name: meta.project_name, process_id: p.process_id, created_at: p.created_at, created_by_email: p.created_by_email, status: p.status } });\n  }\n}\nif (out.length === 0) { return [{ json: { none: true } }]; }\nreturn out;\n"
      }
    },
    {
