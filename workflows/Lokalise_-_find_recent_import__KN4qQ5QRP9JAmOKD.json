        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "41a29c93-7e37-4ad5-9980-0b00cf1c2828",
      "name": "Summarize Imports",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Pick Recent Imports').all();\nconst res = $input.all();\nconst rows = [];\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || {}).json || {};\n  const pr = (((res[i].json || {}).body || {}).process) || {};\n  const files = ((pr.details || {}).files) || [];\n  for (const f of files) {\n    rows.push({ project: meta.project_name, project_id: meta.project_id, process_id: meta.process_id, created_at: meta.created_at, by: meta.created_by_email, file: f.name_original || f.name, inserted: f.key_count_inserted, updated: f.key_count_updated, skipped: f.key_count_skipped, status: f.status });\n  }\n}\nconst match = rows.filter(function (r) { return r.inserted === 3156; });\nreturn [{ json: { match: match, all_recent: rows } }];\n"
      }
    }
  ],
