      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const PIDS = ['691331356a3b9a68428ab3.43540470','225008626a33e62b328c63.04676982','3070657967b5854be32cb1.65162854','60625870676151e1da46d0.81913446','1286096867dbf31146afc5.54950617','6744586768821f2c3fe845.13636914','852017176a3ce11141ecd5.60405885','964775386a3ce03ecca883.03770715','146903556751632e0388b9.21648688','9754058268381744ebf048.90929380','2944050668d5010cbd95e8.36175908'];\nconst out = [];\nfor (const p of PIDS) { out.push({ json: { pid: p, url: 'https://api.lokalise.com/api2/projects/' + p + '/custom_translation_statuses?limit=100' } }); }\nreturn out;\n"
      }
    },
    {
      "id": "09ea5fdd-d850-4ed8-8269-5ef98a248807",
      "name": "Fetch",
      "type": "n8n-nodes-base.httpRequest",
