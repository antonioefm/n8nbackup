    },
    {
      "id": "413e3b59-38c8-488c-ad31-8b6f6c902e43",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const reqs = $('Config').all();\nconst res = $input.all();\nconst out = {};\nconst errors = [];\nfor (let i = 0; i < res.length; i++) {\n  const meta = (reqs[i] || { json: {} }).json;\n  const r = res[i].json || {};\n  const b = r.body || {};\n  if (r.statusCode !== 200) { errors.push(meta.pid + ' status ' + r.statusCode); continue; }\n  const m = {};\n  for (const s of (b.custom_translation_statuses || [])) { m[String(s.status_id)] = s.title; }\n  out[meta.pid] = m;\n}\nreturn [{ json: { statuses: out, errors: errors, n: Object.keys(out).length } }];\n"
      }
    }
  ],
