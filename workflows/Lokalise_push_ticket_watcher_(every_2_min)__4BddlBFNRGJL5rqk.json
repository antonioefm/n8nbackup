{
  "id": "4BddlBFNRGJL5rqk",
  "name": "Lokalise push :ticket: watcher (every 2 min)",
  "description": "Every 2 minutes, finds Lokalise push posts in 7 automation channels that got a :ticket: reaction and runs the push tracer on each one once.",
  "active": true,
  "activeVersionId": "0a6804f5-4f51-4b75-92ed-de93b0250219",
  "createdAt": "2026-10-20T10:27:32.008Z",
  "updatedAt": "2026-10-20T10:28:04.455Z",
  "isArchived": false,
  "versionId": "0a6804f5-4f51-4b75-92ed-de93b0250219",
  "versionCounter": 3,
  "sourceWorkflowId": null,
  "triggerCount": 1,
  "nodes": [
    {
      "id": "60816c6c-1ae0-4806-8b09-f484c8b62e2f",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "a9593074-3987-4ec0-a335-13dc5fbf962c",
      "name": "Channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Channels to watch for :ticket: reactions on Lokalise push posts\nconst CH = ['C0BCC7KL49M', 'C096NKTSG7K', 'C0BFQ8FH9BM', 'C0ATJEBG8NB', 'C0C1Z9VRNDP', 'C09CUE3ND7V', 'C09A5TC1UCA'];\nconst oldest = Math.floor(Date.now() / 1000) - 3 * 86400;\nreturn CH.map(c => ({ json: { channel: c, oldest: oldest } }));"
      }
    },
    {
      "id": "1d559b7a-73ee-4468-885e-e1985f721177",
      "name": "History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://slack.com/api/conversations.history?channel={{ $json.channel }}&oldest={{ $json.oldest }}&limit=200",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          }
        }
      },
      "credentials": {
        "slackApi": {
          "id": "CXa5wwj5tndNAnHG",
          "name": "i18n assignment bot"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "8e8ac4bd-9941-48ce-863e-1f19a0fc8da2",
      "name": "Pick ticketed posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const st = $getWorkflowStaticData('global');\nst.done = st.done || {};\nconst chans = $('Channels').all();\nconst res = $input.all();\nconst out = []; const errors = [];\nfor (let i = 0; i < res.length; i++) {\n  const ch = chans[i].json.channel;\n  const b = res[i].json || {};\n  if (!b.ok) { errors.push(ch + ': ' + (b.error || 'request failed')); continue; }\n  for (const m of (b.messages || [])) {\n    const text = String(m.text || '');\n    if (!/pushed to Lokalise/i.test(text)) { continue; }\n    if (/cleanup mode/i.test(text)) { continue; }\n    if (!(m.reactions || []).some(r => r.name === 'ticket')) { continue; }\n    const id = ch + ':' + m.ts;\n    if (st.done[id]) { continue; }\n    st.done[id] = Date.now();\n    const project = text.split('\\n')[0].split(':')[0].replace(/\\*/g, '').trim();\n    const tickets = [];\n    for (const t of (text.match(/browse\\/([A-Z][A-Z0-9]+-\\d+)/g) || [])) { const k = t.replace('browse/', ''); if (tickets.indexOf(k) < 0) { tickets.push(k); } }\n    out.push({ json: { channel: ch, ts: m.ts, project_name: project, tickets_in_post: tickets } });\n  }\n}\nconst cutoff = Date.now() - 10 * 86400000;\nfor (const k of Object.keys(st.done)) { if (st.done[k] < cutoff) { delete st.done[k]; } }\nst.last_errors = errors;\nst.last_run = new Date().toISOString();\nreturn out;"
      }
    },
    {
      "id": "609fbf1c-19ef-4587-8e55-4f0730a0af5a",
      "name": "Run tracer",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "each",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "j2ucaqu6ogPhgTcd"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput",
      "disabled": false
    }
  ],
  "connections": {
