      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = [];\nfor (const it of items) {\n  for (const p of (it.json.projects || [])) {\n    all.push({ id: p.project_id, name: p.name, base: p.base_language_iso, keys: (p.statistics || {}).keys_total });\n  }\n}\nall.sort(function (a, b) { return (a.name || '').toLowerCase().localeCompare((b.name || '').toLowerCase()); });\nreturn [{ json: { count: all.length, projects: all } }];\n"
      }
