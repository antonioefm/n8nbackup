      "parameters": {
        "jsCode": "// RETIRED 28 Oct 2026 after exec 920217 (4 glossary terms updated). Now READ-ONLY verification of those terms.\nconst TERMS = ['get in touch','contact us','upload','restore'];\nconst LANGS = {673:'fr',734:'it'};\nconst terms = []; for (const it of $input.all()) { const b = it.json.body || {}; for (const t of (b.data || [])) terms.push(t); }\nconst out = [];\nfor (const t of terms) { if (!TERMS.includes(String(t.term).trim().toLowerCase())) continue;\n  const tr = {}; for (const x of (t.translations || [])) if (LANGS[x.langId]) tr[LANGS[x.langId]] = { t: x.translation, d: x.description };\n  out.push({ term: t.term, tr }); }\nreturn [{ json: { none: true, total_terms: terms.length, report: out } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
