      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "lqa-text",
              "name": "text",
              "type": "string",
              "value": "={{ $('Detect status and release changes').item.json.text + '\\nLQA status: ' + ((($json.issues || []).filter(i => $('Detect status and release changes').item.json.llrKeys.includes(i.key))).map(i => ($('Detect status and release changes').item.json.llrKeys.length > 1 ? i.key + ': ' : '') + '*' + (i.fields.customfield_11581 ? i.fields.customfield_11581.value : 'not set') + '*').join(', ') || 'unknown') + '\\nLQA ticket: ' + ((($json.issues || []).filter(i => i.fields && i.fields.issuetype && i.fields.issuetype.name === 'Test Plan')).length ? $json.issues.filter(i => i.fields.issuetype.name === 'Test Plan').map(i => '<https://futuremedia.atlassian.net/browse/' + i.key + '|' + i.key + '> (' + i.fields.status.name + (i.fields.duedate ? ', due ' + i.fields.duedate : '') + ')').join(', ') : 'none yet') }}"
            },
            {
              "id": "reply-text",
              "name": "replyText",
              "type": "string",
              "value": "={{ $('Detect status and release changes').item.json.changesText + '\\nLQA status: ' + ((($json.issues || []).filter(i => $('Detect status and release changes').item.json.llrKeys.includes(i.key))).map(i => '*' + (i.fields.customfield_11581 ? i.fields.customfield_11581.value : 'not set') + '*').join(', ') || 'unknown') + ' · LQA ticket: ' + ((($json.issues || []).filter(i => i.fields && i.fields.issuetype && i.fields.issuetype.name === 'Test Plan')).length ? $json.issues.filter(i => i.fields.issuetype.name === 'Test Plan').map(i => '<https://futuremedia.atlassian.net/browse/' + i.key + '|' + i.key + '> (' + i.fields.status.name + ')').join(', ') : 'none yet') }}"
            },
            {
              "id": "key",
              "name": "key",
              "type": "string",
              "value": "={{ $('Detect status and release changes').item.json.key }}"
            },
            {
              "id": "thread-ts",
              "name": "threadTs",
              "type": "string",
              "value": "={{ $('Detect status and release changes').item.json.threadTs }}"
            }
          ]
        },
