    {
      "id": "d8829628-a277-43e4-aa4c-23e65db53e8a",
      "name": "Fetch localized product tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        260,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://futuremedia.atlassian.net/rest/api/3/search/jql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "jql",
              "value": "issueLinkType = \"Has localization ticket\" AND project != INTERNAT AND (updated >= -1d OR (fixVersion in releasedVersions() AND updated >= -14d)) ORDER BY updated DESC"
            },
            {
              "name": "fields",
              "value": "summary,status,fixVersions,issuelinks,project"
            },
            {
              "name": "maxResults",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "QJte7dJbX10mIzJI",
          "name": "Jira SW Cloud account"
        }
      }
    },
    {
      "id": "36c428ec-b6f4-461a-adb4-b710ef27f468",
      "name": "Detect status and release changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const state = $getWorkflowStaticData('global');\nif (!state.issues) state.issues = {};\nconst firstRun = !state.seeded;\nconst now = Date.now();\nconst esc = function (s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };\nconst base = 'https://futuremedia.atlassian.net/browse/';\nconst issues = ($input.first().json.issues) || [];\nconst out = [];\nfor (const it of issues) {\n  const f = it.fields || {};\n  const llrs = (f.issuelinks || []).filter(function (l) { return l.type && l.type.id === '10079' && l.outwardIssue; }).map(function (l) { return l.outwardIssue; });\n  if (!llrs.length) continue;\n  const status = f.status ? f.status.name : '';\n  const versions = (f.fixVersions || []).map(function (v) { return { name: v.name, releaseDate: v.releaseDate || '', released: !!v.released }; });\n  const sigOf = function (v) { return v.name + '|' + v.releaseDate + '|' + v.released; };\n  const verSig = versions.map(sigOf).sort().join(';');\n  const prev = state.issues[it.key];\n  state.issues[it.key] = { status: status, verSig: verSig, seen: now, threadTs: prev && prev.threadTs ? prev.threadTs : '' };\n  if (firstRun || !prev) continue;\n  const changes = [];\n  if (prev.status !== status) {\n    const prodNote = status === 'QA PROD' ? ' :rocket: _deployed to prod_' : '';\n    changes.push('Status: ' + esc(prev.status) + ' → *' + esc(status) + '*' + prodNote);\n  }\n  if (prev.verSig !== verSig) {\n    const prevSigs = prev.verSig ? prev.verSig.split(';') : [];\n    for (const v of versions) {\n      const p = prevSigs.find(function (s) { return s.indexOf(v.name + '|') === 0; });\n      if (!p) changes.push('Fix version added: *' + esc(v.name) + '*' + (v.releaseDate ? ' (planned release ' + v.releaseDate + ')' : ''));\n      else if (v.released && p.slice(-5) !== '|true') changes.push(':rocket: Version *' + esc(v.name) + '* *released*' + (v.releaseDate ? ' on *' + v.releaseDate + '*' : ''));\n      else if (p !== sigOf(v)) changes.push('Fix version *' + esc(v.name) + '* updated (release date ' + (v.releaseDate || 'not set') + ')');\n    }\n  }\n  if (!changes.length) continue;\n  const verLine = versions.length ? versions.map(function (v) { return esc(v.name) + ' (' + (v.releaseDate || 'no date') + (v.released ? ', released' : ', not released') + ')'; }).join(', ') : 'none';\n  const llrLine = llrs.map(function (l) { const st = l.fields && l.fields.status ? l.fields.status.name : ''; return '<' + base + l.key + '|' + l.key + '>' + (st ? ' (' + esc(st) + ')' : ''); }).join(', ');\n  const text = ':bell: *<' + base + it.key + '|' + it.key + '>* – ' + esc(f.summary) + '\\n' + changes.join('\\n') + '\\nFix version: ' + verLine + '\\nLocalization ticket: ' + llrLine;\n  out.push({ json: { key: it.key, status: status, llrKeys: llrs.map(function (l) { return l.key; }), threadTs: state.issues[it.key].threadTs, changesText: changes.join('\\n'), text: text } });\n}\nfor (const k of Object.keys(state.issues)) { if (now - (state.issues[k].seen || 0) > 90 * 86400000) delete state.issues[k]; }\nstate.seeded = true;\nreturn out;\n"
      }
    },
