      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One-off 2026-10-28: daily translation audit sheet 28.10, Chat AI - frontend.\n// Approved rows + rows resolved from Maria's notes. Format: key_id -> iso -> [audited live text, new text].\n// MODE: 'check' (no writes) | 'test' (first item only) | 'all'. Set back to 'check' after the run.\nconst MODE = 'all';\nconst P = {\n  \"966223339\": {\n    \"nl\": [\"Gladde huid, geen oneffenheden, geen krassen, en oude foto's komen weer tot leven.\", \"Gladde huid, oneffenheden verwijderen, krassen verwijderen, en oude foto's komen weer tot leven.\"],\n    \"de\": [\"Glatte Haut, keine Unreinheiten, keine Kratzer \\u2013 und alte Fotos erwachen wieder zum Leben.\", \"Glatte Haut, entferne Unreinheiten, entferne Kratzer \\u2013 und alte Fotos erwachen wieder zum Leben.\"]\n  },\n  \"882493047\": {\n    \"nl\": [\"Top-AI-modellen, afbeeldingen genereren en volop berichten, allemaal in \\u00e9\\u00e9n chat en \\u00e9\\u00e9n abonnement.\", \"Top AI-modellen, afbeeldingen genereren en volop berichten, allemaal in \\u00e9\\u00e9n chat en \\u00e9\\u00e9n abonnement.\"]\n  },\n  \"966223547\": { \"nl\": [\"Herstellen\", \"Resetten\"] },\n  \"966223507\": { \"de\": [\"Weichzeichnen\", \"Unscharf machen\"] }\n};\nreturn [{ json: { mode: MODE, ids: Object.keys(P).join(','), P: P } }];"
      }
