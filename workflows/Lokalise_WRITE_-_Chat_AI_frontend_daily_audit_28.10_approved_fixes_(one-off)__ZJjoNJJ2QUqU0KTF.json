      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst b = $input.first().json.body || {};\nif (!Array.isArray(b.keys)) return [{ json: { error: 'read-back failed', body: JSON.stringify(b).slice(0, 300) } }];\nconst out = [];\nfor (const k of b.keys) { const spec = cfg.P[String(k.key_id)]; if (!spec) continue;\n  const m = {}, by = {}; for (const t of (k.translations || [])) { m[t.language_iso] = t.translation; by[t.language_iso] = t.modified_by_email; }\n  for (const iso in spec) out.push({ key_id: k.key_id, iso: iso, state: m[iso] === spec[iso][1] ? 'NEW' : (m[iso] === spec[iso][0] ? 'OLD' : 'OTHER'), live: m[iso], by: by[iso] }); }\nconst w = $('Build writes').first().json;\nreturn [{ json: { mode: cfg.mode, to_write: w.to_write, skipped: w.skipped, readback: out } }];"
      }
    }
