      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NEW_CUT = '2026-10-20 11:20';\nconst LANGS = ['es','de','fr','it','pt','nl','pl','sv','da','no','ro','et','lv','lt','id','ms','ko','th'];\nconst empty = {}; LANGS.forEach(function (l) { empty[l] = 0; });\nlet newKeys = 0, statuses = [];\nconst samples = {};\nfor (const it of $input.all()) { statuses.push(it.json.statusCode); for (const k of ((it.json.body || {}).keys || [])) {\n  if (k.is_archived || String(k.created_at || '') < NEW_CUT) { continue; }\n  newKeys++;\n  for (const t of (k.translations || [])) { const v = typeof t.translation === 'string' ? t.translation : JSON.stringify(t.translation || ''); if (LANGS.indexOf(t.language_iso) >= 0 && !v.trim()) { empty[t.language_iso]++; if (!samples[t.language_iso]) { samples[t.language_iso] = k.key_id; } } }\n} }\nconst done = {}; LANGS.forEach(function (l) { done[l] = (999 - empty[l]) + '/999'; });\nreturn [{ json: { statuses: statuses, new_keys_still_untranslated_somewhere: newKeys, done: done, empty: empty, sample_empty_key: samples } }];"
      }
    }
  ],
