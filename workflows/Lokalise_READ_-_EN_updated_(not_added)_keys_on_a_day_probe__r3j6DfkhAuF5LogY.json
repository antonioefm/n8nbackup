    {
      "id": "a783b79b-158f-4982-ae13-260074df8dc4",
      "name": "Analyze EN updated on day",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Keys whose EN (base) translation was modified on DAY but the key was created earlier.\nconst proj = $('Fetch Project').first().json;\nconst DAY = '2026-10-19';\nconst res = $input.all();\nconst out = []; const failed = []; let scanned = 0; let createdToday = 0;\nfunction d(s) { return String(s || '').slice(0, 10); }\nfor (let i = 0; i < res.length; i++) {\n  const r = res[i].json || {};\n  if (r.statusCode !== 200) { failed.push(i + 1); continue; }\n  for (const k of ((r.body || {}).keys || [])) {\n    scanned++;\n    if (d(k.created_at) === DAY) { createdToday++; continue; }\n    const en = (k.translations || []).find(function (t) { return t.language_iso === 'en'; });\n    if (!en || d(en.modified_at) !== DAY) { continue; }\n    const n = k.key_name || {};\n    out.push({ key_id: k.key_id, key: typeof n === 'string' ? n : (n.web || n.other), created_at: k.created_at, en_modified_at: en.modified_at, en_modified_by: en.modified_by_email, archived: k.is_archived, tags: k.tags, en: String(typeof en.translation === 'string' ? en.translation : JSON.stringify(en.translation)).slice(0, 300) });\n  }\n}\nout.sort(function (a, b) { return String(b.en_modified_at).localeCompare(String(a.en_modified_at)); });\nreturn [{ json: { project: proj.name, keys_total_stat: proj.statistics && proj.statistics.keys_total, scanned: scanned, failed_pages: failed, created_today: createdToday, en_updated_today_count: out.length, en_updated_today: out.slice(0, 60) } }];\n"
      }
    }
  ],
